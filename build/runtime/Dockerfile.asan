ARG BUILD_IMAGE=ghcr.io/falkordb/falkordb-build:latest
# Keep in sync with REDIS_VERSION in build/Dockerfile and build/runtime/Dockerfile
# so all four images (toolchain, release, coverage, asan) build from the same
# upstream redis tag.
ARG REDIS_ASAN_VER=8.6.3

# Stage 1: ASAN-instrumented redis-server built from source.
# Redis's Makefile honors SANITIZER=address (sets MALLOC=libc, adds
# -fsanitize=address to CFLAGS/LDFLAGS). OPTIMIZATION=-O1 disables LTO,
# which clashes with ASAN ctor/dtor sections at link time.
FROM $BUILD_IMAGE AS redis-asan
ARG REDIS_ASAN_VER
WORKDIR /tmp
COPY tests/memcheck/redis.san-ignorelist /tmp/redis.san-ignorelist
RUN git clone --depth 1 --branch ${REDIS_ASAN_VER} https://github.com/redis/redis.git redis-src && \
    cd redis-src && \
    CFLAGS="-fsanitize-ignorelist=/tmp/redis.san-ignorelist" \
    make -j"$(nproc)" SANITIZER=address CC=clang-22 CXX=clang++-22 OPTIMIZATION="-O1" && \
    mkdir -p /out && cp src/redis-server /out/redis-server && \
    # Sanity check: a working ASAN binary has 100+ __asan_ symbols (init,
    # poison/unpoison, shadow memory bookkeeping). Mangled symbol names
    # like __asan_init_v8 vary by clang version, so just count occurrences.
    SYMS=$({ nm /out/redis-server 2>/dev/null; nm -D /out/redis-server 2>/dev/null; } | grep -c __asan_ || true) && \
    echo "ASAN symbols: $SYMS" && \
    test "$SYMS" -gt 10

# Stage 2 — builder: ASAN-instrumented libfalkordb.so.
# Nightly toolchain required for -Zsanitizer=address. Cargo profile is dev
# (no --release) so debuginfo and frame pointers are preserved for stack traces.
#
# NOTE: no cargo-chef here (unlike the release/coverage images). This stage
# builds RediSearch from source via redisearch.sh first — graph/build.rs needs
# those archives to exist before the cargo build — and then compiles the module
# directly. The dep-layer caching cargo-chef provides isn't worth the extra
# plumbing for the one-off ASAN image.
FROM $BUILD_IMAGE AS builder
RUN rustup install nightly && rustup default nightly
# OpenSSL dev: RediSearch 8.6's CMake find_package(OpenSSL) + link-time
# libssl/libcrypto. (Also added to build/Dockerfile, but the cached base image
# predates that, so install here too.)
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src

# Rebuild the RediSearch 8.6 fork WITH AddressSanitizer so the embedded
# VectorSimilarity is instrumented. The toolchain image ships a
# non-instrumented RediSearch; redisearch.sh with REDISEARCH_SAN=address
# produces the `debug-asan` flavor in-tree (./deps/RediSearch/bin),
# which graph/build.rs discovers ahead of the toolchain's /data copy.
# Copied on their own first so editing module source doesn't bust this expensive
# layer: both inputs change only when the RediSearch pin or build recipe does.
# deps/RediSearch/bin is .dockerignore'd, so the later `COPY . .` re-copies the
# (identical) source but cannot clobber the debug-asan output built here.
COPY redisearch.sh redisearch.sh
COPY deps/RediSearch deps/RediSearch
# RediSearch's redisearch_rs build scripts find their source root by walking up
# for a `.git` entry (build_utils::git_root; existence check only, never invokes
# git). All git metadata is .dockerignore'd, so create an empty marker -- see
# .dockerignore for why this is a marker rather than the real gitlink.
RUN mkdir -p deps/RediSearch/.git && \
    CC=clang-22 CXX=clang++-22 REDISEARCH_SAN=address bash redisearch.sh

COPY . .

# Build the module with ASAN for the host arch (native on arm64, amd64 in CI).
# Target-specific env vars use the canonical hyphenated `CFLAGS_<triple>` form
# (cc-rs's primary lookup key); POSIX /bin/sh can't assign hyphenated names, so
# pass them via `env`.
ARG TARGETARCH
RUN set -eux; \
    # Build the module with the SAME pinned nightly that redisearch.sh used for
    # redisearch_rs (RediSearch's .rust-nightly), not the floating `nightly`
    # alias defaulted above — so the -Zsanitizer toolchain matches across both
    # archives. The pin is read from the RediSearch checkout, which `COPY . .`
    # re-copies identically from the submodule. redisearch.sh already
    # installed this toolchain (with rust-src) during the SAN build.
    rustup default "$(cat deps/RediSearch/.rust-nightly)"; \
    case "$TARGETARCH" in \
      amd64) RT=x86_64-unknown-linux-gnu ;; \
      arm64) RT=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH"; exit 1 ;; \
    esac; \
    RTU=$(echo "$RT" | tr 'a-z-' 'A-Z_'); \
    env \
      "CARGO_TARGET_${RTU}_RUSTFLAGS=-Zsanitizer=address -Cdebuginfo=2 -Clink-arg=-Wl,--allow-multiple-definition" \
      "CFLAGS_${RT}=-fsanitize=address -fno-omit-frame-pointer" \
      "CXXFLAGS_${RT}=-fsanitize=address -fno-omit-frame-pointer" \
      CXX=clang++-22 \
      LLVM_OBJDUMP=/usr/bin/llvm-objdump-22 \
      LLVM_OBJCOPY=/usr/bin/llvm-objcopy-22 \
      cargo build --target "$RT"; \
    mkdir -p /out && cp "target/$RT/debug/libfalkordb.so" /out/falkordb.so

# Stage 3 — runtime. debian:trixie-slim because the asan redis-server
# (built in stage 1 against the toolchain image's glibc) needs GLIBC_2.38
# and GLIBCXX_3.4.32 — bookworm-slim's glibc 2.36 can't satisfy these and
# the binary fails to load with "version not found" errors. trixie-slim
# ships glibc 2.41 / GLIBCXX_3.4.33 which is compatible with everything
# the toolchain (redis:8.6.x base, also trixie-derived) produces.
#
# We replace redis-server with our ASAN-instrumented one so the stock
# binary that would come from the redis:8.6.x base is irrelevant. Going
# directly to debian:trixie-slim keeps the image lean.
FROM debian:trixie-slim AS server
ARG TARGETPLATFORM

ENV FALKORDB_HOME=/var/lib/falkordb \
    FALKORDB_DATA_PATH=/var/lib/falkordb/data \
    FALKORDB_BIN_PATH=/var/lib/falkordb/bin \
    FALKORDB_IMPORT_PATH=/var/lib/falkordb/import \
    FALKORDB_TLS_PATH=/var/lib/falkordb/tls

RUN mkdir -p ${FALKORDB_DATA_PATH} && ln -s ${FALKORDB_DATA_PATH} /data

# Runtime apt install. After PR #483 GraphBLAS JIT is disabled and libomp is
# statically linked into the instrumented .so (graph/build.rs + libomp.sh),
# so we no longer need libomp5 / libomp-22-dev / gcc (was just for JIT `cc`).
# We still need llvm-symbolizer-22 for readable ASAN backtraces, plus the
# gcc-compatible libasan runtime.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates bash openssl wget gnupg lsb-release libasan8 && \
    wget https://apt.llvm.org/llvm.sh && chmod +x llvm.sh && ./llvm.sh 22 && \
    apt-get update && \
    apt-get install -y --no-install-recommends llvm-22 && \
    apt-get purge -y wget gnupg lsb-release && \
    apt-get autoremove -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /llvm.sh

WORKDIR ${FALKORDB_HOME}

COPY ./build/runtime/run.sh        ${FALKORDB_BIN_PATH}/run.sh
COPY ./build/runtime/gen-certs.sh  ${FALKORDB_BIN_PATH}/gen-certs.sh
RUN chmod +x ${FALKORDB_BIN_PATH}/run.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
# LSan suppressions bundled so LSAN_OPTIONS=suppressions=... can find them.
COPY ./tests/memcheck/asan.supp    ${FALKORDB_HOME}/asan.supp

# ASAN-instrumented binaries
COPY --from=redis-asan /out/redis-server  /usr/local/bin/redis-server
COPY --from=builder    /out/falkordb.so   ${FALKORDB_BIN_PATH}/falkordb.so

# Sanitizer env defaults — overridable at runtime via `docker run -e …` or
# GitHub Actions services.<svc>.env.
ENV ARCH=${TARGETPLATFORM} \
    TLS=0 \
    BROWSER=0 \
    FALKORDB_ARGS="MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000" \
    ASAN_SYMBOLIZER_PATH=/usr/bin/llvm-symbolizer-22 \
    RS_GLOBAL_DTORS=1 \
    ASAN_OPTIONS="detect_leaks=1:detect_odr_violation=0:halt_on_error=0:abort_on_error=0:symbolize=1:print_stacktrace=1:strict_string_checks=1:detect_stack_use_after_return=1" \
    LSAN_OPTIONS="suppressions=/var/lib/falkordb/asan.supp:use_tls=0"

EXPOSE 6379/tcp
# run.sh is self-contained — no CMD because args wouldn't be forwarded.
ENTRYPOINT ["/var/lib/falkordb/bin/run.sh"]
