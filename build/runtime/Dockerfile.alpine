# Self-contained Alpine (musl) builder for the FalkorDB shared library. Unlike
# build/runtime/Dockerfile (which consumes the prebuilt Debian `falkordb-build`
# toolchain image), this image installs its own toolchain and builds GraphBLAS
# + LAGraph + libomp + RediSearch from source via the SAME scripts the Debian
# toolchain uses -- so the produced .so is linked against musl and the
# single-.so self-containment contract still holds.
#
# Two targets:
#   artifact  the .so alone:  docker build --target artifact --output type=local,dest=<dir>
#   server    an Alpine server image: Valkey or Redis (--build-arg SERVER)
#             built from source on this OS, plus that same .so. The
#             counterpart of the Debian image's `server` target; no browser.
# The musl-specific packages (bsd-compat-headers, the static clang archives,
# ncurses-dev, libffi-dev) and the -crt-static switch come from the C repo's
# build/docker/builder/Dockerfile.alpine; each one is explained where it is
# installed.

ARG ALPINE=alpine:3.24.4
# Consumed (unused) so the shared _build-artifacts.yml can pass --build-arg
# BUILD_IMAGE uniformly without a "not consumed" warning; self-contained OSes
# don't use a toolchain base image.
ARG BUILD_IMAGE
# Which server the `server` target ships, and the server releases: the same
# as build/runtime/Dockerfile (build/check-server-pins.sh enforces it).
ARG SERVER=valkey
ARG REDIS_VERSION=8.10.2
ARG VALKEY_VERSION=9.1.2

# ---------------------------------------------------------------------------
# Toolchain + dependency build.
# ---------------------------------------------------------------------------
FROM ${ALPINE} AS builder

ARG LLVM_MAJOR=22

# Beyond the compilers and the headers the deps compile against:
#   bsd-compat-headers        : <sys/cdefs.h>, which RediSearch includes
#   clang-static,             : RediSearch's Rust crates link libclang.a
#   ncurses-dev, libffi-dev     statically on musl (rlookup/Cargo.toml,
#                               rust-bindgen#2360), and clang-sys then adds
#                               -lffi -lncursesw. LLVM itself comes from
#                               libLLVM.so: Alpine's llvm-config reports
#                               shared mode.
#   clang-libclang            : libclang.so, which bindgen loads at run time
#                               for FalkorDB's own crates
#   python3                   : the pip-pinned cmake below
RUN apk add --no-cache \
      bash git curl ca-certificates make findutils binutils \
      gcc g++ musl-dev linux-headers bsd-compat-headers \
      openssl-dev zlib-dev zstd-dev ncurses-dev libffi-dev \
      clang${LLVM_MAJOR} clang${LLVM_MAJOR}-dev clang${LLVM_MAJOR}-libclang clang${LLVM_MAJOR}-static \
      llvm${LLVM_MAJOR} llvm${LLVM_MAJOR}-dev \
      python3

# llvm-config (which clang-sys runs) and the llvm-objcopy/objdump that
# graph/build.rs runs have no bare names on Alpine's PATH; they live under
# /usr/lib/llvm<N>/bin. Putting that first also pins `clang` to LLVM <N>.
ENV PATH="/usr/lib/llvm${LLVM_MAJOR}/bin:/venv/bin:/root/.cargo/bin:${PATH}"

# Pin cmake to the same version the other builders use. Alpine's python is
# externally managed (PEP 668), hence the venv.
RUN python3 -m venv /venv && pip install --no-cache-dir 'cmake==3.31.6'

# Rust toolchain (rustup) -- Alpine's packaged rust lags what redisearch_rs
# needs. The musl host triple is picked automatically.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

WORKDIR /data

# libomp.a (static) matched to the system clang version, installed to /opt/libomp
# so graph/build.rs links it statically (single-.so OpenMP contract).
COPY build/libomp.sh /tmp/libomp.sh
RUN LLVMORG_VERSION=$(clang --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1) && \
    test -n "${LLVMORG_VERSION}" && \
    CC=clang CXX=clang++ /tmp/libomp.sh "${LLVMORG_VERSION}" && \
    rm -f /tmp/libomp.sh

# GraphBLAS + LAGraph + RediSearch, built by the native-deps crate, which owns
# the recipes and a content-addressed cache keyed on the submodule revisions,
# the GB_control patch, the vendored PreJIT kernels, $CC/$CXX, the target
# triple and the OpenMP flavour -- so the key computed by `cargo build` below
# matches what is published here. CC/CXX/LIBOMP_PREFIX are ENV, not per-RUN,
# because they are cache-key inputs.
#
# RUST_DYN_CRT=1 is read by RediSearch's build.sh, which then adds
# `-C target-feature=-crt-static` to the RUSTFLAGS of its own Rust build
# (native-deps hands build.sh an environment with RUSTFLAGS removed). Rust's
# musl targets otherwise link the C runtime statically, and redisearch_rs's
# build scripts do not build that way. It is set here rather than in
# native-deps' RediSearch recipe because any recipe change moves the cache key
# of all three deps, rebuilding every existing cache once; without it the
# build fails outright rather than producing a different archive.
#
# The sources and RediSearch's in-tree build output are removed in the same
# RUN: only the native-deps cache (~/.cache/falkordb/native-deps) is needed
# below, and the build tree is several GB.
ARG CC=clang
ARG CXX=clang++
ENV CC=${CC} \
    CXX=${CXX} \
    LIBOMP_PREFIX=/opt/libomp \
    RUST_DYN_CRT=1
COPY native-deps           /data/native-deps
COPY deps/native-deps.lock /data/deps/native-deps.lock
COPY build/graphblas       /data/build/graphblas
COPY deps/GraphBLAS        /data/deps/GraphBLAS
COPY deps/LAGraph          /data/deps/LAGraph
COPY deps/RediSearch       /data/deps/RediSearch
RUN cd /data && \
    cargo run --locked --manifest-path native-deps/Cargo.toml && \
    cd / && rm -rf /data

# Build the cdylib from the repo source. graph/build.rs calls native_deps::ensure(),
# which recomputes the same keys and hits the entries published above.
# .cargo/config.toml turns off crt-static for musl; without that, cargo drops
# the cdylib crate type and there is no libfalkordb.so to copy.
#
# musl's ldd has no -r. It resolves every symbol anyway, reports a missing
# library ("Error loading shared library") or symbol ("Error relocating"), and
# exits 127 -- so the listing below is informational and the grep decides.
WORKDIR /src
COPY . .
RUN cargo build --release && \
    mkdir -p /out && cp target/release/libfalkordb.so /out/falkordb.so && \
    rm -rf target && \
    echo "=== verify single-.so contract on libfalkordb.so ===" && \
    { ldd /out/falkordb.so || true; } && \
    deps="$(ldd /out/falkordb.so 2>&1 | awk '{print $1}' | sort -u)" && \
    if echo "$deps" | grep -E '^(libomp|libgomp|libgraphblas|liblagraph|liblagraphx|libredisearch|libVectorSimilarity)'; then \
        echo "FAIL: libfalkordb.so has forbidden dynamic dependency"; exit 1; \
    fi && \
    undef="$(nm -D --undefined-only /out/falkordb.so 2>/dev/null | grep -E 'omp_|GOMP_|__kmpc_' || true)" && \
    if [ -n "$undef" ]; then echo "FAIL: OpenMP symbols undefined in .so:"; echo "$undef"; exit 1; fi && \
    unresolved="$(ldd /out/falkordb.so 2>&1 | grep -E 'Error (loading|relocating)|not found' || true)" && \
    if [ -n "$unresolved" ]; then echo "FAIL: libraries or symbols this OS cannot resolve (the module would not load):"; echo "$unresolved"; exit 1; fi && \
    echo "OK: libfalkordb.so is self-contained ($(du -h /out/falkordb.so | cut -f1))"

# ---------------------------------------------------------------------------
# Artifact export stage -- yields ONLY the built falkordb.so.
# ---------------------------------------------------------------------------
FROM scratch AS artifact
COPY --from=builder /out/falkordb.so /falkordb.so

# ---------------------------------------------------------------------------
# The server, built on this OS so it runs against the image's own musl and
# OpenSSL, by the same script as every other image.
# ---------------------------------------------------------------------------
FROM ${ALPINE} AS server-builder-base
# bsd-compat-headers: <sys/cdefs.h>, which Redis includes and musl lacks.
RUN apk add --no-cache git ca-certificates make gcc g++ musl-dev linux-headers \
      bsd-compat-headers openssl-dev pkgconf binutils
COPY ./build/build-server.sh /usr/local/bin/build-server

FROM server-builder-base AS redis-builder
ARG REDIS_VERSION
RUN build-server redis "${REDIS_VERSION}" /server-install

FROM server-builder-base AS valkey-builder
ARG VALKEY_VERSION
RUN build-server valkey "${VALKEY_VERSION}" /server-install

# ---------------------------------------------------------------------------
# Server image. Mirrors build/runtime/Dockerfile's `server` stage -- same
# paths, user, entrypoint and environment -- on Alpine.
# ---------------------------------------------------------------------------
FROM ${ALPINE} AS server-base

ENV FALKORDB_HOME=/var/lib/falkordb \
    FALKORDB_DATA_PATH=/var/lib/falkordb/data \
    FALKORDB_BIN_PATH=/var/lib/falkordb/bin \
    FALKORDB_IMPORT_PATH=/var/lib/falkordb/import \
    FALKORDB_TLS_PATH=/var/lib/falkordb/tls

# Required at runtime:
#   libstdc++, libgcc        : falkordb.so
#   libssl3, libcrypto3      : falkordb.so, and the server built with BUILD_TLS=yes
#   ca-certificates          : HTTPS in LOAD CSV
#   openssl, bash            : gen-certs.sh (TLS=1)
#   findutils                : run.sh's data-dir ownership fix-up
#   setpriv                  : behind the gosu that run.sh calls
# falkordb is uid/gid 999, as in the Debian image, so a data volume moves
# between the images without an ownership change. Alpine gives gid 999 to an
# empty `ping` group, which a server image has no use for.
RUN apk upgrade --no-cache && \
    apk add --no-cache \
      libstdc++ libgcc libssl3 libcrypto3 ca-certificates openssl bash findutils setpriv && \
    { delgroup ping 2>/dev/null || true; } && \
    addgroup -S -g 999 falkordb && adduser -S -D -H -u 999 -G falkordb falkordb

COPY ./build/runtime/gosu-setpriv.sh /usr/local/bin/gosu
RUN chmod 0755 /usr/local/bin/gosu

# root:falkordb 0775, for the reasons given in build/runtime/Dockerfile.
RUN mkdir -p ${FALKORDB_DATA_PATH} ${FALKORDB_BIN_PATH} ${FALKORDB_IMPORT_PATH} ${FALKORDB_TLS_PATH} && \
    chown root:falkordb ${FALKORDB_DATA_PATH} ${FALKORDB_TLS_PATH} && \
    chmod 0775 ${FALKORDB_DATA_PATH} ${FALKORDB_TLS_PATH} && \
    ln -s ${FALKORDB_DATA_PATH} /data

# The server tree, symlinked entry points included, as in the Debian image.
FROM server-base AS server-redis
ARG REDIS_VERSION
ENV FALKORDB_SERVER=redis \
    FALKORDB_SERVER_VERSION=${REDIS_VERSION}
COPY --from=redis-builder /server-install/ /usr/local/

FROM server-base AS server-valkey
ARG VALKEY_VERSION
ENV FALKORDB_SERVER=valkey \
    FALKORDB_SERVER_VERSION=${VALKEY_VERSION}
COPY --from=valkey-builder /server-install/ /usr/local/

FROM server-${SERVER} AS server

# BuildKit auto-ARGs must be re-declared in each stage that consumes them.
ARG TARGETPLATFORM

LABEL com.falkordb.server.name="${FALKORDB_SERVER}" \
      com.falkordb.server.version="${FALKORDB_SERVER_VERSION}"

WORKDIR ${FALKORDB_HOME}

COPY ./build/runtime/run.sh       ${FALKORDB_BIN_PATH}/run.sh
COPY ./build/runtime/gen-certs.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
RUN chmod +x ${FALKORDB_BIN_PATH}/run.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
COPY --from=builder /out/falkordb.so ${FALKORDB_BIN_PATH}/falkordb.so

# The builder checked the module against the builder's packages; this image
# installs far fewer, so check it again here. Then that the server is the one
# the labels name, every server entry point (and on valkey the redis-*
# aliases), and that gosu really switches to falkordb.
RUN unresolved="$(ldd ${FALKORDB_BIN_PATH}/falkordb.so 2>&1 | grep -E 'Error (loading|relocating)|not found' || true)" && \
    if [ -n "$unresolved" ]; then echo "FAIL: libraries or symbols this image cannot resolve:"; echo "$unresolved"; exit 1; fi && \
    "${FALKORDB_SERVER}-server" --version | grep -F " v=${FALKORDB_SERVER_VERSION} " && \
    for name in "${FALKORDB_SERVER}" redis; do \
        for tool in server cli sentinel check-aof; do \
            "${name}-${tool}" --version || exit 1; \
        done; \
        # valkey-check-rdb only reads --version after a file argument; see
        # build/runtime/Dockerfile.
        "${name}-check-rdb" --version 2>&1 | grep -E 'check-rdb|Checking RDB file' || exit 1; \
    done && \
    test "$(gosu falkordb id -u):$(gosu falkordb id -g)" = "999:999"

ENV ARCH=${TARGETPLATFORM} \
    TLS=0 \
    BROWSER=0 \
    FALKORDB_ARGS="MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000"

EXPOSE 6379/tcp

# run.sh execs ${FALKORDB_SERVER}-server itself and ignores container args (no CMD).
ENTRYPOINT ["/var/lib/falkordb/bin/run.sh"]
