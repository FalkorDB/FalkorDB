# Self-contained Amazon Linux 2023 (glibc 2.34) builder for the FalkorDB shared
# library. Unlike build/runtime/Dockerfile (which consumes the prebuilt Debian
# `falkordb-build` toolchain image), this image installs its own toolchain and
# builds GraphBLAS + LAGraph + libomp + RediSearch from source via the SAME
# scripts the Debian toolchain uses — so the produced .so has a glibc-2.34
# baseline and the single-.so self-containment contract still holds.
#
# Two targets:
#   artifact  the .so alone:  docker build --target artifact --output type=local,dest=<dir>
#   server    an Amazon Linux 2023 server image: Redis or Valkey
#             (--build-arg SERVER) built from source on this OS, plus that
#             same .so. The counterpart of the Debian image's `server`
#             target; no browser.
# Package set mirrors the C repo's build/docker/builder/Dockerfile.amazonlinux2023, minus
# the C-only peg/libcypher-parser bits the Rust port doesn't use.

ARG CXX=clang++-19
# Consumed (unused) so the shared _build-artifacts.yml can pass --build-arg
# BUILD_IMAGE uniformly without a "not consumed" warning; self-contained OSes
# don't use a toolchain base image.
ARG BUILD_IMAGE
# Which server the `server` target ships, and the server releases: the same
# as build/runtime/Dockerfile (build/check-server-pins.sh enforces it).
ARG SERVER=redis
ARG REDIS_VERSION=8.10.2
ARG VALKEY_VERSION=9.1.2

# ---------------------------------------------------------------------------
# Toolchain + dependency build.
# ---------------------------------------------------------------------------
FROM amazonlinux:2023.12.20260918.0 AS builder

# Re-declared inside the stage: the pre-FROM `ARG CXX` is global scope and is
# NOT visible here otherwise, which would silently expand ${CXX} to empty and
# hand native-deps a different cache key than the one it published under.
ARG CXX=clang++-19
ENV CC=clang-19
ENV CXX=${CXX}
# build.rs picks llvm-objcopy/objdump by bare name then -22/-21/-20; AL2023's
# clang19 tools are versioned -19, so point at them explicitly. LIBCLANG_PATH
# lets the redisearch_rs bindgen find clang19's libclang.
ENV LLVM_OBJCOPY=llvm-objcopy-19
ENV LLVM_OBJDUMP=llvm-objdump-19
ENV LIBCLANG_PATH=/usr/lib64/llvm19/lib
ENV PATH="/root/.cargo/bin:${PATH}"

# AL2023's default clang is 15 — too old for RediSearch's C++20. Use the
# versioned clang19 packages instead (clang-19 / clang++-19 land on PATH).
RUN dnf update -y && \
    dnf install -y \
      git wget tar gzip xz which diffutils file \
      make automake autoconf libtool perl \
      gcc gcc-c++ \
      clang19 clang19-devel llvm19 \
      openssl-devel zlib-devel \
      python3.11 python3.11-pip python3.11-devel && \
    dnf clean all && \
    alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 && \
    alternatives --auto python3

# Pin cmake to the same version the C builders use (UBI9's 3.26 also works for
# GraphBLAS, but keep one version across every OS for reproducibility).
RUN pip3.11 install --no-cache-dir 'cmake==3.31.6'

# Rust toolchain (rustup) — needed for the redisearch_rs crate and the cdylib.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

WORKDIR /data

# libomp.a (static) matched to the system clang version, installed to /opt/libomp
# so graph/build.rs links it statically (single-.so OpenMP contract).
COPY build/libomp.sh /tmp/libomp.sh
RUN LLVMORG_VERSION=$(clang-19 --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1) && \
    test -n "${LLVMORG_VERSION}" && \
    /tmp/libomp.sh "${LLVMORG_VERSION}" && \
    rm -f /tmp/libomp.sh

# GraphBLAS + LAGraph + RediSearch, built by the native-deps crate.
# It owns the recipes AND a content-addressed cache keyed on the submodule
# revisions, the GB_control patch, the vendored PreJIT kernels, $CC/$CXX and the
# OpenMP flavour -- so the key computed by `cargo build` below matches what is
# published here. CC/CXX/LIBOMP_PREFIX are pinned as ENV rather than passed per
# RUN because they are cache-key inputs: cmake probing a different `cc` would
# silently produce a different key and rebuild everything.
#
# The submodule sources come from the build context, so this needs
# `submodules: recursive` on actions/checkout. native-deps handles the missing
# `.git` itself (recipes::ensure_git_root), so no marker directory here.
ENV LIBOMP_PREFIX=/opt/libomp
COPY native-deps           /data/native-deps
COPY deps/native-deps.lock /data/deps/native-deps.lock
COPY build/graphblas       /data/build/graphblas
COPY deps/GraphBLAS        /data/deps/GraphBLAS
COPY deps/LAGraph          /data/deps/LAGraph
COPY deps/RediSearch       /data/deps/RediSearch
RUN cd /data && \
    cargo run --locked --manifest-path native-deps/Cargo.toml && \
    rm -rf /data/native-deps /data/build

# Build the cdylib from the repo source. graph/build.rs calls native_deps::ensure(),
# which recomputes the same keys and hits the entries published above -- no path
# probing, no GRAPHBLAS_LIB_DIR, no lagraph_lib.
WORKDIR /src
COPY . .
RUN cargo build --release && \
    mkdir -p /out && cp target/release/libfalkordb.so /out/falkordb.so && \
    echo "=== verify single-.so contract on libfalkordb.so ===" && \
    deps="$(ldd /out/falkordb.so | awk '{print $1}' | sort -u)" && \
    echo "$deps" && \
    if echo "$deps" | grep -E '^(libomp|libgomp|libgraphblas|liblagraph|liblagraphx|libredisearch|libVectorSimilarity)'; then \
        echo "FAIL: libfalkordb.so has forbidden dynamic dependency"; exit 1; \
    fi && \
    undef="$(nm -D --undefined-only /out/falkordb.so 2>/dev/null | grep -E 'omp_|GOMP_|__kmpc_' || true)" && \
    if [ -n "$undef" ]; then echo "FAIL: OpenMP symbols undefined in .so:"; echo "$undef"; exit 1; fi && \
    unresolved="$(ldd -r /out/falkordb.so 2>&1 | grep -E 'undefined symbol|not found' || true)" && \
    if [ -n "$unresolved" ]; then echo "FAIL: libraries or symbols this OS cannot resolve (the module would not load):"; echo "$unresolved"; exit 1; fi && \
    echo "OK: libfalkordb.so is self-contained ($(du -h /out/falkordb.so | cut -f1))"

# ---------------------------------------------------------------------------
# Artifact export stage — yields ONLY the built falkordb.so.
# ---------------------------------------------------------------------------
FROM scratch AS artifact
COPY --from=builder /out/falkordb.so /falkordb.so

# ---------------------------------------------------------------------------
# The server, built on this OS so it runs against the image's own glibc and
# OpenSSL, by the same build/build-server.sh as build/runtime/Dockerfile.
# Only the builder the SERVER arg selects is built.
# ---------------------------------------------------------------------------
FROM amazonlinux:2023.12.20260918.0 AS server-builder-base
RUN dnf install -y git gcc gcc-c++ make openssl-devel && \
    dnf clean all
COPY ./build/build-server.sh /usr/local/bin/build-server

FROM server-builder-base AS redis-builder
ARG REDIS_VERSION
RUN build-server redis "${REDIS_VERSION}" /server-install

FROM server-builder-base AS valkey-builder
ARG VALKEY_VERSION
RUN build-server valkey "${VALKEY_VERSION}" /server-install

# ---------------------------------------------------------------------------
# Server image. Mirrors build/runtime/Dockerfile's `server` stage -- same
# paths, user, entrypoint and environment -- on amazonlinux:2023.12.20260918.0.
# ---------------------------------------------------------------------------
FROM amazonlinux:2023.12.20260918.0 AS server-base

ENV FALKORDB_HOME=/var/lib/falkordb \
    FALKORDB_DATA_PATH=/var/lib/falkordb/data \
    FALKORDB_BIN_PATH=/var/lib/falkordb/bin \
    FALKORDB_IMPORT_PATH=/var/lib/falkordb/import \
    FALKORDB_TLS_PATH=/var/lib/falkordb/tls

# Required at runtime:
#   libstdc++       : falkordb.so
#   openssl-libs    : the server, built with BUILD_TLS=yes
#   openssl, bash   : gen-certs.sh (TLS=1)
#   findutils       : run.sh's data-dir ownership fix-up
#   util-linux      : setpriv(1), behind the gosu that run.sh calls
#   shadow-utils    : groupadd/useradd for the falkordb user
# falkordb is uid/gid 999, as in the Debian image, so a data volume moves
# between the two images without an ownership change.
RUN dnf update -y && \
    dnf install -y --setopt=install_weak_deps=0 \
      libstdc++ openssl-libs openssl bash findutils util-linux shadow-utils && \
    groupadd -r -g 999 falkordb && useradd -r -g falkordb -u 999 falkordb && \
    dnf clean all

COPY ./build/runtime/gosu-setpriv.sh /usr/local/bin/gosu
RUN chmod 0755 /usr/local/bin/gosu

# root:falkordb 0775, for the reasons given in build/runtime/Dockerfile.
RUN mkdir -p ${FALKORDB_DATA_PATH} ${FALKORDB_BIN_PATH} ${FALKORDB_IMPORT_PATH} ${FALKORDB_TLS_PATH} && \
    chown root:falkordb ${FALKORDB_DATA_PATH} ${FALKORDB_TLS_PATH} && \
    chmod 0775 ${FALKORDB_DATA_PATH} ${FALKORDB_TLS_PATH} && \
    ln -s ${FALKORDB_DATA_PATH} /data

# The server tree, symlinked entry points included, as in the Debian image.
FROM server-base AS server-redis
ARG REDIS_VERSION
ENV FALKORDB_SERVER=redis \
    FALKORDB_SERVER_VERSION=${REDIS_VERSION}
COPY --from=redis-builder /server-install/ /usr/local/

FROM server-base AS server-valkey
ARG VALKEY_VERSION
ENV FALKORDB_SERVER=valkey \
    FALKORDB_SERVER_VERSION=${VALKEY_VERSION}
COPY --from=valkey-builder /server-install/ /usr/local/

FROM server-${SERVER} AS server

# BuildKit auto-ARGs must be re-declared in each stage that consumes them.
ARG TARGETPLATFORM

LABEL com.falkordb.server.name="${FALKORDB_SERVER}" \
      com.falkordb.server.version="${FALKORDB_SERVER_VERSION}"

WORKDIR ${FALKORDB_HOME}

COPY ./build/runtime/run.sh       ${FALKORDB_BIN_PATH}/run.sh
COPY ./build/runtime/gen-certs.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
RUN chmod +x ${FALKORDB_BIN_PATH}/run.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
COPY --from=builder /out/falkordb.so ${FALKORDB_BIN_PATH}/falkordb.so

# The builder checked the module against the builder's packages; this image
# installs far fewer, so check it again here. Then that the server is the one
# the labels name, every server entry point (and on valkey the redis-*
# aliases), and that gosu really switches to falkordb.
RUN unresolved="$(ldd -r ${FALKORDB_BIN_PATH}/falkordb.so 2>&1 | grep -E 'undefined symbol|not found' || true)" && \
    if [ -n "$unresolved" ]; then echo "FAIL: libraries or symbols this image cannot resolve:"; echo "$unresolved"; exit 1; fi && \
    "${FALKORDB_SERVER}-server" --version | grep -F " v=${FALKORDB_SERVER_VERSION} " && \
    for name in "${FALKORDB_SERVER}" redis; do \
        for tool in server cli sentinel check-aof; do \
            "${name}-${tool}" --version || exit 1; \
        done; \
        # valkey-check-rdb only reads --version after a file argument; see
        # build/runtime/Dockerfile.
        "${name}-check-rdb" --version 2>&1 | grep -E 'check-rdb|Checking RDB file' || exit 1; \
    done && \
    test "$(gosu falkordb id -u):$(gosu falkordb id -g)" = "999:999"

ENV ARCH=${TARGETPLATFORM} \
    TLS=0 \
    BROWSER=0 \
    FALKORDB_ARGS="MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000"

EXPOSE 6379/tcp

# run.sh execs ${FALKORDB_SERVER}-server itself and ignores container args (no CMD).
ENTRYPOINT ["/var/lib/falkordb/bin/run.sh"]
