ARG BUILD_IMAGE=ghcr.io/falkordb/falkordb-build:latest
ARG TARGETPLATFORM=linux/amd64
# Which server the image runs, and the server releases: the same as
# build/runtime/Dockerfile (build/check-server-pins.sh enforces it).
ARG SERVER=redis
ARG REDIS_VERSION=8.10.2
ARG VALKEY_VERSION=9.1.2

# Stage 1: chef/planner — same cache split as the regular Dockerfile so a
# source-only change skips the dep cook.
FROM $BUILD_IMAGE AS chef
RUN cargo install cargo-chef --locked
WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Stage 2: builder — instrumented .so via -C instrument-coverage. Dev profile
# (no --release) preserves debuginfo + line tables that llvm-cov needs for
# accurate source mapping. Output lands in target/debug/.
FROM chef AS builder
COPY --from=planner /src/recipe.json recipe.json
# cargo-chef stubs out build SCRIPTS, but cargo still has to RESOLVE every
# manifest -- and graph/Cargo.toml carries a path build-dependency on
# ../native-deps. Without the crate present, `cook` fails with
# "failed to read /src/native-deps/Cargo.toml". It is ~140KB of source and its
# own workspace, so copying it here costs nothing and does not disturb the
# dependency layer chef is caching.
COPY native-deps native-deps
COPY deps/native-deps.lock deps/native-deps.lock
RUN CXX=clang++-23 RUSTFLAGS="-C instrument-coverage -C link-arg=-Wl,--allow-multiple-definition" \
    cargo chef cook --recipe-path recipe.json
COPY . .
RUN CXX=clang++-23 RUSTFLAGS="-C instrument-coverage -C link-arg=-Wl,--allow-multiple-definition" cargo build && \
    mkdir -p /out && cp target/debug/libfalkordb.so /out/falkordb.so

# Stage 3: server builders — the stock server on debian:trixie-slim, by the
# same build/build-server.sh as build/runtime/Dockerfile. Coverage
# instrumentation lives in the .so only (LLVM_PROFILE_FILE writes profraw from
# rustc -C instrument-coverage), so the server itself is uninstrumented. Only
# the builder the SERVER arg selects is built.
FROM debian:trixie-slim AS server-builder-base
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates git gcc g++ libc6-dev libssl-dev make; \
    rm -rf /var/lib/apt/lists/*
COPY ./build/build-server.sh /usr/local/bin/build-server

FROM server-builder-base AS redis-builder
ARG REDIS_VERSION
RUN build-server redis "${REDIS_VERSION}" /server-install

FROM server-builder-base AS valkey-builder
ARG VALKEY_VERSION
RUN build-server valkey "${VALKEY_VERSION}" /server-install

FROM debian:trixie-slim AS server-base
ENV FALKORDB_HOME=/var/lib/falkordb \
    FALKORDB_DATA_PATH=/var/lib/falkordb/data \
    FALKORDB_BIN_PATH=/var/lib/falkordb/bin \
    FALKORDB_IMPORT_PATH=/var/lib/falkordb/import \
    FALKORDB_TLS_PATH=/var/lib/falkordb/tls \
    FALKORDB_COV_PATH=/var/lib/falkordb/cov

RUN mkdir -p ${FALKORDB_DATA_PATH} ${FALKORDB_COV_PATH} && ln -s ${FALKORDB_DATA_PATH} /data

# Runtime apt install — bare essentials only. After PR #483 GraphBLAS JIT is
# disabled and libomp is statically linked into the instrumented .so (see
# graph/build.rs + build/libomp.sh), so this image no longer needs clang,
# libomp5, libomp-23-dev, the LLVM repo, or any dpkg force-removes. The
# coverage runtime itself is baked into the instrumented .so by rustc's
# -C instrument-coverage profile.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates bash openssl libssl3 && \
    apt-get upgrade -y && \
    # The falkordb user (uid/gid 999, as in the release image) before purging passwd.
    groupadd -r -g 999 falkordb && useradd -r -g falkordb -u 999 falkordb && \
    (apt-get purge -y python3.13 python3.13-minimal libpython3.13-minimal libpython3.13-stdlib || true) && \
    (dpkg --force-remove-essential --purge ncurses-base ncurses-bin || true) && \
    (dpkg --force-remove-essential --purge perl-base || true) && \
    (dpkg --force-remove-protected --force-remove-essential --purge login || true) && \
    (dpkg --purge passwd || true) && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# The server tree, symlinked entry points included, as in the release image.
FROM server-base AS server-redis
ARG REDIS_VERSION
ENV FALKORDB_SERVER=redis \
    FALKORDB_SERVER_VERSION=${REDIS_VERSION}
COPY --from=redis-builder /server-install/ /usr/local/

FROM server-base AS server-valkey
ARG VALKEY_VERSION
ENV FALKORDB_SERVER=valkey \
    FALKORDB_SERVER_VERSION=${VALKEY_VERSION}
COPY --from=valkey-builder /server-install/ /usr/local/

FROM server-${SERVER} AS server

ARG TARGETPLATFORM

LABEL com.falkordb.server.name="${FALKORDB_SERVER}" \
      com.falkordb.server.version="${FALKORDB_SERVER_VERSION}"

WORKDIR ${FALKORDB_HOME}

COPY ./build/runtime/run.sh       ${FALKORDB_BIN_PATH}/run.sh
COPY ./build/runtime/gen-certs.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
RUN chmod +x ${FALKORDB_BIN_PATH}/run.sh ${FALKORDB_BIN_PATH}/gen-certs.sh
COPY --from=builder /out/falkordb.so ${FALKORDB_BIN_PATH}/falkordb.so

# Instrumentation runtime: every llvm-cov-aware binary writes profraw files
# named per the LLVM_PROFILE_FILE template. %p = pid, %m = module hash; both
# substitutions are needed because the server forks (BGSAVE / RDB) and the test
# loads the module fresh per Env(). FALKORDB_COV_PATH should be bind-mounted
# from the host so the test job can collect the files after the run.
ENV ARCH=${TARGETPLATFORM} \
    TLS=0 \
    BROWSER=0 \
    FALKORDB_ARGS="MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000" \
    LLVM_PROFILE_FILE=/var/lib/falkordb/cov/profraw_%p_%m.profraw \
    # run.sh drops root to `falkordb` in the release image. Not here: this image
    # has no gosu, and as `falkordb` the profraw writes into the root-owned cov
    # dir (and its bind mounts) would fail without a sound.
    SKIP_DROP_PRIVS=1

EXPOSE 6379/tcp
ENTRYPOINT ["/var/lib/falkordb/bin/run.sh"]
