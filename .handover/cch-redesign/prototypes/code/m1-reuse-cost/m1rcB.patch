+#[derive(Default, Debug)]
+struct Checks {
+    split_fail: u64,
+    eq_levels: u64,
+    eq_fail: u64,
+    b1_checked: u64,
+    b1_invalid: u64,
+    w_fail: u64,
+    acct_levels: u64,
+    acct_fail: u64,
+    match_calls_b: u64,
+    cs_cap_checked: u64,
+    cs_cap_fail: u64,
+    cs_w_checked: u64,
+    cs_w_fail: u64,
+    sep_checked: u64,
+    sep_fail: u64,
+    fp_compared: u64,
+    fp_fail: u64,
