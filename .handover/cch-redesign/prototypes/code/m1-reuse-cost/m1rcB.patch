+//! SCRATCH (never committed): M1 cost of the GraphBLAS coarsening of design §3.
+//!
+//! Env: M1_GRAPH (edge list path), M1_THREADS ("1,4"), M1_RUNS (3), M1_DEPTHS ("0..=14"),
+//! M1_BREAK (nomutual|nooffdiag|split), M1_BURBLE (1), M1_JIT (run), M1_VERIFY (1), M1_FERAL (runs).
+//!
+//!   cargo test --release -p graph --features index-falkordb m1_coarsen -- --ignored --nocapture
+
+use super::matrix::set_nthreads;
+use super::test_init::ensure_init;
+use super::*;
+use std::collections::BTreeMap;
+use std::ffi::c_void;
+use std::time::Instant;
+
+macro_rules! ok {
+    ($e:expr) => {{
+        #[allow(unused_unsafe)]
+        let info = unsafe { $e };
+        assert_eq!(info, GrB_Info::GrB_SUCCESS, "GraphBLAS: {}", stringify!($e));
+    }};
+}
+
+unsafe extern "C" {
+    fn fflush(f: *mut c_void) -> i32;
+}
+fn flush() {
+    use std::io::Write;
+    std::io::stdout().flush().unwrap();
+    unsafe { fflush(std::ptr::null_mut()) };
+}
+
+struct M(GrB_Matrix);
+impl M {
+    fn new(t: GrB_Type, r: u64, c: u64) -> M {
+        let mut m = std::ptr::null_mut();
+        ok!(GrB_Matrix_new(&mut m, t, r, c));
+        M(m)
+    }
+    fn nvals(&self) -> u64 {
+        let mut n = 0;
+        ok!(GrB_Matrix_nvals(&mut n, self.0));
+        n
+    }
+    fn nrows(&self) -> u64 {
+        let mut n = 0;
+        ok!(GrB_Matrix_nrows(&mut n, self.0));
+        n
+    }
+    fn wait(&self) {
+        ok!(GrB_Matrix_wait(self.0, GrB_WaitMode::GrB_MATERIALIZE as i32));
+    }
+    fn sum(&self) -> i64 {
+        let mut s = 0i64;
+        ok!(GrB_Matrix_reduce_INT64(&mut s, std::ptr::null_mut(), GrB_PLUS_MONOID_INT64, self.0, std::ptr::null_mut()));
+        s
+    }
+}
+impl Drop for M {
+    fn drop(&mut self) {
+        unsafe { GrB_Matrix_free(&mut self.0) };
+    }
+}
+struct V(GrB_Vector);
+impl V {
+    fn new(t: GrB_Type, n: u64) -> V {
+        let mut v = std::ptr::null_mut();
+        ok!(GrB_Vector_new(&mut v, t, n));
+        V(v)
+    }
+    fn dup(&self) -> V {
+        let mut v = std::ptr::null_mut();
+        ok!(GrB_Vector_dup(&mut v, self.0));
+        V(v)
+    }
+    fn nvals(&self) -> u64 {
+        let mut n = 0;
+        ok!(GrB_Vector_nvals(&mut n, self.0));
+        n
+    }
+    fn wait(&self) {
+        ok!(GrB_Vector_wait(self.0, GrB_WaitMode::GrB_MATERIALIZE as i32));
+    }
+    fn sum(&self) -> i64 {
+        let mut s = 0i64;
+        ok!(GrB_Vector_reduce_INT64(&mut s, std::ptr::null_mut(), GrB_PLUS_MONOID_INT64, self.0, std::ptr::null_mut()));
+        s
+    }
+    fn u64s(&self) -> (Vec<u64>, Vec<u64>) {
+        let mut n = self.nvals();
+        let mut i = vec![0u64; n as usize];
+        let mut x = vec![0u64; n as usize];
+        ok!(GrB_Vector_extractTuples_UINT64(i.as_mut_ptr(), x.as_mut_ptr(), &mut n, self.0));
+        (i, x)
+    }
+    fn i32s(&self) -> (Vec<u64>, Vec<i32>) {
+        let mut n = self.nvals();
+        let mut i = vec![0u64; n as usize];
+        let mut x = vec![0i32; n as usize];
+        ok!(GrB_Vector_extractTuples_INT32(i.as_mut_ptr(), x.as_mut_ptr(), &mut n, self.0));
+        (i, x)
+    }
+}
+impl Drop for V {
+    fn drop(&mut self) {
+        unsafe { GrB_Vector_free(&mut self.0) };
+    }
+}
+fn null<T>() -> *mut T {
+    std::ptr::null_mut()
+}
+fn t_bool() -> GrB_Type {
+    unsafe { GrB_BOOL }
+}
+fn t_i32() -> GrB_Type {
+    unsafe { GrB_INT32 }
+}
+fn t_i64() -> GrB_Type {
+    unsafe { GrB_INT64 }
+}
+fn t_u64() -> GrB_Type {
+    unsafe { GrB_UINT64 }
+}
+
+// ---- user operators (these are what a PreJIT harvest would have to cover) ----
+fn fmix32(mut h: u32) -> u32 {
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x85eb_ca6b);
+    h ^= h >> 13;
+    h = h.wrapping_mul(0xc2b2_ae35);
+    h ^= h >> 16;
+    h
+}
+fn unfmix32(mut h: u32) -> u32 {
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x7ed1_b41d);
+    h ^= (h >> 13) ^ (h >> 26);
+    h = h.wrapping_mul(0xa5cb_9243);
+    h ^= h >> 16;
+    h
+}
+/// K(i,j) = (A(i,j) << 32) | fmix32(j ^ salt): unique per row, so MAX is deterministic.
+unsafe extern "C" fn key_op(
+    z: *mut c_void,
+    x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    y: *const c_void,
+) {
+    unsafe {
+        let w = *(x as *const i32) as u32 as u64;
+        let salt = *(y as *const u64) as u32;
+        *(z as *mut u64) = (w << 32) | fmix32((j as u32) ^ salt) as u64;
+    }
+}
+/// The column a key was made from.
+unsafe extern "C" fn unkey_op(
+    z: *mut c_void,
+    x: *const c_void,
+    _i: GrB_Index,
+    _j: GrB_Index,
+    y: *const c_void,
+) {
+    unsafe {
+        let k = *(x as *const u64);
+        let salt = *(y as *const u64) as u32;
+        *(z as *mut u64) = (unfmix32(k as u32) ^ salt) as u64;
+    }
+}
+unsafe extern "C" fn even_op(
+    z: *mut c_void,
+    _x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    _y: *const c_void,
+) {
+    unsafe { *(z as *mut bool) = j & 1 == 0 };
+}
+unsafe extern "C" fn odd_op(
+    z: *mut c_void,
+    _x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    _y: *const c_void,
+) {
+    unsafe { *(z as *mut bool) = j & 1 == 1 };
+}
+
+struct Ops {
+    key: GrB_IndexUnaryOp,
+    unkey: GrB_IndexUnaryOp,
+    even: GrB_IndexUnaryOp,
+    odd: GrB_IndexUnaryOp,
+    one_i32: GrB_Scalar,
+}
+impl Ops {
+    fn new() -> Ops {
+        let mut key = null();
+        let mut unkey = null();
+        let mut even = null();
+        let mut odd = null();
+        ok!(GrB_IndexUnaryOp_new(&mut key, Some(key_op), t_u64(), t_i32(), t_u64()));
+        ok!(GrB_IndexUnaryOp_new(&mut unkey, Some(unkey_op), t_u64(), t_u64(), t_u64()));
+        ok!(GrB_IndexUnaryOp_new(&mut even, Some(even_op), t_bool(), t_i64(), t_i64()));
+        ok!(GrB_IndexUnaryOp_new(&mut odd, Some(odd_op), t_bool(), t_i64(), t_i64()));
+        let mut one_i32 = null();
+        ok!(GrB_Scalar_new(&mut one_i32, t_i32()));
+        ok!(GrB_Scalar_setElement_INT32(one_i32, 1));
+        Ops { key, unkey, even, odd, one_i32 }
+    }
+}
+
+/// Seconds per named call, summed within a level.
+#[derive(Default, Clone)]
+struct Timer(BTreeMap<&'static str, f64>);
+impl Timer {
+    fn time<R>(
+        &mut self,
+        name: &'static str,
+        f: impl FnOnce() -> R,
+    ) -> R {
+        if burble() {
+            println!("@@CALL {name}");
+            flush();
+        }
+        let t = Instant::now();
+        let r = f();
+        *self.0.entry(name).or_default() += t.elapsed().as_secs_f64();
+        r
+    }
+}
+
+fn env(k: &str) -> Option<String> {
+    std::env::var(k).ok().filter(|s| !s.is_empty())
+}
+fn brk(k: &str) -> bool {
+    env("M1_BREAK").as_deref() == Some(k)
+}
+fn burble() -> bool {
+    env("M1_BURBLE").is_some()
+}
+/// Build C' (n x nc, row-major sorted tuples) instead of C.
+fn ct() -> bool {
+    env("M1_CT").is_some()
+}
+fn verify() -> bool {
+    env("M1_VERIFY").is_some()
+}
+
+/// w as a dense host array indexed by vertex (0 where w has no entry). Equals w.i32s().1 for a full w.
+fn dense_i32(w: &V) -> Vec<i32> {
+    let (wi, wx) = w.i32s();
+    let mut n = 0;
+    ok!(GrB_Vector_size(&mut n, w.0));
+    if wi.len() as u64 == n {
+        return wx;
+    }
+    let mut d = vec![0i32; n as usize];
+    for (i, x) in wi.into_iter().zip(wx) {
+        d[i as usize] = x;
+    }
+    d
+}
+
+/// Full UINT64 vector idx(i) = i.
+fn index_vector(n: u64) -> V {
+    let idx = V::new(t_u64(), n);
+    ok!(GrB_Vector_assign_UINT64(idx.0, null(), null(), 0, GrB_ALL, n, null()));
+    ok!(GrB_Vector_apply_IndexOp_INT64(idx.0, null(), null(), GrB_ROWINDEX_INT64, idx.0, 0, null()));
+    idx.wait();
+    idx
+}
+
+struct LevelOut {
+    c: M,
+    ac: M,
+    wc: V,
+    rounds: u32,
+    twohop: bool,
+    pairs: u64,
+}
+
+/// Number of coarsen_level calls (matching runs) so far; B1/B2 must never add to it.
+static MATCH_CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// One coarsening level, steps (1)-(2) of design §3, every call timed.
+fn coarsen_level(
+    a: &M,
+    w: &V,
+    cap: i32,
+    salt: u64,
+    ops: &Ops,
+    t: &mut Timer,
+) -> LevelOut {
+    MATCH_CALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let n = a.nrows();
+    // Live vertices are w's entries; dead ones (removed separators) have empty rows and must not get a
+    // coarse vertex. With a full w (every existing caller) this is the old code path, unchanged.
+    let n_live = w.nvals();
+    let partial = n_live != n;
+    // (1a) cap mask: S(i,j) = w(i)+w(j) on A's pattern, keep <= cap. Skipped when no pair can exceed it.
+    let mut maxw = 0i32;
+    ok!(GrB_Vector_reduce_INT32(&mut maxw, null(), GrB_MAX_MONOID_INT32, w.0, null()));
+    let mcap = if 2 * maxw as i64 > cap as i64 {
+        Some(t.time("cap", || {
+            let mut d = null();
+            ok!(GrB_Matrix_diag(&mut d, w.0, 0));
+            let d = M(d);
+            let left = M::new(t_i32(), n, n);
+            ok!(GrB_mxm(left.0, null(), null(), GxB_PLUS_FIRST_INT32, d.0, a.0, null()));
+            let right = M::new(t_i32(), n, n);
+            ok!(GrB_mxm(right.0, null(), null(), GxB_PLUS_SECOND_INT32, a.0, d.0, null()));
+            let s = M::new(t_i32(), n, n);
+            ok!(GrB_Matrix_eWiseMult_BinaryOp(s.0, null(), null(), GrB_PLUS_INT32, left.0, right.0, null()));
+            ok!(GrB_Matrix_select_INT32(s.0, null(), null(), GrB_VALUELE_INT32, s.0, cap, null()));
+            s.wait();
+            s
+        }))
+    } else {
+        None
+    };
+    // (1b) keys by a user positional op.
+    let k = t.time("key", || {
+        let k = M::new(t_u64(), n, n);
+        let mask = mcap.as_ref().map_or(null(), |m| m.0);
+        let desc = if mcap.is_some() { unsafe { GrB_DESC_S } } else { null() };
+        ok!(GrB_Matrix_apply_IndexOp_UINT64(k.0, mask, null(), ops.key, a.0, salt, desc));
+        k.wait();
+        k
+    });
+    drop(mcap);
+    let idx = t.time("idx", || index_vector(n));
+    let mate = idx.dup();
+    let mut u = if partial {
+        t.time("idx", || {
+            let u = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(u.0, w.0, null(), GrB_IDENTITY_UINT64, idx.0, GrB_DESC_S));
+            u.wait();
+            u
+        })
+    } else {
+        idx.dup()
+    };
+    // (1c) rounds of mutual-max proposals until a round matches nothing.
+    let mut rounds = 0;
+    let mut matched = 0u64;
+    loop {
+        rounds += 1;
+        let y = V::new(t_u64(), n);
+        t.time("mxv", || {
+            ok!(GrB_mxv(y.0, u.0, null(), GxB_MAX_FIRST_UINT64, k.0, u.0, GrB_DESC_RS));
+            y.wait();
+        });
+        let np = y.nvals();
+        if np == 0 {
+            break;
+        }
+        t.time("m_unkey", || {
+            ok!(GrB_Vector_apply_IndexOp_UINT64(y.0, null(), null(), ops.unkey, y.0, salt, null()));
+            y.wait();
+        });
+        let m = V::new(t_bool(), n);
+        if brk("nomutual") {
+            ok!(GrB_Vector_assign_BOOL(m.0, y.0, null(), true, GrB_ALL, n, GrB_DESC_S));
+        } else {
+            let pf = t.time("m_full", || {
+                let pf = V::new(t_u64(), n);
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(pf.0, null(), null(), GrB_SECOND_UINT64, idx.0, y.0, null()));
+                pf.wait();
+                pf
+            });
+            let q = t.time("m_extract", || {
+                let q = V::new(t_u64(), n);
+                ok!(GxB_Vector_extract_Vector(q.0, null(), null(), pf.0, pf.0, null()));
+                q.wait();
+                q
+            });
+            t.time("m_eq", || {
+                ok!(GrB_Vector_eWiseMult_BinaryOp(m.0, y.0, null(), GrB_EQ_UINT64, q.0, idx.0, GrB_DESC_RS));
+                m.wait();
+            });
+        }
+        t.time("m_assign", || {
+            ok!(GrB_Vector_assign(mate.0, m.0, null(), y.0, GrB_ALL, n, null()));
+            mate.wait();
+        });
+        let u2 = t.time("m_unext", || {
+            let u2 = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(u2.0, m.0, null(), GrB_IDENTITY_UINT64, y.0, GrB_DESC_RC));
+            u2.wait();
+            u2
+        });
+        let newly = np - u2.nvals();
+        u = u2;
+        matched += newly;
+        if newly == 0 {
+            break;
+        }
+    }
+    let round_mate = if verify() { Some(mate.u64s().1) } else { None };
+    // (1d) 2-hop pass when the matching shrinks the level by under 15 %.
+    let mut twohop = false;
+    if (matched / 2) * 100 < 15 * n_live {
+        twohop = true;
+        let pairs = t.time("twohop", || {
+            let um = V::new(t_bool(), n);
+            ok!(GrB_Vector_eWiseMult_BinaryOp(um.0, null(), null(), GrB_EQ_UINT64, mate.0, idx.0, null()));
+            let anchor = V::new(t_u64(), n);
+            ok!(GrB_mxv(anchor.0, um.0, null(), GxB_MAX_FIRST_UINT64, k.0, idx.0, GrB_DESC_R));
+            ok!(GrB_Vector_apply_IndexOp_UINT64(anchor.0, null(), null(), ops.unkey, anchor.0, salt, null()));
+            let jv = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(jv.0, anchor.0, null(), GrB_IDENTITY_UINT64, idx.0, GrB_DESC_RS));
+            let g = M::new(t_u64(), n, n);
+            ok!(GxB_Matrix_build_Vector(g.0, anchor.0, jv.0, jv.0, null(), null()));
+            let p = M::new(t_i64(), n, n);
+            ok!(GxB_Matrix_sort(null(), p.0, GrB_LT_UINT64, g.0, null()));
+            let e = M::new(t_i64(), n, n);
+            ok!(GrB_Matrix_select_INT64(e.0, null(), null(), ops.even, p.0, 0, null()));
+            let o = M::new(t_i64(), n, n);
+            ok!(GrB_Matrix_select_INT64(o.0, null(), null(), ops.odd, p.0, 0, null()));
+            let e2 = M::new(t_i64(), n, n - 1);
+            let lo = [0u64, n - 2];
+            ok!(GrB_Matrix_extract(e2.0, null(), null(), e.0, GrB_ALL, n, lo.as_ptr(), GxB_RANGE, null()));
+            let o2 = M::new(t_i64(), n, n - 1);
+            let hi = [1u64, n - 1];
+            ok!(GrB_Matrix_extract(o2.0, null(), null(), o.0, GrB_ALL, n, hi.as_ptr(), GxB_RANGE, null()));
+            let pe = M::new(t_i64(), n, n - 1);
+            ok!(GrB_Matrix_eWiseMult_BinaryOp(pe.0, null(), null(), GrB_FIRST_INT64, e2.0, o2.0, null()));
+            let po = M::new(t_i64(), n, n - 1);
+            ok!(GrB_Matrix_eWiseMult_BinaryOp(po.0, null(), null(), GrB_SECOND_INT64, e2.0, o2.0, null()));
+            let mut np = pe.nvals();
+            let mut xe = vec![0i64; np as usize];
+            let mut xo = vec![0i64; np as usize];
+            ok!(GrB_Matrix_extractTuples_INT64(null(), null(), xe.as_mut_ptr(), &mut np, pe.0));
+            ok!(GrB_Matrix_extractTuples_INT64(null(), null(), xo.as_mut_ptr(), &mut np, po.0));
+            // host: cap check, then both directions into mate
+            let wv = dense_i32(w);
+            let mut bi = Vec::with_capacity(2 * xe.len());
+            let mut bx = Vec::with_capacity(2 * xe.len());
+            for (&x, &y) in xe.iter().zip(&xo) {
+                if (wv[x as usize] as i64 + wv[y as usize] as i64) <= cap as i64 {
+                    bi.push(x as u64);
+                    bx.push(y as u64);
+                    bi.push(y as u64);
+                    bx.push(x as u64);
+                }
+            }
+            let tmp = V::new(t_u64(), n);
+            ok!(GrB_Vector_build_UINT64(tmp.0, bi.as_ptr(), bx.as_ptr(), bi.len() as u64, null()));
+            ok!(GrB_Vector_assign(mate.0, tmp.0, null(), tmp.0, GrB_ALL, n, GrB_DESC_S));
+            mate.wait();
+            bi.len() as u64 / 2
+        });
+        matched += 2 * pairs;
+    }
+    if let Some(rm) = round_mate {
+        check_matching(a, w, cap, &rm, &mate.u64s().1);
+    }
+    drop(k);
+    // (1e) C: one row per coarse vertex; leader = min(i, mate(i)).
+    let (l, lead) = t.time("c_leader", || {
+        let l = V::new(t_u64(), n);
+        ok!(GrB_Vector_eWiseMult_BinaryOp(l.0, null(), null(), GrB_MIN_UINT64, idx.0, mate.0, null()));
+        let lead = V::new(t_bool(), n);
+        ok!(GrB_Vector_eWiseMult_BinaryOp(lead.0, null(), null(), GrB_EQ_UINT64, l.0, idx.0, null()));
+        ok!(GrB_Vector_select_BOOL(lead.0, null(), null(), GrB_VALUEEQ_BOOL, lead.0, true, null()));
+        let lead = if partial {
+            let l2 = V::new(t_bool(), n);
+            ok!(GrB_Vector_apply(l2.0, w.0, null(), GrB_IDENTITY_BOOL, lead.0, GrB_DESC_S));
+            l2
+        } else {
+            lead
+        };
+        lead.wait();
+        l.wait();
+        (l, lead)
+    });
+    let (cid, nc) = t.time("c_number_host", || {
+        let mut nc = lead.nvals();
+        let mut li = vec![0u64; nc as usize];
+        ok!(GrB_Vector_extractTuples_BOOL(li.as_mut_ptr(), null(), &mut nc, lead.0));
+        let ids: Vec<u64> = (0..nc).collect();
+        let cid = V::new(t_u64(), n);
+        ok!(GrB_Vector_build_UINT64(cid.0, li.as_ptr(), ids.as_ptr(), nc, null()));
+        cid.wait();
+        (cid, nc)
+    });
+    let ca = t.time("c_extract", || {
+        let ca = V::new(t_u64(), n);
+        ok!(GxB_Vector_extract_Vector(ca.0, null(), null(), cid.0, l.0, null()));
+        ca.wait();
+        ca
+    });
+    let c = t.time("c_build", || {
+        let c = if ct() { M::new(t_i32(), n, nc) } else { M::new(t_i32(), nc, n) };
+        let idl = if partial {
+            let v = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(v.0, w.0, null(), GrB_IDENTITY_UINT64, idx.0, GrB_DESC_S));
+            Some(v)
+        } else {
+            None
+        };
+        let ii = idl.as_ref().map_or(idx.0, |v| v.0);
+        if ct() {
+            ok!(GxB_Matrix_build_Scalar_Vector(c.0, ii, ca.0, ops.one_i32, null()));
+        } else {
+            ok!(GxB_Matrix_build_Scalar_Vector(c.0, ca.0, ii, ops.one_i32, null()));
+        }
+        c.wait();
+        c
+    });
+    // (2) contraction A_c = select(OFFDIAG, C A C'), PLUS_TIMES_INT32; w_c = C w.
+    let tmat = t.time("CA", || {
+        let tm = M::new(t_i32(), nc, n);
+        let d = if ct() { unsafe { GrB_DESC_T0 } } else { null() };
+        ok!(GrB_mxm(tm.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, c.0, a.0, d));
+        tm.wait();
+        tm
+    });
+    let ac = t.time("CAC'", || {
+        let ac = M::new(t_i32(), nc, nc);
+        let d = if ct() { null() } else { unsafe { GrB_DESC_T1 } };
+        ok!(GrB_mxm(ac.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, tmat.0, c.0, d));
+        ac.wait();
+        ac
+    });
+    drop(tmat);
+    if !brk("nooffdiag") {
+        t.time("offdiag", || {
+            ok!(GrB_Matrix_select_INT64(ac.0, null(), null(), GrB_OFFDIAG, ac.0, 0, null()));
+            ac.wait();
+        });
+    }
+    let wc = t.time("Cw", || {
+        let wc = V::new(t_i32(), nc);
+        let d = if ct() { unsafe { GrB_DESC_T0 } } else { null() };
+        ok!(GrB_mxv(wc.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, c.0, w.0, d));
+        wc.wait();
+        wc
+    });
+    // checks (cheap, always on; untimed)
+    let diag = M::new(t_i32(), nc, nc);
+    ok!(GrB_Matrix_select_INT64(diag.0, null(), null(), GrB_DIAG, ac.0, 0, null()));
+    assert_eq!(diag.nvals(), 0, "CHECK FAILED: A_c has a diagonal");
+    assert_eq!(wc.sum(), w.sum(), "CHECK FAILED: vertex weight not conserved");
+    assert_eq!(c.nvals(), n_live, "CHECK FAILED: C must have one entry per live fine vertex");
+    LevelOut { c, ac, wc, rounds, twohop, pairs: matched / 2 }
+}
+
+/// mate is an involution; round pairs are adjacent; every pair is within the cap.
+fn check_matching(
+    a: &M,
+    w: &V,
+    cap: i32,
+    round_mate: &[u64],
+    mate: &[u64],
+) {
+    let wv = dense_i32(w);
+    for (i, &m) in mate.iter().enumerate() {
+        let m = m as usize;
+        assert_eq!(mate[m] as usize, i, "CHECK FAILED: mate is not an involution at {i}");
+        if m != i {
+            assert!(wv[i] as i64 + wv[m] as i64 <= cap as i64, "CHECK FAILED: cap");
+        }
+        if round_mate[i] as usize != i {
+            let mut x = 0i32;
+            let info = unsafe { GrB_Matrix_extractElement_INT32(&mut x, a.0, i as u64, round_mate[i]) };
+            assert_eq!(info, GrB_Info::GrB_SUCCESS, "CHECK FAILED: matched pair not adjacent");
+        }
+    }
+}
+
+/// Host CSR of the symmetric, loop-free, isolated-free skeleton.
+struct Csr {
+    n: usize,
+    p: Vec<u64>,
+    j: Vec<u64>,
+}
+fn load(path: &str) -> Csr {
+    let text = std::fs::read_to_string(path).unwrap();
+    let mut e: Vec<(u64, u64)> = Vec::new();
+    let mut n = 0u64;
+    for line in text.lines() {
+        if line.starts_with('#') {
+            continue;
+        }
+        let mut it = line.split_whitespace();
+        let u: u64 = it.next().unwrap().parse().unwrap();
+        let v: u64 = it.next().unwrap().parse().unwrap();
+        if u == v {
+            continue;
+        }
+        n = n.max(u + 1).max(v + 1);
+        e.push((u, v));
+        e.push((v, u));
+    }
+    e.sort_unstable();
+    e.dedup();
+    let mut map = vec![u64::MAX; n as usize];
+    let mut c = 0u64;
+    for &(u, _) in &e {
+        if map[u as usize] == u64::MAX {
+            map[u as usize] = c;
+            c += 1;
+        }
+    }
+    let nn = c as usize;
+    let mut p = vec![0u64; nn + 1];
+    let mut j = Vec::with_capacity(e.len());
+    // e sorted by u, and map is increasing in u, so rows come out in order.
+    for &(u, v) in &e {
+        p[map[u as usize] as usize + 1] += 1;
+        j.push(map[v as usize]);
+    }
+    for k in 0..nn {
+        p[k + 1] += p[k];
+    }
+    // columns within a row: map is monotone, so still sorted
+    Csr { n: nn, p, j }
+}
+fn to_grb(s: &Csr) -> M {
+    let mut ii = Vec::with_capacity(s.j.len());
+    for u in 0..s.n {
+        for _ in s.p[u]..s.p[u + 1] {
+            ii.push(u as u64);
+        }
+    }
+    let x = vec![1i32; s.j.len()];
+    let a = M::new(t_i32(), s.n as u64, s.n as u64);
+    ok!(GrB_Matrix_build_INT32(a.0, ii.as_ptr(), s.j.as_ptr(), x.as_ptr(), ii.len() as u64, null()));
+    a.wait();
+    a
+}
+
+fn feral_perm(s: &Csr) -> (Vec<i64>, f64) {
+    let xadj: Vec<i64> = s.p.iter().map(|&x| x as i64).collect();
+    let adj: Vec<i64> = s.j.iter().map(|&x| x as i64).collect();
+    let pat = feral_metis::CscPattern::new(s.n, &xadj, &adj).unwrap();
+    let t = Instant::now();
+    let perm = feral_metis::metis_order(&pat).unwrap();
+    (perm, t.elapsed().as_secs_f64())
+}
+
+/// (4) the split: A_next<A, struct> = M ANY_PAIR M', M(i, label(i)) = 1.
+fn split(
+    a: &M,
+    labels: &[u32],
+    cells: u64,
+    ops: &Ops,
+    t: &mut Timer,
+) -> M {
+    let n = a.nrows();
+    let lv = V::new(t_u64(), n);
+    let ii: Vec<u64> = (0..n).collect();
+    let lx: Vec<u64> = if brk("split") {
+        (0..n as usize).map(|i| labels[(i + 1) % n as usize] as u64).collect()
+    } else {
+        labels.iter().map(|&x| x as u64).collect()
+    };
+    ok!(GrB_Vector_build_UINT64(lv.0, ii.as_ptr(), lx.as_ptr(), n, null()));
+    let idx = index_vector(n);
+    let mm = t.time("split_buildM", || {
+        let mm = M::new(t_i32(), n, cells);
+        ok!(GxB_Matrix_build_Scalar_Vector(mm.0, idx.0, lv.0, ops.one_i32, null()));
+        mm.wait();
+        mm
+    });
+    t.time("split_mxm", || {
+        let an = M::new(t_i32(), n, n);
+        ok!(GrB_mxm(an.0, a.0, null(), GxB_ANY_PAIR_INT32, mm.0, mm.0, GrB_DESC_ST1));
+        an.wait();
+        an
+    })
+}
+fn host_split_count(
+    s: &Csr,
+    labels: &[u32],
+) -> u64 {
+    let mut c = 0;
+    for u in 0..s.n {
+        for &v in &s.j[s.p[u] as usize..s.p[u + 1] as usize] {
+            c += (labels[u] == labels[v as usize]) as u64;
+        }
+    }
+    c
+}
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+}
+
+/// Coarsen `a0` to <= stop vertices or < 5 % shrink, then project a random 2-way label back.
+/// Returns per-level timers (level 0 = finest), the fingerprint and the level-0 label.
+fn hierarchy(
+    a0: &M,
+    cap: i32,
+    stop: u64,
+    ops: &Ops,
+) -> (Vec<(u64, u64, u32, bool, Timer)>, Vec<(u64, u64, i64)>, Vec<u32>) {
+    hierarchy_keep(a0, None, cap, stop, ops, None)
+}
+
+/// The levels R built, handed to the reuse paths: (A_l or null for the input, w_l, C_l: l -> l+1), A_L, w_L.
+type Kept = (Vec<(M, V, M)>, Option<M>, V);
+
+fn hierarchy_keep(
+    a0: &M,
+    w_init: Option<V>,
+    cap: i32,
+    stop: u64,
+    ops: &Ops,
+    keep: Option<&mut Option<Kept>>,
+) -> (Vec<(u64, u64, u32, bool, Timer)>, Vec<(u64, u64, i64)>, Vec<u32>) {
+    let n0 = a0.nrows();
+    let w0 = w_init.unwrap_or_else(|| {
+        let w0 = V::new(t_i32(), n0);
+        ok!(GrB_Vector_assign_INT32(w0.0, null(), null(), 1, GrB_ALL, n0, null()));
+        w0
+    });
+    let mut levels: Vec<(M, V, M)> = Vec::new(); // (A_l, w_l, C_l)
+    let mut rows = Vec::new();
+    let mut fp = Vec::new();
+    let mut a = None::<M>;
+    let mut w = w0;
+    static CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let call = CALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let mut salt = if brk("salt") { 0x5EED_u64 + call } else { 0x5EED_u64 };
+    loop {
+        let cur: &M = a.as_ref().unwrap_or(a0);
+        let n = w.nvals(); // live vertices (all of them unless w_init leaves some out)
+        if n <= stop || rows.len() >= 200 {
+            break;
+        }
+        let mut t = Timer::default();
+        salt = salt.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) >> 1;
+        let out = coarsen_level(cur, &w, cap, salt & 0xFFFF_FFFF, ops, &mut t);
+        let nc = out.ac.nrows();
+        rows.push((n, cur.nvals(), out.rounds, out.twohop, t));
+        fp.push((nc, out.ac.nvals(), out.ac.sum()));
+        let _ = out.pairs;
+        let prev_a = a.take();
+        let prev_w = std::mem::replace(&mut w, out.wc);
+        // keep A_l (None for the input) and C_l for the projection
+        levels.push((prev_a.unwrap_or_else(|| M(null())), prev_w, out.c));
+        a = Some(out.ac);
+        if nc * 100 > 95 * n {
+            break;
+        }
+    }
+    // (3) projection: random labels on the coarsest level, then mxv(C', labels) per level.
+    let top = a.as_ref().map_or(n0, |m| m.nrows());
+    let mut rng = Rng(42);
+    let lab: Vec<i32> = (0..top).map(|_| (rng.next() & 1) as i32).collect();
+    let ii: Vec<u64> = (0..top).collect();
+    let mut lv = V::new(t_i32(), top);
+    ok!(GrB_Vector_build_INT32(lv.0, ii.as_ptr(), lab.as_ptr(), top, null()));
+    for (l, (al, _wl, cl)) in levels.iter().enumerate().rev() {
+        let nf = rows[l].0; // live vertices of the fine level
+        // its dimension (equal to nf unless some vertices are dead)
+        let nd = if ct() {
+            cl.nrows()
+        } else {
+            let mut c = 0;
+            ok!(GrB_Matrix_ncols(&mut c, cl.0));
+            c
+        };
+        let t = &mut rows[l].4;
+        let fine = t.time("project", || {
+            let f = V::new(t_i32(), nd);
+            let d = if ct() { null() } else { unsafe { GrB_DESC_T0 } };
+            ok!(GrB_mxv(f.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, cl.0, lv.0, d));
+            f.wait();
+            f
+        });
+        assert_eq!(fine.nvals(), nf, "CHECK FAILED: projection lost vertices");
+        let am = if al.0.is_null() { a0.0 } else { al.0 };
+        t.time("bnd", || {
+            let b = V::new(t_i32(), nd);
+            ok!(GrB_mxv(b.0, null(), null(), GxB_PLUS_SECOND_INT32, am, fine.0, null()));
+            b.wait();
+        });
+        lv = fine;
+    }
+    let (_, l0) = lv.i32s();
+    if let Some(k) = keep {
+        *k = Some((levels, a, w));
+    }
+    (rows, fp, l0.into_iter().map(|x| x as u32).collect())
+}
