+/// B1 = B2 on every level (n, nvals, pattern and values); B1 valid (no diagonal, symmetric,
+/// weight conserved, host weights = C'^T w).
+fn compare(
+    h1: &Hier,
+    h2: &Hier,
+    l0: &L0,
+    ck: &mut Checks,
+) {
+    if h1.levels.len() != h2.levels.len() {
+        ck.eq_fail += 1;
+    }
+    for (l, (x, y)) in h1.levels.iter().zip(&h2.levels).enumerate() {
+        ck.eq_levels += 1;
+        if x.n != y.n || x.a.nvals() != y.a.nvals() || x.w != y.w || tuples(&x.a) != tuples(&y.a) {
+            ck.eq_fail += 1;
+        }
+        ck.b1_checked += 1;
+        let diag = M::new(t_i32(), x.n, x.n);
+        ok!(GrB_Matrix_select_INT64(diag.0, null(), null(), GrB_DIAG, x.a.0, 0, null()));
+        let at = M::new(t_i32(), x.n, x.n);
+        ok!(GrB_transpose(at.0, null(), null(), x.a.0, null()));
+        let wsum: i64 = x.w.iter().map(|&v| v as i64).sum();
+        let (dg, sym) = (diag.nvals(), tuples(&at) == tuples(&x.a));
+        if dg != 0 || !sym || wsum != l0.live as i64 {
+            if ck.b1_invalid < 3 {
+                println!("B1INVALID level={} diag={dg} symmetric={sym} wsum={wsum} live={}", l + 1, l0.live);
+            }
+            ck.b1_invalid += 1;
+        }
+        let prev = view(h1, l0, l);
+        let ids: Vec<u64> = (0..prev.n).filter(|&i| prev.cell[i as usize] != SEP).collect();
+        let pw: Vec<i32> = ids.iter().map(|&i| prev.w[i as usize]).collect();
+        let wv = mxv_i32(&x.ct, &vec_i32(prev.n, &ids, &pw), true);
+        let gw = dense_i32(&wv);
+        let ok_w = (0..x.n as usize).all(|i| gw.get(i).copied().unwrap_or(0) == x.w[i]);
+        if !ok_w {
+            ck.w_fail += 1;
+        }
+    }
+}
+
+/// Accounting identity: the live coarse vertices of every B level equal the distinct
+/// (depth-0 coarse vertex, cell) pairs over live fine vertices.
+fn accounting(
+    h: &Hier,
+    l0: &L0,
+    root_cmaps: &[Vec<u32>],
+    ncells: u64,
+    ck: &mut Checks,
+) {
+    let mut anc: Vec<u32> = (0..l0.n as u32).collect();
+    for (l, lv) in h.levels.iter().enumerate() {
+        let cm = &root_cmaps[l];
+        let mut keys: Vec<u64> = Vec::with_capacity(l0.live as usize);
+        for v in 0..l0.n as usize {
+            if l0.cell[v] == SEP {
+                continue;
+            }
+            anc[v] = cm[anc[v] as usize];
+            keys.push(anc[v] as u64 * ncells + l0.cell[v] as u64);
+        }
+        keys.sort_unstable();
+        keys.dedup();
+        ck.acct_levels += 1;
+        if keys.len() as u64 != lv.live {
+            ck.acct_fail += 1;
+        }
+    }
+}
+
+/// Greedy boundary refinement of a 2-way label inside every cell (edge cut, 3 % balance).
+fn refine(
+    v: &View,
+    side: &mut [u8],
+    ncells: usize,
+) {
+    let (ii, jj, xx) = tuples(v.a);
+    let n = v.n as usize;
+    let mut rp = vec![0usize; n + 1];
+    for &i in &ii {
+        rp[i as usize + 1] += 1;
+    }
+    for k in 0..n {
+        rp[k + 1] += rp[k];
+    }
+    let mut sw = vec![[0i64; 2]; ncells];
+    for x in 0..n {
+        if v.cell[x] != SEP {
+            sw[v.cell[x] as usize][side[x] as usize] += v.w[x] as i64;
+        }
+    }
+    let lim: Vec<i64> = sw.iter().map(|s| ((s[0] + s[1]) as f64 * 0.5 * 1.03).ceil() as i64).collect();
+    for _pass in 0..4 {
+        let mut moved = 0;
+        for x in 0..n {
+            let c = v.cell[x];
+            if c == SEP {
+                continue;
+            }
+            let c = c as usize;
+            let s = side[x] as usize;
+            let (mut ext, mut int) = (0i64, 0i64);
+            for k in rp[x]..rp[x + 1] {
+                if side[jj[k] as usize] as usize == s {
+                    int += xx[k] as i64;
+                } else {
+                    ext += xx[k] as i64;
+                }
+            }
+            let wx = v.w[x] as i64;
+            if ext > int && sw[c][1 - s] + wx <= lim[c] {
+                side[x] = (1 - s) as u8;
+                sw[c][s] -= wx;
+                sw[c][1 - s] += wx;
+                moved += 1;
+            }
+        }
+        if moved == 0 {
+            break;
+        }
+    }
+}
+
+/// Real-ish cells for depth d+1: bisect each depth-d cell on its coarsest reused level by feral
+/// position (half the weight each side), project level by level with a boundary refinement at
+/// each, then take the smaller side's boundary at level 0 as the vertex separator.
+fn derive(
+    h: &Hier,
+    l0: &L0,
+    pos: &[u64],
+    ncells: usize,
+    ck: &mut Checks,
+    s: &Csr,
+    d: u32,
+) -> Vec<u32> {
+    let lr = h.levels.len();
+    // feral position of each coarse vertex's first member, per level
+    let mut mps: Vec<Vec<u64>> = vec![(0..l0.n as usize).map(|v| if l0.cell[v] != SEP { pos[v] } else { u64::MAX }).collect()];
+    for lv in &h.levels {
+        let prev = mps.last().unwrap();
+        let mut m2 = vec![u64::MAX; lv.n as usize];
+        for (x, &y) in lv.cmap.iter().enumerate() {
+            if y != NONE {
+                m2[y as usize] = m2[y as usize].min(prev[x]);
+            }
+        }
+        mps.push(m2);
+    }
+    // each cell is bisected at the deepest level where it still has >= 100 coarse vertices
+    let mut chosen = vec![0usize; ncells];
+    for lvl in 1..=lr {
+        let v = view(h, l0, lvl);
+        let mut cnt = vec![0u32; ncells];
+        for &c in v.cell {
+            if c != SEP {
+                cnt[c as usize] += 1;
+            }
+        }
+        for c in 0..ncells {
+            if cnt[c] >= 100 {
+                chosen[c] = lvl;
+            }
+        }
+    }
+    let mut side: Vec<u8> = Vec::new();
+    for lvl in (0..=lr).rev() {
+        let v = view(h, l0, lvl);
+        let mut sd = vec![0u8; v.n as usize];
+        if lvl < lr {
+            for (x, &y) in h.levels[lvl].cmap.iter().enumerate() {
+                if y != NONE {
+                    sd[x] = side[y as usize];
+                }
+            }
+        }
+        let mp = &mps[lvl];
+        let mut order: Vec<u32> = (0..v.n as u32).filter(|&x| v.cell[x as usize] != SEP && chosen[v.cell[x as usize] as usize] == lvl).collect();
+        if !order.is_empty() {
+            order.sort_unstable_by_key(|&x| (v.cell[x as usize], mp[x as usize], x));
+            let mut wc = vec![0i64; ncells];
+            for &x in &order {
+                wc[v.cell[x as usize] as usize] += v.w[x as usize] as i64;
+            }
+            let mut acc = vec![0i64; ncells];
+            for &x in &order {
+                let c = v.cell[x as usize] as usize;
+                sd[x as usize] = if acc[c] * 2 < wc[c] { 0 } else { 1 };
+                acc[c] += v.w[x as usize] as i64;
+            }
+        }
+        refine(&v, &mut sd, ncells);
+        side = sd;
+    }
+    // vertex separator: per cell, the boundary of the side with fewer boundary vertices
+    let n = l0.n as usize;
+    let mut bnd = vec![false; n];
+    let mut nb = vec![[0u64; 2]; ncells];
+    for v in 0..n {
+        let c = l0.cell[v];
+        if c == SEP {
+            continue;
+        }
+        for &u in &s.j[s.p[v] as usize..s.p[v + 1] as usize] {
+            let u = u as usize;
+            if l0.cell[u] == c && side[u] != side[v] {
+                bnd[v] = true;
+                nb[c as usize][side[v] as usize] += 1;
+                break;
+            }
+        }
+    }
+    let nosep = brk("nosep");
+    let mut out = vec![SEP; n];
+    let mut nsep = 0u64;
+    let mut cw = vec![0u64; 2 * ncells];
+    for v in 0..n {
+        let c = l0.cell[v];
+        if c == SEP {
+            continue;
+        }
+        let ss = if nb[c as usize][0] <= nb[c as usize][1] { 0 } else { 1 };
+        if bnd[v] && side[v] == ss && !(nosep && c == 0) {
+            nsep += 1;
+            continue;
+        }
+        out[v] = 2 * c + side[v] as u32;
+        cw[out[v] as usize] += 1;
+    }
+    // check: no edge joins two different live cells
+    let mut bad = 0u64;
+    for v in 0..n {
+        if out[v] == SEP {
+            continue;
+        }
+        for &u in &s.j[s.p[v] as usize..s.p[v + 1] as usize] {
+            let cu = out[u as usize];
+            if cu != SEP && cu != out[v] {
+                bad += 1;
+            }
+        }
+    }
+    ck.sep_checked += 1;
+    if bad > 0 {
+        ck.sep_fail += 1;
+    }
+    let nz: Vec<u64> = cw.iter().copied().filter(|&x| x > 0).collect();
+    println!(
+        "LABELS depth={} cells={} nonempty={} sep={nsep} live={} min_cell={} max_cell={} sep_violations={bad}",
+        d + 1,
+        2 * ncells,
+        nz.len(),
+        out.iter().filter(|&&c| c != SEP).count(),
+        nz.iter().min().copied().unwrap_or(0),
+        nz.iter().max().copied().unwrap_or(0)
+    );
+    out
+}
+
+/// The depth split of design §3 step 6 for labels with separators (no row for SEP).
+fn split2(
+    a0: &M,
+    labels: &[u32],
+    cells: u64,
+    ops: &Ops,
+    t: &mut Timer,
+) -> M {
+    let n = a0.nrows() as usize;
+    let shift = brk("split");
+    let mut ii = Vec::with_capacity(n);
+    let mut jj = Vec::with_capacity(n);
+    for v in 0..n {
+        let c = if shift { labels[(v + 1) % n] } else { labels[v] };
+        if c != SEP {
+            ii.push(v as u64);
+            jj.push(c as u64);
+        }
+    }
+    let mm = t.time("split_buildM", || {
+        let mm = M::new(t_i32(), n as u64, cells);
+        ok!(GxB_Matrix_build_Scalar(mm.0, ii.as_ptr(), jj.as_ptr(), ops.one_i32, ii.len() as u64));
+        mm.wait();
+        mm
+    });
+    t.time("split_mxm", || {
+        let an = M::new(t_i32(), n as u64, n as u64);
+        ok!(GrB_mxm(an.0, a0.0, null(), GxB_ANY_PAIR_INT32, mm.0, mm.0, GrB_DESC_ST1));
+        an.wait();
+        an
+    })
+}
+fn split_count(
+    s: &Csr,
+    labels: &[u32],
+) -> u64 {
+    let mut c = 0;
+    for u in 0..s.n {
+        for &v in &s.j[s.p[u] as usize..s.p[u + 1] as usize] {
+            c += (labels[u] != SEP && labels[u] == labels[v as usize]) as u64;
+        }
+    }
+    c
+}
