+                accounting(&hd, &l0, &root_cmaps, cells as u64, &mut ck);
+                println!(
+                    "PREP depth={d} live={live} split_nnz={} levels={} coarsest={} rss_mb={}",
+                    ad.nvals(),
+                    hd.levels.len(),
+                    hd.levels.last().map_or(live, |l| l.live),
+                    rss_mb()
+                );
+                next = if real && d < max_depth { Some(derive(&hd, &l0, &pos, cells, &mut ck, &s, d)) } else { None };
+                parent = hd;
+            }
+            if let Some(nx) = next {
+                labels.push(nx);
+            }
+            flush();
+        }
+    }
+    println!("PREP done {:.1}s rss_mb={}", tp.elapsed().as_secs_f64(), rss_mb());
+    println!("CHECKS-PREP {ck:?}");
+    flush();
+
+    // ---- timed runs ----
+    let mut fps: BTreeMap<(&'static str, u32), Vec<(u64, u64, i64)>> = BTreeMap::new();
+    let mut fpc = |ck: &mut Checks, key: (&'static str, u32), fp: Vec<(u64, u64, i64)>| match fps.get(&key) {
+        Some(f) => {
+            ck.fp_compared += 1;
+            if f != &fp {
+                ck.fp_fail += 1;
+            }
+        }
+        None => {
+            fps.insert(key, fp);
+        }
+    };
+    for &th in &threads {
+        set_nthreads(th);
+        for run in 0..runs {
+            let check = check_all || run == 0;
+            println!("LOAD threads={th} run={run} {}", sh("uptime"));
+            flush();
+            let wall = Instant::now();
+            // depth 0: R, shared by all variants
+            let mut kept = None;
+            let (rows, fp, _) = hierarchy_keep(&a0, None, cap_of(0), stop_of(0), &ops, Some(&mut kept));
+            print_rows(th, run, 0, &rows);
+            let r0 = rows_timer(&rows);
+            fpc(&mut ck, ("R", 0), fp);
+            let mut troot = Timer::default();
+            let h0 = root_hier(kept.unwrap(), n, &mut troot);
+            println!(
+                "VAR threads={th} run={run} depth=0 var=R levels={} reused=0 fresh={} coarsened={} calls={:.6} split=0 {}",
+                rows.len(),
+                rows.len(),
+                rows.iter().map(|r| r.0).sum::<u64>(),
+                tsum(&r0),
+                calls_str(&r0)
+            );
+            println!("VAR threads={th} run={run} depth=0 var=ROOTMAP calls={:.6} split=0", tsum(&troot));
+            let mut h0 = Some(h0);
+            let (mut pb1, mut pb2, mut pcs): (Option<Hier>, Option<Hier>, Option<Hier>) = (None, None, None);
+            for d in 1..=max_depth {
+                let cells = 1usize << d;
+                let lab = &labels[d as usize];
+                let wd: Vec<i32> = lab.iter().map(|&c| (c != SEP) as i32).collect();
+                let live = wd.iter().filter(|&&x| x > 0).count() as u64;
+                let mut tsplit = Timer::default();
+                let ad = split2(&a0, lab, cells as u64, &ops, &mut tsplit);
+                if check && ad.nvals() != split_count(&s, lab) {
+                    ck.split_fail += 1;
+                }
+                let split = tsum(&tsplit);
+                let l0 = L0 { a: &ad, n, cell: lab, w: &wd, live };
+                // R
+                let (rows, fp, _) = hierarchy_keep(&ad, ones_vec(n, lab), cap_of(d), stop_of(d), &ops, None);
+                print_rows(th, run, d, &rows);
+                let rt = rows_timer(&rows);
+                println!(
+                    "VAR threads={th} run={run} depth={d} var=R levels={} reused=0 fresh={} coarsened={} coarsest={} calls={:.6} split={split:.6} {}",
+                    rows.len(),
+                    rows.len(),
+                    rows.iter().map(|r| r.0).sum::<u64>(),
+                    fp.last().map_or(live, |x| x.0),
+                    tsum(&rt),
+                    calls_str(&rt)
+                );
+                fpc(&mut ck, ("R", d), fp);
+                // B1, B2: never match
+                let mc0 = MATCH_CALLS.load(Relaxed);
+                let mut tb1 = Timer::default();
+                let hb1 = build_reuse(Mode::B1, pb1.as_ref().or(h0.as_ref()).unwrap(), &l0, cells, stop_of(d), &ops, &mut tb1, None, d);
+                project_b(&hb1, &l0, &mut tb1);
+                let mut tb2 = Timer::default();
+                let hb2 = build_reuse(Mode::B2, pb2.as_ref().or(h0.as_ref()).unwrap(), &l0, cells, stop_of(d), &ops, &mut tb2, None, d);
+                if brk("rematch") && d >= 3 {
+                    let _ = hierarchy(&ad, cap_of(d), stop_of(d), &ops);
+                }
+                project_b(&hb2, &l0, &mut tb2);
+                ck.match_calls_b += MATCH_CALLS.load(Relaxed) - mc0;
+                for (name, h, tt) in [("B1", &hb1, &tb1), ("B2", &hb2, &tb2)] {
+                    println!(
+                        "VAR threads={th} run={run} depth={d} var={name} levels={} reused={} fresh=0 coarsened=0 coarsest={} calls={:.6} split={split:.6} {}",
+                        h.levels.len(),
+                        h.levels.len(),
+                        h.levels.last().map_or(live, |l| l.live),
+                        tsum(tt),
+                        calls_str(tt)
+                    );
+                }
+                if check {
+                    compare(&hb1, &hb2, &l0, &mut ck);
+                }
+                fpc(&mut ck, ("B1", d), hier_fp(&hb1));
+                fpc(&mut ck, ("B2", d), hier_fp(&hb2));
+                // capstop
+                let mut tcs = Timer::default();
+                let cs = build_capstop(pcs.as_ref().or(h0.as_ref()).unwrap(), &l0, cells, cap_of(d), &ops, &mut tcs, &mut ck, check);
+                let fr = rows_timer(&cs.fresh_rows);
+                let mut tall = Timer::default();
+                merge(&mut tall, &tcs);
+                merge(&mut tall, &fr);
+                println!(
+                    "VAR threads={th} run={run} depth={d} var=CS levels={} reused={} fresh={} coarsened={} coarsest={} calls={:.6} split={split:.6} cells_fresh={} cells_plim={} g_n={} stops={} {}",
+                    cs.h.levels.len() + cs.fresh_rows.len(),
+                    cs.h.levels.len(),
+                    cs.fresh_rows.len(),
+                    cs.fresh_rows.iter().map(|r| r.0).sum::<u64>(),
+                    cs.fresh_fp.last().map_or(cs.g_n, |x| x.0),
+                    tsum(&tall),
+                    cs.cells_fresh,
+                    cs.cells_plim,
+                    cs.g_n,
+                    cs.stops.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(","),
+                    calls_str(&tall)
+                );
+                let mut fpcs = hier_fp(&cs.h);
+                fpcs.push((u64::MAX, cs.g_n, 0));
+                fpcs.extend(cs.fresh_fp.iter().copied());
+                fpc(&mut ck, ("CS", d), fpcs);
+                drop(l0);
+                pb1 = Some(hb1);
+                pb2 = Some(hb2);
+                pcs = Some(cs.h);
+                h0 = None;
+                flush();
+            }
+            println!("RUN threads={th} run={run} wall={:.2}s rss_mb={}", wall.elapsed().as_secs_f64(), rss_mb());
+            flush();
+        }
+    }
+    println!("CHECKS {ck:?}");
+    flush();
+    assert_eq!(ck.split_fail, 0, "CHECK FAILED: split pattern");
+    assert_eq!(ck.eq_fail, 0, "CHECK FAILED: B1 != B2");
+    assert_eq!(ck.b1_invalid, 0, "CHECK FAILED: B1 level invalid");
+    assert_eq!(ck.w_fail, 0, "CHECK FAILED: host weights != C'^T w");
+    assert_eq!(ck.acct_fail, 0, "CHECK FAILED: accounting identity");
+    assert_eq!(ck.match_calls_b, 0, "CHECK FAILED: B1/B2 ran a matching");
+    assert_eq!(ck.cs_cap_fail, 0, "CHECK FAILED: capstop reused a level over the cap");
+    assert_eq!(ck.cs_w_fail, 0, "CHECK FAILED: capstop weight not conserved");
+    assert_eq!(ck.sep_fail, 0, "CHECK FAILED: separator does not separate");
+    assert_eq!(ck.fp_fail, 0, "CHECK FAILED: hierarchy differs across runs/threads");
+}
