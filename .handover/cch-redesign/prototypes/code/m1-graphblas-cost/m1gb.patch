+macro_rules! ok {
+    ($e:expr) => {{
+        #[allow(unused_unsafe)]
+        let info = unsafe { $e };
+        assert_eq!(info, GrB_Info::GrB_SUCCESS, "GraphBLAS: {}", stringify!($e));
+    }};
+}
