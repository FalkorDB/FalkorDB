+/// (instructions, cycles) of this process so far: RUSAGE_INFO_V4 ri_instructions / ri_cycles.
+fn instr() -> (u64, u64) {
+    let mut b = [0u64; 48];
+    let rc = unsafe { proc_pid_rusage(getpid(), 4, b.as_mut_ptr() as *mut c_void) };
+    assert_eq!(rc, 0, "proc_pid_rusage");
+    (b[31], b[32])
