+// ---- user operators ----
+fn fmix32(mut h: u32) -> u32 {
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x85eb_ca6b);
+    h ^= h >> 13;
+    h = h.wrapping_mul(0xc2b2_ae35);
+    h ^= h >> 16;
+    h
+}
+fn unfmix32(mut h: u32) -> u32 {
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x7ed1_b41d);
+    h ^= (h >> 13) ^ (h >> 26);
+    h = h.wrapping_mul(0xa5cb_9243);
+    h ^= h >> 16;
+    h
+}
+/// K(i,j) = (A(i,j) << 32) | fmix32(j ^ salt): unique per row, so MAX is deterministic.
+unsafe extern "C" fn key_op(
+    z: *mut c_void,
+    x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    y: *const c_void,
+) {
+    unsafe {
+        let w = *(x as *const i32) as u32 as u64;
+        let salt = *(y as *const u64) as u32;
+        *(z as *mut u64) = (w << 32) | fmix32((j as u32) ^ salt) as u64;
+    }
+}
+/// The column a key was made from.
+unsafe extern "C" fn unkey_op(
+    z: *mut c_void,
+    x: *const c_void,
+    _i: GrB_Index,
+    _j: GrB_Index,
+    y: *const c_void,
+) {
+    unsafe {
+        let k = *(x as *const u64);
+        let salt = *(y as *const u64) as u32;
+        *(z as *mut u64) = (unfmix32(k as u32) ^ salt) as u64;
+    }
+}
+unsafe extern "C" fn even_op(
+    z: *mut c_void,
+    _x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    _y: *const c_void,
+) {
+    unsafe { *(z as *mut bool) = j & 1 == 0 };
+}
+unsafe extern "C" fn odd_op(
+    z: *mut c_void,
+    _x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    _y: *const c_void,
+) {
+    unsafe { *(z as *mut bool) = j & 1 == 1 };
+}
+
+pub(super) struct Ops {
+    key: GrB_IndexUnaryOp,
+    unkey: GrB_IndexUnaryOp,
+    even: GrB_IndexUnaryOp,
+    odd: GrB_IndexUnaryOp,
+    pub one_i32: GrB_Scalar,
+}
+impl Ops {
+    pub fn new() -> Ops {
+        let mut key = null();
+        let mut unkey = null();
+        let mut even = null();
+        let mut odd = null();
+        ok!(GrB_IndexUnaryOp_new(&mut key, Some(key_op), t_u64(), t_i32(), t_u64()));
+        ok!(GrB_IndexUnaryOp_new(&mut unkey, Some(unkey_op), t_u64(), t_u64(), t_u64()));
+        ok!(GrB_IndexUnaryOp_new(&mut even, Some(even_op), t_bool(), t_i64(), t_i64()));
+        ok!(GrB_IndexUnaryOp_new(&mut odd, Some(odd_op), t_bool(), t_i64(), t_i64()));
+        let mut one_i32 = null();
+        ok!(GrB_Scalar_new(&mut one_i32, t_i32()));
+        ok!(GrB_Scalar_setElement_INT32(one_i32, 1));
+        Ops { key, unkey, even, odd, one_i32 }
+    }
+}
+
+/// Seconds per named call, summed; .1 holds (instructions, cycles) per call name.
+#[derive(Default, Clone)]
+pub(super) struct Timer(pub BTreeMap<&'static str, f64>, pub BTreeMap<&'static str, (u64, u64)>);
+impl Timer {
+    fn time<R>(
+        &mut self,
+        name: &'static str,
+        f: impl FnOnce() -> R,
+    ) -> R {
+        if burble() {
+            println!("@@CALL {name}");
+            flush();
+        }
+        let i0 = instr();
+        let t = Instant::now();
+        let r = f();
+        let el = t.elapsed().as_secs_f64();
+        let i1 = instr();
+        *self.0.entry(name).or_default() += el;
+        let e = self.1.entry(name).or_default();
+        e.0 += i1.0 - i0.0;
+        e.1 += i1.1 - i0.1;
+        if burble() {
+            println!("@@END {name} {el:.6}");
+            flush();
+        }
+        r
+    }
+    fn add(
+        &mut self,
+        b: &Timer,
+    ) {
+        for (k, v) in &b.0 {
+            *self.0.entry(*k).or_default() += v;
+        }
+        for (k, v) in &b.1 {
+            let e = self.1.entry(*k).or_default();
+            e.0 += v.0;
+            e.1 += v.1;
+        }
+    }
+    fn wall(&self) -> f64 {
+        self.0.values().sum()
+    }
+    fn instr(&self) -> (u64, u64) {
+        self.1.values().fold((0, 0), |a, b| (a.0 + b.0, a.1 + b.1))
+    }
+}
+
+// ---- equality hash (check run only) ----
+thread_local! {
+    static HASH: std::cell::RefCell<Option<(u64, u64)>> = const { std::cell::RefCell::new(None) };
+}
+fn hmix(
+    h: u64,
+    x: u64,
+) -> u64 {
+    let mut z = (h ^ x).wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
+fn hash_on() -> bool {
+    HASH.with(|h| h.borrow().is_some())
+}
+fn hash_begin() {
+    HASH.with(|h| *h.borrow_mut() = Some((0x1234_5678, 0)));
+}
+/// (hash, number of items fed)
+fn hash_end() -> (u64, u64) {
+    HASH.with(|h| h.borrow_mut().take().unwrap_or((0, 0)))
+}
+fn hash_u64s(xs: impl IntoIterator<Item = u64>) {
+    HASH.with(|h| {
+        if let Some((s, c)) = h.borrow_mut().as_mut() {
+            let mut n = 0u64;
+            for x in xs {
+                *s = hmix(*s, x);
+                n += 1;
+            }
+            *s = hmix(*s, 0xFEED ^ n);
+            *c += 1;
+        }
+    });
+}
+fn hash_mat(m: &M) {
+    if !hash_on() {
+        return;
+    }
+    m.wait();
+    let mut n = m.nvals();
+    let mut i = vec![0u64; n as usize];
+    let mut j = vec![0u64; n as usize];
+    let mut x = vec![0i32; n as usize];
+    ok!(GrB_Matrix_extractTuples_INT32(i.as_mut_ptr(), j.as_mut_ptr(), x.as_mut_ptr(), &mut n, m.0));
+    let mut nc = 0;
+    ok!(GrB_Matrix_ncols(&mut nc, m.0));
+    hash_u64s([m.nrows(), nc]);
+    hash_u64s(i.iter().zip(&j).zip(&x).map(|((&a, &b), &c)| (a << 32 | b) ^ ((c as u32 as u64) << 17).rotate_left(29)));
+}
+fn hash_vec_i32(v: &V) {
+    if !hash_on() {
+        return;
+    }
+    v.wait();
+    let (i, x) = v.i32s();
+    hash_u64s([v.size()]);
+    hash_u64s(i.iter().zip(&x).map(|(&a, &b)| a << 32 | b as u32 as u64));
+}
+fn hash_u32s(xs: &[u32]) {
+    if hash_on() {
+        hash_u64s(xs.iter().map(|&x| x as u64));
+    }
+}
+fn hash_i32s(xs: &[i32]) {
+    if hash_on() {
+        hash_u64s(xs.iter().map(|&x| x as u32 as u64));
+    }
+}
+
+/// w as a dense host array indexed by vertex (0 where w has no entry).
+fn dense_i32(w: &V) -> Vec<i32> {
+    let (wi, wx) = w.i32s();
+    let n = w.size();
+    if wi.len() as u64 == n {
+        return wx;
+    }
+    let mut d = vec![0i32; n as usize];
+    for (i, x) in wi.into_iter().zip(wx) {
+        d[i as usize] = x;
+    }
+    d
+}
+
+/// Full UINT64 vector idx(i) = i.
+fn index_vector(n: u64) -> V {
+    let idx = V::new(t_u64(), n);
+    ok!(GrB_Vector_assign_UINT64(idx.0, null(), null(), 0, GrB_ALL, n, null()));
+    ok!(GrB_Vector_apply_IndexOp_INT64(idx.0, null(), null(), GrB_ROWINDEX_INT64, idx.0, 0, null()));
+    idx.wait();
+    idx
+}
+
+pub(super) struct LevelOut {
+    /// C' (n x nc): the projection map.
+    pub c: M,
+    pub ac: M,
+    pub wc: V,
+    /// host w_c (cpack only)
+    pub wc_host: Option<Vec<i32>>,
+    /// fine -> coarse id, NONE for dead (cpack only)
+    pub ca: Option<Vec<u32>>,
+    pub rounds: u32,
+    pub twohop: bool,
+    pub pairs: u64,
+}
+
+/// Number of coarsen_level calls (matching runs) so far; B1/B2 must never add to it.
+pub(super) static MATCH_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+/// Read a full UINT64 vector's values on the host (O(1) unload, copied out, reloaded).
+fn read_full_u64(v: &V) -> Vec<u64> {
+    let mut x: *mut c_void = null();
+    let (mut t, mut n, mut sz, mut h) = (null(), 0u64, 0u64, 0i32);
+    let info = unsafe { GxB_Vector_unload(v.0, &mut x, &mut t, &mut n, &mut sz, &mut h, null()) };
+    if info != GrB_Info::GrB_SUCCESS {
+        SLOW_BORROW.fetch_add(1, Relaxed);
+        return v.u64s().1;
+    }
+    assert!(t == t_u64());
+    let out = unsafe { std::slice::from_raw_parts(x as *const u64, n as usize) }.to_vec();
+    ok!(GxB_Vector_load(v.0, &mut x, t, n, sz, h, null()));
+    out
+}
+
+/// One coarsening level, steps (1)-(2) of design §3, every call timed.
+/// `w_host`: the same weights as `w` on the host (dense, 0 = dead), used by the cpack/hcon paths.
+pub(super) fn coarsen_level(
+    a: &M,
+    w: &V,
+    w_host: Option<&[i32]>,
+    cap: i32,
+    salt: u64,
+    ops: &Ops,
+    t: &mut Timer,
+) -> LevelOut {
+    MATCH_CALLS.fetch_add(1, Relaxed);
+    let n = a.nrows();
+    let n_live = w.nvals();
+    let partial = n_live != n;
+    // (1a) cap mask: S(i,j) = w(i)+w(j) on A's pattern, keep <= cap. Skipped when no pair can exceed it.
+    let mut maxw = 0i32;
+    ok!(GrB_Vector_reduce_INT32(&mut maxw, null(), GrB_MAX_MONOID_INT32, w.0, null()));
+    let hkey = opt("hkey") && w_host.is_some();
+    let mcap = if 2 * maxw as i64 > cap as i64 && !hkey {
+        Some(t.time("cap", || {
+            let mut d = null();
+            ok!(GrB_Matrix_diag(&mut d, w.0, 0));
+            let d = M(d);
+            let s = M::new(t_i32(), n, n);
+            if opt("caprc") {
+                // s = D A (row scale: w(i)), then s = s D (column scale: + w(j))
+                ok!(GrB_mxm(s.0, null(), null(), GxB_PLUS_FIRST_INT32, d.0, a.0, null()));
+                let sr = unsafe { if obrk("caprc") { GxB_PLUS_FIRST_INT32 } else { GxB_PLUS_PLUS_INT32 } };
+                ok!(GrB_mxm(s.0, null(), null(), sr, s.0, d.0, null()));
+            } else {
+                let left = M::new(t_i32(), n, n);
+                ok!(GrB_mxm(left.0, null(), null(), GxB_PLUS_FIRST_INT32, d.0, a.0, null()));
+                let right = M::new(t_i32(), n, n);
+                ok!(GrB_mxm(right.0, null(), null(), GxB_PLUS_SECOND_INT32, a.0, d.0, null()));
+                ok!(GrB_Matrix_eWiseMult_BinaryOp(s.0, null(), null(), GrB_PLUS_INT32, left.0, right.0, null()));
+            }
+            ok!(GrB_Matrix_select_INT32(s.0, null(), null(), GrB_VALUELE_INT32, s.0, cap, null()));
+            w8m(&s);
+            s
+        }))
+    } else {
+        None
+    };
+    // (1b) keys by a user positional op.
+    let k = t.time("key", || {
+        if hkey {
+            return host_keys(a, w_host.unwrap(), cap, 2 * maxw as i64 > cap as i64, salt);
+        }
+        let k = M::new(t_u64(), n, n);
+        let mask = mcap.as_ref().map_or(null(), |m| m.0);
+        let desc = if mcap.is_some() { unsafe { GrB_DESC_S } } else { null() };
+        ok!(GrB_Matrix_apply_IndexOp_UINT64(k.0, mask, null(), ops.key, a.0, salt, desc));
+        w8m(&k);
+        k
+    });
+    drop(mcap);
+    let usel = opt("usel");
+    let zmatch = opt("zmatch") && !brk("nomutual");
+    let idx = t.time("idx", || index_vector(n));
+    let mut mate: Option<V> = if zmatch { None } else { Some(t.time("idx", || idx.dup())) };
+    let mut z: Option<V> = if zmatch { Some(t.time("idx", || idx.dup())) } else { None };
+    // u: the unmatched proposers (round 1: every live vertex)
+    let mut u_own: Option<V> = if partial {
+        Some(t.time("idx", || {
+            let u = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(u.0, w.0, null(), GrB_IDENTITY_UINT64, idx.0, GrB_DESC_S));
+            w8v(&u);
+            u
+        }))
+    } else if usel {
+        None // idx itself
+    } else {
+        Some(t.time("idx", || idx.dup()))
+    };
+    // (1c) rounds of mutual-max proposals until a round matches nothing.
+    let mut rounds = 0;
+    let mut matched = 0u64;
+    loop {
+        rounds += 1;
+        let u = u_own.as_ref().unwrap_or(&idx);
+        let y = V::new(t_u64(), n);
+        t.time("mxv", || {
+            ok!(GrB_mxv(y.0, u.0, null(), GxB_MAX_FIRST_UINT64, k.0, u.0, GrB_DESC_RS));
+            w8v(&y);
+        });
+        let np = y.nvals();
+        if burble() {
+            println!("@@NP round={rounds} n={n} proposers={np}");
+        }
+        if np == 0 {
+            break;
+        }
+        t.time("m_unkey", || {
+            ok!(GrB_Vector_apply_IndexOp_UINT64(y.0, null(), null(), ops.unkey, y.0, salt, null()));
+            w8v(&y);
+        });
+        let m = V::new(t_bool(), n);
+        if brk("nomutual") {
+            ok!(GrB_Vector_assign_BOOL(m.0, y.0, null(), true, GrB_ALL, n, GrB_DESC_S));
+        } else if let Some(zv) = z.as_mut() {
+            let z2 = t.time("z_add", || {
+                let z2 = V::new(t_u64(), n);
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(z2.0, null(), null(), GrB_SECOND_UINT64, zv.0, y.0, null()));
+                w8v(&z2);
+                z2
+            });
+            *zv = z2;
+            let q = t.time("m_extract", || {
+                let q = V::new(t_u64(), n);
+                ok!(GxB_Vector_extract_Vector(q.0, null(), null(), zv.0, zv.0, null()));
+                w8v(&q);
+                q
+            });
+            t.time("m_eq", || {
+                ok!(GrB_Vector_eWiseMult_BinaryOp(m.0, y.0, null(), GrB_EQ_UINT64, q.0, idx.0, GrB_DESC_RS));
+                w8v(&m);
+            });
+        } else {
+            let pf = t.time("m_full", || {
+                let pf = V::new(t_u64(), n);
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(pf.0, null(), null(), GrB_SECOND_UINT64, idx.0, y.0, null()));
+                w8v(&pf);
+                pf
+            });
+            let q = t.time("m_extract", || {
+                let q = V::new(t_u64(), n);
+                ok!(GxB_Vector_extract_Vector(q.0, null(), null(), pf.0, pf.0, null()));
+                w8v(&q);
+                q
+            });
+            t.time("m_eq", || {
+                ok!(GrB_Vector_eWiseMult_BinaryOp(m.0, y.0, null(), GrB_EQ_UINT64, q.0, idx.0, GrB_DESC_RS));
+                w8v(&m);
+            });
+        }
+        if let Some(mt) = mate.as_ref() {
+            t.time("m_assign", || {
+                ok!(GrB_Vector_assign(mt.0, m.0, null(), y.0, GrB_ALL, n, null()));
+                w8v(mt);
+            });
+        }
+        let u2 = if usel {
+            t.time("m_unext", || {
+                let u2 = V::new(t_bool(), n);
+                ok!(GrB_Vector_select_BOOL(u2.0, null(), null(), GrB_VALUEEQ_BOOL, m.0, obrk("usel"), null()));
+                w8v(&u2);
+                u2
+            })
+        } else {
+            t.time("m_unext", || {
+                let u2 = V::new(t_u64(), n);
+                ok!(GrB_Vector_apply(u2.0, m.0, null(), GrB_IDENTITY_UINT64, y.0, GrB_DESC_RC));
+                w8v(&u2);
+                u2
+            })
+        };
+        let newly = np.saturating_sub(u2.nvals());
+        u_own = Some(u2);
+        matched += newly;
+        if newly == 0 {
+            break;
+        }
+    }
+    drop(u_own);
+    if let Some(zv) = z.take() {
+        // stale proposals (proposed, never matched) go back to self: mate = Z except where Z(Z) != idx
+        let m2 = t.time("z_final", || {
+            let qz = V::new(t_u64(), n);
+            ok!(GxB_Vector_extract_Vector(qz.0, null(), null(), zv.0, zv.0, null()));
+            let eq = V::new(t_bool(), n);
+            ok!(GrB_Vector_eWiseMult_BinaryOp(eq.0, null(), null(), GrB_EQ_UINT64, qz.0, idx.0, null()));
+            let st = V::new(t_bool(), n);
+            ok!(GrB_Vector_select_BOOL(st.0, null(), null(), GrB_VALUEEQ_BOOL, eq.0, false, null()));
+            let m2 = V::new(t_u64(), n);
+            if obrk("zmatch") {
+                ok!(GrB_Vector_apply(m2.0, null(), null(), GrB_IDENTITY_UINT64, zv.0, null()));
+            } else {
+                let si = V::new(t_u64(), n);
+                ok!(GrB_Vector_apply_IndexOp_UINT64(si.0, null(), null(), GrB_ROWINDEX_INT64, st.0, 0, null()));
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(m2.0, null(), null(), GrB_SECOND_UINT64, zv.0, si.0, null()));
+            }
+            w8v(&m2);
+            m2
+        });
+        mate = Some(m2);
+    }
+    let mate = mate.unwrap();
+    let round_mate = if verify() { Some(mate.u64s().1) } else { None };
+    // (1d) 2-hop pass when the matching shrinks the level by under 15 %.
+    let mut twohop = false;
+    if (matched / 2) * 100 < 15 * n_live {
+        twohop = true;
+        let pairs = t.time("twohop", || {
+            let um = V::new(t_bool(), n);
+            ok!(GrB_Vector_eWiseMult_BinaryOp(um.0, null(), null(), GrB_EQ_UINT64, mate.0, idx.0, null()));
+            let anchor = V::new(t_u64(), n);
+            ok!(GrB_mxv(anchor.0, um.0, null(), GxB_MAX_FIRST_UINT64, k.0, idx.0, GrB_DESC_R));
+            ok!(GrB_Vector_apply_IndexOp_UINT64(anchor.0, null(), null(), ops.unkey, anchor.0, salt, null()));
+            let jv = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(jv.0, anchor.0, null(), GrB_IDENTITY_UINT64, idx.0, GrB_DESC_RS));
+            let g = M::new(t_u64(), n, n);
+            ok!(GxB_Matrix_build_Vector(g.0, anchor.0, jv.0, jv.0, null(), null()));
+            let p = M::new(t_i64(), n, n);
+            ok!(GxB_Matrix_sort(null(), p.0, GrB_LT_UINT64, g.0, null()));
+            let e = M::new(t_i64(), n, n);
+            ok!(GrB_Matrix_select_INT64(e.0, null(), null(), ops.even, p.0, 0, null()));
+            let o = M::new(t_i64(), n, n);
+            ok!(GrB_Matrix_select_INT64(o.0, null(), null(), ops.odd, p.0, 0, null()));
+            let e2 = M::new(t_i64(), n, n - 1);
+            let lo = [0u64, n - 2];
+            ok!(GrB_Matrix_extract(e2.0, null(), null(), e.0, GrB_ALL, n, lo.as_ptr(), GxB_RANGE, null()));
+            let o2 = M::new(t_i64(), n, n - 1);
+            let hi = [1u64, n - 1];
+            ok!(GrB_Matrix_extract(o2.0, null(), null(), o.0, GrB_ALL, n, hi.as_ptr(), GxB_RANGE, null()));
+            let pe = M::new(t_i64(), n, n - 1);
+            ok!(GrB_Matrix_eWiseMult_BinaryOp(pe.0, null(), null(), GrB_FIRST_INT64, e2.0, o2.0, null()));
+            let po = M::new(t_i64(), n, n - 1);
+            ok!(GrB_Matrix_eWiseMult_BinaryOp(po.0, null(), null(), GrB_SECOND_INT64, e2.0, o2.0, null()));
+            let mut np = pe.nvals();
+            let mut xe = vec![0i64; np as usize];
+            let mut xo = vec![0i64; np as usize];
+            ok!(GrB_Matrix_extractTuples_INT64(null(), null(), xe.as_mut_ptr(), &mut np, pe.0));
+            ok!(GrB_Matrix_extractTuples_INT64(null(), null(), xo.as_mut_ptr(), &mut np, po.0));
+            // host: cap check, then both directions into mate
+            let wd;
+            let wv: &[i32] = match w_host.filter(|_| opt("cpack")) {
+                Some(h) => h,
+                None => {
+                    wd = dense_i32(w);
+                    &wd
+                }
+            };
+            let mut bi = Vec::with_capacity(2 * xe.len());
+            let mut bx = Vec::with_capacity(2 * xe.len());
+            for (&x, &y) in xe.iter().zip(&xo) {
+                if (wv[x as usize] as i64 + wv[y as usize] as i64) <= cap as i64 {
+                    bi.push(x as u64);
+                    bx.push(y as u64);
+                    bi.push(y as u64);
+                    bx.push(x as u64);
+                }
+            }
+            let tmp = V::new(t_u64(), n);
+            ok!(GrB_Vector_build_UINT64(tmp.0, bi.as_ptr(), bx.as_ptr(), bi.len() as u64, null()));
+            ok!(GrB_Vector_assign(mate.0, tmp.0, null(), tmp.0, GrB_ALL, n, GrB_DESC_S));
+            w8v(&mate);
+            bi.len() as u64 / 2
+        });
+        matched += 2 * pairs;
+    }
+    if let Some(rm) = round_mate {
+        check_matching(a, w, cap, &rm, &mate.u64s().1);
+    }
+    drop(k);
+    if opt("cpack") {
+        return contract_packed(a, w, w_host, &mate, n, n_live, rounds, twohop, matched / 2, t);
+    }
+    // (1e) C: one row per coarse vertex; leader = min(i, mate(i)).
+    let (l, lead) = t.time("c_leader", || {
+        let l = V::new(t_u64(), n);
+        ok!(GrB_Vector_eWiseMult_BinaryOp(l.0, null(), null(), GrB_MIN_UINT64, idx.0, mate.0, null()));
+        let lead = V::new(t_bool(), n);
+        ok!(GrB_Vector_eWiseMult_BinaryOp(lead.0, null(), null(), GrB_EQ_UINT64, l.0, idx.0, null()));
+        ok!(GrB_Vector_select_BOOL(lead.0, null(), null(), GrB_VALUEEQ_BOOL, lead.0, true, null()));
+        let lead = if partial {
+            let l2 = V::new(t_bool(), n);
+            ok!(GrB_Vector_apply(l2.0, w.0, null(), GrB_IDENTITY_BOOL, lead.0, GrB_DESC_S));
+            l2
+        } else {
+            lead
+        };
+        w8v(&lead);
+        w8v(&l);
+        (l, lead)
+    });
+    let (cid, nc) = t.time("c_number_host", || {
+        let mut nc = lead.nvals();
+        let mut li = vec![0u64; nc as usize];
+        ok!(GrB_Vector_extractTuples_BOOL(li.as_mut_ptr(), null(), &mut nc, lead.0));
+        let ids: Vec<u64> = (0..nc).collect();
+        let cid = V::new(t_u64(), n);
+        ok!(GrB_Vector_build_UINT64(cid.0, li.as_ptr(), ids.as_ptr(), nc, null()));
+        w8v(&cid);
+        (cid, nc)
+    });
+    let ca = t.time("c_extract", || {
+        let ca = V::new(t_u64(), n);
+        ok!(GxB_Vector_extract_Vector(ca.0, null(), null(), cid.0, l.0, null()));
+        w8v(&ca);
+        ca
+    });
+    let c = t.time("c_build", || {
+        let c = if ct() { M::new(t_i32(), n, nc) } else { M::new(t_i32(), nc, n) };
+        let idl = if partial {
+            let v = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(v.0, w.0, null(), GrB_IDENTITY_UINT64, idx.0, GrB_DESC_S));
+            Some(v)
+        } else {
+            None
+        };
+        let ii = idl.as_ref().map_or(idx.0, |v| v.0);
+        if ct() {
+            ok!(GxB_Matrix_build_Scalar_Vector(c.0, ii, ca.0, ops.one_i32, null()));
+        } else {
+            ok!(GxB_Matrix_build_Scalar_Vector(c.0, ca.0, ii, ops.one_i32, null()));
+        }
+        c.wait();
+        c
+    });
+    // (2) contraction A_c = select(OFFDIAG, C A C'), PLUS_TIMES_INT32; w_c = C w.
+    let tmat = t.time("CA", || {
+        let tm = M::new(t_i32(), nc, n);
+        let d = if ct() { unsafe { GrB_DESC_T0 } } else { null() };
+        ok!(GrB_mxm(tm.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, c.0, a.0, d));
+        w8m(&tm);
+        tm
+    });
+    let ac = t.time("CAC'", || {
+        let ac = M::new(t_i32(), nc, nc);
+        let d = if ct() { null() } else { unsafe { GrB_DESC_T1 } };
+        ok!(GrB_mxm(ac.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, tmat.0, c.0, d));
+        w8m(&ac);
+        ac
+    });
+    drop(tmat);
+    if !brk("nooffdiag") {
+        t.time("offdiag", || {
+            ok!(GrB_Matrix_select_INT64(ac.0, null(), null(), GrB_OFFDIAG, ac.0, 0, null()));
+            ac.wait();
+        });
+    }
+    nowait_break(&ac);
+    let wc = t.time("Cw", || {
+        let wc = V::new(t_i32(), nc);
+        let d = if ct() { unsafe { GrB_DESC_T0 } } else { null() };
+        ok!(GrB_mxv(wc.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, c.0, w.0, d));
+        wc.wait();
+        wc
+    });
+    level_checks(&c, &ac, &wc, w, n_live);
+    LevelOut { c, ac, wc, wc_host: None, ca: None, rounds, twohop, pairs: matched / 2 }
+}
+
+/// Break of the nowait build's equality check: +1 on the first stored value of A_c.
+fn nowait_break(ac: &M) {
+    if opt("nowait") && obrk("nowait") && ac.nvals() > 0 {
+        let (i, j, x) = {
+            let mut n = ac.nvals();
+            let mut i = vec![0u64; n as usize];
+            let mut j = vec![0u64; n as usize];
+            let mut x = vec![0i32; n as usize];
+            ok!(GrB_Matrix_extractTuples_INT32(i.as_mut_ptr(), j.as_mut_ptr(), x.as_mut_ptr(), &mut n, ac.0));
+            (i[0], j[0], x[0])
+        };
+        ok!(GrB_Matrix_setElement_INT32(ac.0, x + 1, i, j));
+        ac.wait();
+    }
+}
+
+/// checks (cheap, always on; untimed)
+fn level_checks(
+    c: &M,
+    ac: &M,
+    wc: &V,
+    w: &V,
+    n_live: u64,
+) {
+    let nc = ac.nrows();
+    let diag = M::new(t_i32(), nc, nc);
+    ok!(GrB_Matrix_select_INT64(diag.0, null(), null(), GrB_DIAG, ac.0, 0, null()));
+    assert_eq!(diag.nvals(), 0, "CHECK FAILED: A_c has a diagonal");
+    assert_eq!(wc.sum(), w.sum(), "CHECK FAILED: vertex weight not conserved");
+    assert_eq!(c.nvals(), n_live, "CHECK FAILED: C must have one entry per live fine vertex");
+}
+
+/// cpack: host leader numbering in one pass over mate, C and C' packed, contraction without a
+/// transpose (or as one host pass under `hcon`), w_c on the host.
+#[allow(clippy::too_many_arguments)]
+fn contract_packed(
+    a: &M,
+    w: &V,
+    w_host: Option<&[i32]>,
+    mate: &V,
+    n: u64,
+    n_live: u64,
+    rounds: u32,
+    twohop: bool,
+    pairs: u64,
+    t: &mut Timer,
+) -> LevelOut {
+    let wd;
+    let wh: &[i32] = match w_host {
+        Some(h) => h,
+        None => {
+            wd = dense_i32(w);
+            &wd
+        }
+    };
+    let nu = n as usize;
+    let nl = n_live as usize;
+    let (c_rows, ctp, ca, wch, nc) = t.time("c_host", || {
+        let mt = read_full_u64(mate);
+        let mut ca = vec![u32::MAX; nu];
+        // C (nc x n): row c = its members (1 or 2, ascending)
+        let mut cp = MBuf::<u32>::new(nl + 1);
+        let mut cj = MBuf::<u32>::new(nl);
+        // C' (n x nc): row i = [ca(i)] for live i
+        let mut tp = MBuf::<u32>::new(nu + 1);
+        let mut tj = MBuf::<u32>::new(nl);
+        let mut wch: Vec<i32> = Vec::with_capacity(nl);
+        let (cps, cjs, tps, tjs) = (cp.s(), cj.s(), tp.s(), tj.s());
+        let mut nc = 0usize;
+        let mut ce = 0usize;
+        let mut te = 0usize;
+        cps[0] = 0;
+        for i in 0..nu {
+            tps[i] = te as u32;
+            if wh[i] <= 0 {
+                continue;
+            }
+            let m = mt[i] as usize;
+            let id = if m >= i {
+                cjs[ce] = i as u32;
+                ce += 1;
+                let mut wsum = wh[i];
+                if m != i {
+                    cjs[ce] = m as u32;
+                    ce += 1;
+                    wsum += wh[m];
+                }
+                nc += 1;
+                cps[nc] = ce as u32;
+                wch.push(wsum);
+                (nc - 1) as u32
+            } else {
+                ca[m]
+            };
+            ca[i] = id;
+            tjs[te] = id;
+            te += 1;
+        }
+        tps[nu] = te as u32;
+        assert_eq!(te, nl, "cpack: live count");
+        if obrk("cpack") && nl > 1 {
+            tjs.swap(0, 1);
+        }
+        let c_rows = pack_csr(nc as u64, n, cp, cj, ce as u64, None);
+        let ctp = pack_csr(n, nc as u64, tp, tj, te as u64, None);
+        (c_rows, ctp, ca, wch, nc as u64)
+    });
+    let ac = if opt("hcon") {
+        t.time("hcon", || host_contract(a, &c_rows, &ca, nc))
+    } else {
+        let tmat = t.time("CA", || {
+            let tm = M::new(t_i32(), nc, n);
+            ok!(GrB_mxm(tm.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, c_rows.0, a.0, null()));
+            w8m(&tm);
+            tm
+        });
+        let ac = t.time("CAC'", || {
+            let ac = M::new(t_i32(), nc, nc);
+            ok!(GrB_mxm(ac.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, tmat.0, ctp.0, null()));
+            w8m(&ac);
+            ac
+        });
+        drop(tmat);
+        if !brk("nooffdiag") {
+            t.time("offdiag", || {
+                ok!(GrB_Matrix_select_INT64(ac.0, null(), null(), GrB_OFFDIAG, ac.0, 0, null()));
+                ac.wait();
+            });
+        }
+        nowait_break(&ac);
+        ac
+    };
+    let wc = t.time("Cw", || {
+        let wc = pack_full_i32(mbuf_from(&wch));
+        wc.wait();
+        wc
+    });
+    drop(c_rows);
+    level_checks(&ctp, &ac, &wc, w, n_live);
+    LevelOut { c: ctp, ac, wc, wc_host: Some(wch), ca: Some(ca), rounds, twohop, pairs }
+}
+
+/// Build an `nrows` x `ncols` INT32 CSR by emitting rows in order: `f(r0, r1, cols, vals, cnt)`
+/// appends rows r0..r1 (columns ascending), pushing `cols.len()` into `cnt` before each row.
+/// `wp` is a work prefix over the first `wp.len() - 1` rows, used to balance chunks under hpar
+/// (later rows go to the last chunk). With one chunk the Vecs are handed to GraphBLAS uncopied.
+pub(super) fn emit_csr<F>(
+    nrows: usize,
+    ncols: u64,
+    wp: &[u32],
+    est: usize,
+    iso: bool,
+    f: F,
+) -> M
+where
+    F: Fn(usize, usize, &mut Vec<u32>, &mut Vec<i32>, &mut Vec<u32>) + Sync,
+{
+    emit_csr_t::<i32, F>(nrows, ncols, wp, est, iso, t_i32(), 1, f)
+}
+#[allow(clippy::too_many_arguments)]
+pub(super) fn emit_csr_t<T: Copy + Send + Sync, F>(
+    nrows: usize,
+    ncols: u64,
+    wp: &[u32],
+    est: usize,
+    iso: bool,
+    xt: GrB_Type,
+    one: T,
+    f: F,
+) -> M
+where
+    F: Fn(usize, usize, &mut Vec<u32>, &mut Vec<T>, &mut Vec<u32>) + Sync,
+{
+    let work = if wp.len() >= 2 { *wp.last().unwrap() as usize } else { nrows };
+    let k = chunks_for(work);
+    if k == 1 {
+        let mut cols = Vec::with_capacity(est);
+        let mut vals = if iso { Vec::new() } else { Vec::with_capacity(est) };
+        let mut cnt = Vec::with_capacity(nrows + 1);
+        f(0, nrows, &mut cols, &mut vals, &mut cnt);
+        debug_assert_eq!(cnt.len(), nrows);
+        cnt.push(cols.len() as u32);
+        let nnz = cols.len() as u64;
+        let x = if iso { None } else { Some(MBuf::from_vec(vals)) };
+        return pack_csr_t(nrows as u64, ncols, MBuf::from_vec(cnt), MBuf::from_vec(cols), nnz, x, xt, one);
+    }
+    let mut splits = if wp.len() >= 2 { row_splits(wp, k) } else { (0..=k).map(|c| nrows * c / k).collect() };
+    splits[k] = nrows;
+    let mut outs: Vec<(Vec<u32>, Vec<u32>, Vec<T>)> = (0..k).map(|_| (Vec::new(), Vec::new(), Vec::new())).collect();
+    {
+        let op = SendPtr(outs.as_mut_ptr());
+        let splits = &splits;
+        let f = &f;
+        par_run(k, |c| {
+            let o = unsafe { &mut *op.g().add(c) };
+            let (r0, r1) = (splits[c], splits[c + 1]);
+            o.0.reserve(r1 - r0);
+            o.1.reserve(est / k + 16);
+            if !iso {
+                o.2.reserve(est / k + 16);
+            }
+            f(r0, r1, &mut o.1, &mut o.2, &mut o.0);
+        });
+    }
+    let mut offs = vec![0usize; k + 1];
+    for c in 0..k {
+        offs[c + 1] = offs[c] + outs[c].1.len();
+    }
+    let nnz = offs[k];
+    let mut p = MBuf::<u32>::new(nrows + 1);
+    let j = MBuf::<u32>::new(nnz);
+    let x = if iso { None } else { Some(MBuf::<T>::new(nnz)) };
+    {
+        let (pp, jp) = (SendPtr(p.ptr), SendPtr(j.ptr));
+        let xp = SendPtr(x.as_ref().map_or(null(), |b| b.ptr));
+        let (outs, offs, splits) = (&outs, &offs, &splits);
+        par_run(k, |c| {
+            let o = &outs[c];
+            let r0 = splits[c];
+            unsafe {
+                for (q, &v) in o.0.iter().enumerate() {
+                    *pp.g().add(r0 + q) = (offs[c] + v as usize) as u32;
+                }
+                std::ptr::copy_nonoverlapping(o.1.as_ptr(), jp.g().add(offs[c]), o.1.len());
+                if !iso {
+                    std::ptr::copy_nonoverlapping(o.2.as_ptr(), xp.g().add(offs[c]), o.2.len());
+                }
+            }
+        });
+    }
+    p.s()[nrows] = nnz as u32;
+    pack_csr_t(nrows as u64, ncols, p, j, nnz as u64, x, xt, one)
+}
+
+/// hkey: the keys K(i,j) = (A(i,j) << 32) | fmix32(j ^ salt) in one host pass over A's CSR,
+/// keeping only the pairs within the cap (w(i) + w(j) <= cap) when `capped`. Replaces the cap
+/// mask (diag scalings, eWiseMult, select) and the masked user-op apply.
+fn host_keys(
+    a: &M,
+    wh: &[i32],
+    cap: i32,
+    capped: bool,
+    salt: u64,
+) -> M {
+    let ar = Csr::new(a);
+    let n = ar.n;
+    let salt = salt as u32;
+    let cap = cap as i64;
+    let brk1 = obrk("hkey");
+    let m = emit_csr_t::<u64, _>(n, n as u64, ar.p(), ar.nnz, false, t_u64(), 0, |r0, r1, cols, vals, cnt| {
+        let (ap, aj) = (ar.p(), ar.j());
+        for i in r0..r1 {
+            cnt.push(cols.len() as u32);
+            let wi = wh[i] as i64;
+            for kk in ap[i] as usize..ap[i + 1] as usize {
+                let j = aj[kk];
+                if capped && wi + wh[j as usize] as i64 > cap {
+                    continue;
+                }
+                let wv = ar.val(kk) as u32 as u64;
+                let mut key = (wv << 32) | fmix32(j ^ salt) as u64;
+                if brk1 && i == 0 && kk == ap[0] as usize {
+                    key = key.wrapping_add(10 << 32); // raise one edge's priority
+                }
+                cols.push(j);
+                vals.push(key);
+            }
+        }
+    });
+    drop(ar);
+    m
+}
+
+/// hcon: A_c(c, c') = sum of A(i, j) over i in c, j in c', c != c', as one pass over A's CSR.
+/// Rows come out sorted (a small sort per coarse row; road-graph rows are short).
+fn host_contract(
+    a: &M,
+    c_rows: &M,
+    ca: &[u32],
+    nc: u64,
+) -> M {
+    let ar = Csr::new(a);
+    let cr = Csr::new(c_rows);
+    let ncu = nc as usize;
+    let brk1 = obrk("hcon");
+    let m = emit_csr(ncu, nc, cr.p(), ar.nnz, false, |r0, r1, cols, vals, cnt| {
+        let (ap, aj) = (ar.p(), ar.j());
+        let (cp, cj) = (cr.p(), cr.j());
+        let mut tmp: Vec<(u32, i32)> = Vec::new();
+        for r in r0..r1 {
+            cnt.push(cols.len() as u32);
+            tmp.clear();
+            for &i in &cj[cp[r] as usize..cp[r + 1] as usize] {
+                for kk in ap[i as usize] as usize..ap[i as usize + 1] as usize {
+                    let cc = ca[aj[kk] as usize];
+                    if cc as usize != r {
+                        tmp.push((cc, ar.val(kk)));
+                    }
+                }
+            }
+            tmp.sort_unstable_by_key(|e| e.0);
+            let mut q = 0;
+            while q < tmp.len() {
+                let (cc, mut sm) = tmp[q];
+                q += 1;
+                while q < tmp.len() && tmp[q].0 == cc {
+                    sm += tmp[q].1;
+                    q += 1;
+                }
+                if brk1 && r == 0 && cols.is_empty() {
+                    sm += 1;
+                }
+                cols.push(cc);
+                vals.push(sm);
+            }
+        }
+    });
+    drop(cr);
+    drop(ar);
+    m
+}
+
+/// mate is an involution; round pairs are adjacent; every pair is within the cap.
+fn check_matching(
+    a: &M,
+    w: &V,
+    cap: i32,
+    round_mate: &[u64],
+    mate: &[u64],
+) {
+    let wv = dense_i32(w);
+    for (i, &m) in mate.iter().enumerate() {
+        let m = m as usize;
+        assert_eq!(mate[m] as usize, i, "CHECK FAILED: mate is not an involution at {i}");
+        if m != i {
+            assert!(wv[i] as i64 + wv[m] as i64 <= cap as i64, "CHECK FAILED: cap");
+        }
+        if round_mate[i] as usize != i {
+            let mut x = 0i32;
+            let info = unsafe { GrB_Matrix_extractElement_INT32(&mut x, a.0, i as u64, round_mate[i]) };
+            assert_eq!(info, GrB_Info::GrB_SUCCESS, "CHECK FAILED: matched pair not adjacent");
+        }
+    }
+}
+
+/// Host CSR of the symmetric, loop-free, isolated-free skeleton.
+pub(super) struct HostCsr {
+    pub n: usize,
+    pub p: Vec<u64>,
+    pub j: Vec<u64>,
+}
+pub(super) fn load(path: &str) -> HostCsr {
+    let text = std::fs::read_to_string(path).unwrap();
+    let mut e: Vec<(u64, u64)> = Vec::new();
+    let mut n = 0u64;
+    for line in text.lines() {
+        if line.starts_with('#') {
+            continue;
+        }
+        let mut it = line.split_whitespace();
+        let u: u64 = it.next().unwrap().parse().unwrap();
+        let v: u64 = it.next().unwrap().parse().unwrap();
+        if u == v {
+            continue;
+        }
+        n = n.max(u + 1).max(v + 1);
+        e.push((u, v));
+        e.push((v, u));
+    }
+    e.sort_unstable();
+    e.dedup();
+    let mut map = vec![u64::MAX; n as usize];
+    let mut c = 0u64;
+    for &(u, _) in &e {
+        if map[u as usize] == u64::MAX {
+            map[u as usize] = c;
+            c += 1;
+        }
+    }
+    let nn = c as usize;
+    let mut p = vec![0u64; nn + 1];
+    let mut j = Vec::with_capacity(e.len());
+    for &(u, v) in &e {
+        p[map[u as usize] as usize + 1] += 1;
+        j.push(map[v as usize]);
+    }
+    for k in 0..nn {
+        p[k + 1] += p[k];
+    }
+    HostCsr { n: nn, p, j }
+}
+pub(super) fn to_grb(s: &HostCsr) -> M {
+    let mut ii = Vec::with_capacity(s.j.len());
+    for u in 0..s.n {
+        for _ in s.p[u]..s.p[u + 1] {
+            ii.push(u as u64);
+        }
+    }
+    let x = vec![1i32; s.j.len()];
+    let a = M::new(t_i32(), s.n as u64, s.n as u64);
+    ok!(GrB_Matrix_build_INT32(a.0, ii.as_ptr(), s.j.as_ptr(), x.as_ptr(), ii.len() as u64, null()));
+    a.wait();
+    a
+}
+
+pub(super) fn feral_perm(s: &HostCsr) -> (Vec<i64>, f64, u64) {
+    let xadj: Vec<i64> = s.p.iter().map(|&x| x as i64).collect();
+    let adj: Vec<i64> = s.j.iter().map(|&x| x as i64).collect();
+    let pat = feral_metis::CscPattern::new(s.n, &xadj, &adj).unwrap();
+    let i0 = instr();
+    let t = Instant::now();
+    let perm = feral_metis::metis_order(&pat).unwrap();
+    let sec = t.elapsed().as_secs_f64();
+    (perm, sec, instr().0 - i0.0)
+}
+
+pub(super) struct Rng(pub u64);
+impl Rng {
+    pub fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+}
+
+/// One level R built, handed to the reuse paths.
+pub(super) struct KeptLevel {
+    /// A_l (None for the input matrix)
+    pub a: Option<M>,
+    pub w: V,
+    pub w_host: Option<Vec<i32>>,
+    /// C'_l: l -> l+1
+    pub c: M,
+    pub ca: Option<Vec<u32>>,
+}
+pub(super) struct Kept {
+    pub levels: Vec<KeptLevel>,
+    pub a_last: Option<M>,
+    pub w_last: V,
+    pub w_last_host: Option<Vec<i32>>,
+}
+pub(super) type Rows = Vec<(u64, u64, u32, bool, Timer)>;
+
+/// Coarsen `a0` to <= stop vertices or < 5 % shrink, then project a random 2-way label back.
+/// Returns per-level timers (level 0 = finest), the fingerprint and the level-0 label.
+/// `w_init`: the live weights (GraphBLAS and host), or None for all ones.
+pub(super) fn hierarchy_keep(
+    a0: &M,
+    w_init: Option<(V, Vec<i32>)>,
+    cap: i32,
+    stop: u64,
+    ops: &Ops,
+    keep: Option<&mut Option<Kept>>,
+) -> (Rows, Vec<(u64, u64, i64)>, Vec<u32>) {
+    let n0 = a0.nrows();
+    let (w0, w0h) = w_init.unwrap_or_else(|| {
+        let w0 = V::new(t_i32(), n0);
+        ok!(GrB_Vector_assign_INT32(w0.0, null(), null(), 1, GrB_ALL, n0, null()));
+        (w0, vec![1i32; n0 as usize])
+    });
+    let mut levels: Vec<KeptLevel> = Vec::new();
+    let mut rows = Vec::new();
+    let mut fp = Vec::new();
+    let mut a = None::<M>;
+    let mut w = w0;
+    let mut wh: Option<Vec<i32>> = Some(w0h);
+    static CALLS: AtomicUsize = AtomicUsize::new(0);
+    let call = CALLS.fetch_add(1, Relaxed) as u64;
+    let mut salt = if brk("salt") { 0x5EED_u64 + call } else { 0x5EED_u64 };
+    loop {
+        let cur: &M = a.as_ref().unwrap_or(a0);
+        let n = w.nvals();
+        if n <= stop || rows.len() >= 200 {
+            break;
+        }
+        let mut t = Timer::default();
+        salt = salt.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) >> 1;
+        let out = coarsen_level(cur, &w, wh.as_deref(), cap, salt & 0xFFFF_FFFF, ops, &mut t);
+        let nc = out.ac.nrows();
+        if hash_on() {
+            hash_mat(&out.ac);
+            hash_vec_i32(&out.wc);
+            hash_mat(&out.c);
+        }
+        rows.push((n, cur.nvals(), out.rounds, out.twohop, t));
+        fp.push((nc, out.ac.nvals(), out.ac.sum()));
+        let prev_a = a.take();
+        let prev_w = std::mem::replace(&mut w, out.wc);
+        let prev_wh = std::mem::replace(&mut wh, out.wc_host);
+        levels.push(KeptLevel { a: prev_a, w: prev_w, w_host: prev_wh, c: out.c, ca: out.ca });
+        a = Some(out.ac);
+        if nc * 100 > 95 * n {
+            break;
+        }
+    }
+    // (3) projection: random labels on the coarsest level, then mxv(C', labels) per level.
+    let top = a.as_ref().map_or(n0, |m| m.nrows());
+    let mut rng = Rng(42);
+    let lab: Vec<i32> = (0..top).map(|_| (rng.next() & 1) as i32).collect();
+    let ii: Vec<u64> = (0..top).collect();
+    let mut lv = V::new(t_i32(), top);
+    ok!(GrB_Vector_build_INT32(lv.0, ii.as_ptr(), lab.as_ptr(), top, null()));
+    for (l, kl) in levels.iter().enumerate().rev() {
+        let nf = rows[l].0;
+        let nd = kl.c.nrows();
+        let t = &mut rows[l].4;
+        let fine = t.time("project", || {
+            let f = V::new(t_i32(), nd);
+            ok!(GrB_mxv(f.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, kl.c.0, lv.0, null()));
+            w8v(&f);
+            f
+        });
+        assert_eq!(fine.nvals(), nf, "CHECK FAILED: projection lost vertices");
+        let am = kl.a.as_ref().map_or(a0.0, |m| m.0);
+        t.time("bnd", || {
+            let b = V::new(t_i32(), nd);
+            ok!(GrB_mxv(b.0, null(), null(), GxB_PLUS_SECOND_INT32, am, fine.0, null()));
+            b.wait();
+        });
+        lv = fine;
+    }
+    hash_vec_i32(&lv);
+    let (_, l0) = lv.i32s();
+    if let Some(k) = keep {
+        *k = Some(Kept { levels, a_last: a, w_last: w, w_last_host: wh });
+    }
+    (rows, fp, l0.into_iter().map(|x| x as u32).collect())
+}
