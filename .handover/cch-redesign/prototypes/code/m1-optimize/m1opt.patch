+            }
+            let r0 = rows_timer(&rows);
+            fpc(&mut ck, ("R", 0), fp);
+            phase_line(th, run, 0, "D0", &r0, pw, pi, &format!("levels={}", rows.len()));
+            let mut troot = Timer::default();
+            let (i0, w0) = (instr(), Instant::now());
+            let h0 = root_hier(kept.unwrap(), n, &mut troot);
+            let (pw, pi) = (w0.elapsed().as_secs_f64(), instr().0 - i0.0);
+            phase_line(th, run, 0, "ROOTMAP", &troot, pw, pi, "");
+            let mut h0 = Some(h0);
+            let (mut pb1, mut pb2, mut pcs): (Option<Hier>, Option<Hier>, Option<Hier>) = (None, None, None);
+            for d in 1..=max_depth {
+                let cells = 1usize << d;
+                let lab = &labels[d as usize];
+                let wd: Vec<i32> = lab.iter().map(|&c| (c != SEP) as i32).collect();
+                let live = wd.iter().filter(|&&x| x > 0).count() as u64;
+                let mut tsplit = Timer::default();
+                let (i0, w0) = (instr(), Instant::now());
+                let ad = split2(&a0, lab, cells as u64, &ops, &mut tsplit);
+                let (pw, pi) = (w0.elapsed().as_secs_f64(), instr().0 - i0.0);
+                phase_line(th, run, d, "SPLIT", &tsplit, pw, pi, "");
+                if check && ad.nvals() != split_count(&s, lab) {
+                    ck.split_fail += 1;
+                }
+                if hashing {
+                    hash_begin();
+                    hash_mat(&ad);
+                    hput("SPLIT", d, hash_end());
+                }
+                let l0 = L0 { a: &ad, n, cell: lab, w: &wd, live };
+                // R
+                if hashing {
+                    hash_begin();
+                }
+                let (i0, w0) = (instr(), Instant::now());
+                let (rows, fp, _) = hierarchy_keep(&ad, Some(ones_vec(n, lab)), cap_of(d), stop_of(d), &ops, None);
+                let (pw, pi) = (w0.elapsed().as_secs_f64(), instr().0 - i0.0);
+                if hashing {
+                    hput("R", d, hash_end());
+                }
+                let rt = rows_timer(&rows);
+                phase_line(th, run, d, "R", &rt, pw, pi, &format!("levels={} coarsened={}", rows.len(), rows.iter().map(|r| r.0).sum::<u64>()));
+                fpc(&mut ck, ("R", d), fp);
+                // B1 (check run only) and B2: never match
+                let mc0 = MATCH_CALLS.load(Relaxed);
+                let hb1 = if check {
+                    let mut tb1 = Timer::default();
+                    let hb1 = build_reuse(Mode::B1, pb1.as_ref().or(h0.as_ref()).unwrap(), &l0, cells, stop_of(d), &ops, &mut tb1, None, d);
+                    Some(hb1)
+                } else {
+                    None
+                };
+                let mut tb2 = Timer::default();
+                if hashing {
+                    hash_begin();
+                }
+                let (i0, w0) = (instr(), Instant::now());
+                let hb2 = build_reuse(Mode::B2, pb2.as_ref().or(h0.as_ref()).unwrap(), &l0, cells, stop_of(d), &ops, &mut tb2, None, d);
+                if brk("rematch") && d >= 3 {
+                    let _ = hierarchy_keep(&ad, None, cap_of(d), stop_of(d), &ops, None);
+                }
+                let lab2 = project_b(&hb2, &l0, &mut tb2);
+                let (pw, pi) = (w0.elapsed().as_secs_f64(), instr().0 - i0.0);
+                if hashing {
+                    if let Some(l) = &lab2 {
+                        hash_vec_i32(l);
+                    }
+                    hput("B2", d, hash_end());
+                }
+                ck.match_calls_b += (MATCH_CALLS.load(Relaxed) - mc0) as u64;
+                phase_line(th, run, d, "B2", &tb2, pw, pi, &format!("levels={} coarsest={}", hb2.levels.len(), hb2.levels.last().map_or(live, |l| l.live)));
+                if let Some(hb1) = &hb1 {
+                    compare(hb1, &hb2, &l0, &mut ck);
+                }
+                fpc(&mut ck, ("B2", d), hier_fp(&hb2));
+                // capstop
+                let mut tcs = Timer::default();
+                if hashing {
+                    hash_begin();
+                }
+                let (i0, w0) = (instr(), Instant::now());
+                let cs = build_capstop(pcs.as_ref().or(h0.as_ref()).unwrap(), &l0, cells, cap_of(d), &ops, &mut tcs, &mut ck, check);
+                let (pw, pi) = (w0.elapsed().as_secs_f64(), instr().0 - i0.0);
+                if hashing {
+                    hput("CS", d, hash_end());
+                }
+                let mut tall = Timer::default();
+                tall.add(&tcs);
+                tall.add(&rows_timer(&cs.fresh_rows));
+                phase_line(
+                    th,
+                    run,
+                    d,
+                    "CS",
+                    &tall,
+                    pw,
+                    pi,
+                    &format!(
+                        "levels={} reused={} fresh={} coarsened={} cells_fresh={} g_n={} reasons={}",
+                        cs.h.levels.len() + cs.fresh_rows.len(),
+                        cs.h.levels.len(),
+                        cs.fresh_rows.len(),
+                        cs.fresh_rows.iter().map(|r| r.0).sum::<u64>(),
+                        cs.cells_fresh,
+                        cs.g_n,
+                        cs.nreason[1..].iter().map(|x| x.to_string()).collect::<Vec<_>>().join("/")
+                    ),
+                );
+                if check && rulecheck {
+                    let capd = cap_of(d) as i64;
+                    let same_cap = rule_replay(&l0, &root_cmaps, cells, &|_, _| capd);
+                    let per_cell = rule_replay(&l0, &root_cmaps, cells, &|_, w| ((15 * w) / 1000).max(2));
+                    let (mut same, mut plim, mut fail, mut pcd) = (0u64, 0u64, 0u64, 0u64);
+                    let mut shown = 0;
+                    for c in 0..cells {
+                        let (a, b) = (cs.stop[c], same_cap[c]);
+                        if a == b {
+                            same += 1;
+                        } else if (a.1 == R_PLIM || a.1 == R_END) && a.0 <= b.0 {
+                            plim += 1;
+                        } else {
+                            fail += 1;
+                            if shown < 5 {
+                                shown += 1;
+                                println!("RULEDIFF depth={d} cell={c} capstop={a:?} rule={b:?}");
+                            }
+                        }
+                        if per_cell[c] != b {
+                            pcd += 1;
+                        }
+                    }
+                    println!("RULE depth={d} cells={cells} same={same} parent_limited={plim} other={fail} percell_cap_differs={pcd}");
+                    ck.rule_cells += cells as u64;
+                    ck.rule_same += same;
+                    ck.rule_plim += plim;
+                    ck.rule_fail += fail;
+                    ck.rule_percell_diff += pcd;
+                }
+                let mut fpcs = hier_fp(&cs.h);
+                fpcs.push((u64::MAX, cs.g_n, 0));
+                fpcs.extend(cs.fresh_fp.iter().copied());
+                fpc(&mut ck, ("CS", d), fpcs);
+                drop(l0);
+                pb1 = hb1;
+                pb2 = Some(hb2);
+                pcs = Some(cs.h);
+                h0 = None;
+                flush();
+            }
+            println!("RUN threads={th} run={run} wall={:.2}s rss_mb={} slow_borrow={}", wall.elapsed().as_secs_f64(), rss_mb(), SLOW_BORROW.load(Relaxed));
+            flush();
+        }
+    }
+    // hashes against a baseline file
+    if let Some(hm) = hash_mode {
+        if let Some(f) = hm.strip_prefix("write:") {
+            let txt: String = hashes.iter().map(|((p, d), (h, c))| format!("{p} {d} {h:016x} {c}\n")).collect();
+            std::fs::write(f, txt).unwrap();
+            println!("HASHES written to {f} ({})", hashes.len());
+        } else if let Some(f) = hm.strip_prefix("check:") {
+            let txt = std::fs::read_to_string(f).unwrap();
+            for line in txt.lines() {
+                let w: Vec<&str> = line.split_whitespace().collect();
+                let key = (w[0].to_string(), w[1].parse::<u32>().unwrap());
+                let want = (u64::from_str_radix(w[2], 16).unwrap(), w[3].parse::<u64>().unwrap());
+                if key.1 > max_depth {
+                    continue;
+                }
+                ck.hash_compared += 1;
+                match hashes.get(&key) {
+                    Some(got) if *got == want => {}
+                    got => {
+                        ck.hash_fail += 1;
+                        println!("HASHMISMATCH path={} depth={} want={:016x} got={:?}", key.0, key.1, want.0, got.map(|g| format!("{:016x}", g.0)));
+                    }
+                }
+            }
+        }
+    }
+    ck.hash_fail += HASHDIFF.load(Relaxed) as u64;
+    println!("CHECKS {ck:?}");
+    flush();
+    assert_eq!(ck.split_fail, 0, "CHECK FAILED: split pattern");
+    assert_eq!(ck.eq_fail, 0, "CHECK FAILED: B1 != B2");
+    assert_eq!(ck.b1_invalid, 0, "CHECK FAILED: B1 level invalid");
+    assert_eq!(ck.w_fail, 0, "CHECK FAILED: host weights != C'^T w");
+    assert_eq!(ck.acct_fail, 0, "CHECK FAILED: accounting identity");
+    assert_eq!(ck.match_calls_b, 0, "CHECK FAILED: B1/B2 ran a matching");
+    assert_eq!(ck.cs_cap_fail, 0, "CHECK FAILED: capstop reused a level over the cap");
+    assert_eq!(ck.cs_w_fail, 0, "CHECK FAILED: capstop weight not conserved");
+    assert_eq!(ck.sep_fail, 0, "CHECK FAILED: separator does not separate");
+    assert_eq!(ck.fp_fail, 0, "CHECK FAILED: hierarchy differs across runs/threads");
+    assert_eq!(ck.hash_fail, 0, "CHECK FAILED: differs from the baseline (hash)");
+    assert_eq!(ck.rule_fail, 0, "CHECK FAILED: capstop stop level differs from the quality harness's rule");
+}
