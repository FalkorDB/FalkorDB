+/// Pack a row-major CSR into a new INT32 matrix (O(1)): offsets p (n+1), columns j, values x
+/// (None: iso 1).
+pub(super) fn pack_csr(
+    nrows: u64,
+    ncols: u64,
+    p: MBuf<u32>,
+    j: MBuf<u32>,
+    nnz: u64,
+    x: Option<MBuf<i32>>,
+) -> M {
+    pack_csr_t(nrows, ncols, p, j, nnz, x, t_i32(), 1i32)
+}
+/// pack_csr for any value type `xt` (iso value `one` when `x` is None).
+pub(super) fn pack_csr_t<T: Copy>(
+    nrows: u64,
+    ncols: u64,
+    p: MBuf<u32>,
+    j: MBuf<u32>,
+    nnz: u64,
+    x: Option<MBuf<T>>,
+    xt: GrB_Type,
+    one: T,
+) -> M {
+    let m = M::new(xt, nrows, ncols);
+    let mut c: GxB_Container = null();
+    ok!(GxB_Container_new(&mut c));
+    unsafe {
+        (*c).nrows = nrows;
+        (*c).ncols = ncols;
+        (*c).nrows_nonempty = -1;
+        (*c).ncols_nonempty = -1;
+        (*c).nvals = nnz;
+        (*c).format = GxB_SPARSE as i32;
+        (*c).orientation = GrB_Orientation::GrB_ROWMAJOR as i32;
+        (*c).iso = x.is_none();
+        (*c).jumbled = false;
+    }
+    let (pb, jb) = (p.bytes(), j.bytes());
+    let mut pp = p.take();
+    let mut jp = j.take();
+    ok!(GxB_Vector_load((*c).p, &mut pp, t_u32(), nrows + 1, pb, 0, null()));
+    ok!(GxB_Vector_load((*c).i, &mut jp, t_u32(), nnz, jb, 0, null()));
+    match x {
+        Some(xb) => {
+            let b = xb.bytes();
+            let mut xp = xb.take();
+            ok!(GxB_Vector_load((*c).x, &mut xp, xt, nnz, b, 0, null()));
+        }
+        None => {
+            let mut o = MBuf::<T>::new(1);
+            o.s()[0] = one;
+            let b = o.bytes();
+            let mut xp = o.take();
+            ok!(GxB_Vector_load((*c).x, &mut xp, xt, 1, b, 0, null()));
+        }
+    }
+    ok!(GxB_load_Matrix_from_Container(m.0, c, null()));
+    ok!(GxB_Container_free(&mut c));
+    m
+}
+/// A full INT32 vector from a host array (O(1)).
+pub(super) fn pack_full_i32(x: MBuf<i32>) -> V {
+    let n = x.len as u64;
+    let v = V::new(t_i32(), n);
+    let b = x.bytes();
+    let mut xp = x.take();
+    ok!(GxB_Vector_load(v.0, &mut xp, t_i32(), n, b, 0, null()));
+    v
+}
+fn mbuf_from<T: Copy>(s: &[T]) -> MBuf<T> {
+    let mut b = MBuf::new(s.len());
+    b.s().copy_from_slice(s);
+    b
+}
