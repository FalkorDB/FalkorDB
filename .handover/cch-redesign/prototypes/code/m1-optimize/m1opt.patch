+//! SCRATCH (never committed): D5 option (b), optimized copy (m1opt) of m1rcB's reuse bench.
+//! For every ND depth >= 1 it times
+//!   R  - re-coarsen from scratch (the parent bench's `hierarchy`),
+//!   B2 - one masked split of the parent's level plus straddler-only re-contraction,
+//!   CS - capstop: B2 per cell while the cell's heaviest coarse vertex stays within R's cap and
+//!        the cell has more than 100 coarse vertices; a cell that breaks the cap (or whose parent
+//!        has no such level) coarsens fresh with R's matching, as `m1-reuse-quality.md`'s
+//!        `reuse_capstop` rule does.
+//! B1 (re-contract every level) runs in the check run only, as B2's equality check.
+//! Depth 0 is R's hierarchy, shared by all paths.
+//!
+//! Env, besides M1_GRAPH, M1_THREADS, M1_RUNS (timed runs), M1_DEPTHS, M1_JIT, M1_CT, M1_BREAK:
+//!   M1_FERAL=k      feral timing runs (0: read the order from M1_PERM_CACHE)
+//!   M1_PERM_CACHE   file holding feral's order (written when missing)
+//!   M1_HASH=write:F | check:F   per-(path, depth) equality hashes against a baseline
+//!   M1_RULECHECK=1  replay the quality harness's capstop rule and compare stop levels per cell
+//!   M1_NOCHECK=1    no check run (run 0)
+//! Reuse-side switches in M1O (see m1_coarsen_bench.rs for the level switches):
+//!   hsplit  the fine split per depth as one host pass over A0's CSR
+//!   hb2     the B2 level as one host pass over the parent level's CSR, splicing the straddler
+//!           rows and columns in (replaces masked mxm, value copy, resize, straddler products
+//!           and the union)
+//!   pk      C' packed from the numbering; the level's GraphBLAS w vector is not built (only
+//!           checks read it)
+//!   gath    capstop's gather by appending the stopped blocks' CSR rows
+//!   book    numbering with reused scratch and one pass for capstop's stop test
+//!   hpar    host passes split across the thread count
+
+use super::*;
+use std::collections::BTreeMap;
+use std::time::Instant;
+
+const SEP: u32 = u32::MAX;
+const NONE: u32 = u32::MAX;
+/// Per-cell floor: a cell with at most this many coarse vertices needs no more coarsening (the
+/// bench's stop, 100 per cell).
+const FLOOR: u64 = 100;
+/// Hashes that differ between thread counts within one process.
+static HASHDIFF: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+fn ncols(a: &M) -> u64 {
+    let mut n = 0;
+    ok!(GrB_Matrix_ncols(&mut n, a.0));
+    n
+}
+fn tuples(a: &M) -> (Vec<u64>, Vec<u64>, Vec<i32>) {
+    a.wait();
+    let mut n = a.nvals();
+    let mut i = vec![0u64; n as usize];
+    let mut j = vec![0u64; n as usize];
+    let mut x = vec![0i32; n as usize];
+    ok!(GrB_Matrix_extractTuples_INT32(i.as_mut_ptr(), j.as_mut_ptr(), x.as_mut_ptr(), &mut n, a.0));
+    (i, j, x)
+}
+fn row_degrees(a: &M) -> Vec<u32> {
+    let mut n = a.nvals();
+    let mut i = vec![0u64; n as usize];
+    ok!(GrB_Matrix_extractTuples_INT32(i.as_mut_ptr(), null(), null(), &mut n, a.0));
+    let mut d = vec![0u32; a.nrows() as usize];
+    for r in i {
+        d[r as usize] += 1;
+    }
+    d
+}
+fn vec_i32(
+    n: u64,
+    ids: &[u64],
+    x: &[i32],
+) -> V {
+    let v = V::new(t_i32(), n);
+    ok!(GrB_Vector_build_INT32(v.0, ids.as_ptr(), x.as_ptr(), ids.len() as u64, null()));
+    w8v(&v);
+    v
+}
+fn mxv_i32(
+    a: &M,
+    x: &V,
+    transpose: bool,
+) -> V {
+    let mut r = 0;
+    ok!(if transpose { GrB_Matrix_ncols(&mut r, a.0) } else { GrB_Matrix_nrows(&mut r, a.0) });
+    let y = V::new(t_i32(), r);
+    let d = if transpose { unsafe { GrB_DESC_T0 } } else { null() };
+    ok!(GrB_mxv(y.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, a.0, x.0, d));
+    w8v(&y);
+    y
+}
+
+/// One reused level l >= 1. Ids are the parent's ids at level l, plus one appended id per straddler
+/// part; a parent id whose members split, or were all dropped, is a hole (cell SEP, weight 0).
+struct Lvl {
+    n: u64,
+    a: M,
+    /// C' (n_{l-1} x n_l): projection and column map.
+    ct: M,
+    /// the GraphBLAS weights (None under pk: only checks read them; they use `w`)
+    wv: Option<V>,
+    w: Vec<i32>,
+    cell: Vec<u32>,
+    /// The parent's id at this level (identity for kept ids).
+    pa: Vec<u32>,
+    /// Level l-1 id -> level l id (NONE for dead ids and for cells that stopped reusing).
+    cmap: Vec<u32>,
+    live: u64,
+    /// live coarse vertices per cell (book only; empty otherwise)
+    ccount: Vec<u32>,
+}
+#[derive(Default)]
+struct Hier {
+    levels: Vec<Lvl>,
+}
+
+/// Level 0 of a depth: the split graph, its cells and unit weights.
+struct L0<'a> {
+    a: &'a M,
+    n: u64,
+    cell: &'a [u32],
+    w: &'a [i32],
+    live: u64,
+}
+struct View<'a> {
+    a: &'a M,
+    n: u64,
+    cell: &'a [u32],
+    w: &'a [i32],
+    pa: Option<&'a [u32]>,
+    live: u64,
+}
+fn view<'a>(
+    h: &'a Hier,
+    l0: &'a L0,
+    s: usize,
+) -> View<'a> {
+    if s == 0 {
+        View { a: l0.a, n: l0.n, cell: l0.cell, w: l0.w, pa: None, live: l0.live }
+    } else {
+        let x = &h.levels[s - 1];
+        View { a: &x.a, n: x.n, cell: &x.cell, w: &x.w, pa: Some(&x.pa), live: x.live }
+    }
+}
+fn hash_lvl(x: &Lvl) {
+    if !hash_on() {
+        return;
+    }
+    hash_u64s([x.n, x.live]);
+    hash_mat(&x.a);
+    hash_mat(&x.ct);
+    hash_i32s(&x.w);
+    hash_u32s(&x.cell);
+    hash_u32s(&x.pa);
+    hash_u32s(&x.cmap);
+}
+
+/// Depth 0: R's kept hierarchy as a parent for depth 1 (host maps, timed as "rootmap").
+fn root_hier(
+    kept: Kept,
+    n0: u64,
+    t: &mut Timer,
+) -> Hier {
+    assert!(ct(), "the reuse paths need M1_CT=1 (C' maps)");
+    let Kept { levels, a_last, w_last, w_last_host } = kept;
+    let nl = levels.len();
+    let mut a_last = a_last;
+    let mut w_last = Some((w_last, w_last_host));
+    let mut as_: Vec<Option<M>> = Vec::new();
+    let mut ws: Vec<Option<(V, Option<Vec<i32>>)>> = Vec::new();
+    let mut cs: Vec<Option<(M, Option<Vec<u32>>)>> = Vec::new();
+    for kl in levels {
+        as_.push(kl.a);
+        ws.push(Some((kl.w, kl.w_host)));
+        cs.push(Some((kl.c, kl.ca)));
+    }
+    let mut h = Hier::default();
+    let mut prev_n = n0;
+    for l in 1..=nl {
+        let a = if l < nl { as_[l].take().unwrap() } else { a_last.take().unwrap() };
+        let (wv, wh) = if l < nl { ws[l].take().unwrap() } else { w_last.take().unwrap() };
+        let (ctm, ca) = cs[l - 1].take().unwrap();
+        let (n, cmap, w) = t.time("rootmap", || {
+            let n = ncols(&ctm);
+            let cmap = match ca {
+                Some(ca) => ca,
+                None => {
+                    let (i, j, _) = tuples(&ctm);
+                    let mut cmap = vec![NONE; prev_n as usize];
+                    for (x, y) in i.iter().zip(&j) {
+                        cmap[*x as usize] = *y as u32;
+                    }
+                    cmap
+                }
+            };
+            let w = match wh {
+                Some(w) => w,
+                None => dense_i32(&wv),
+            };
+            (n, cmap, w)
+        });
+        let live = w.iter().filter(|&&x| x > 0).count() as u64;
+        h.levels.push(Lvl { n, a, ct: ctm, wv: Some(wv), w, cell: vec![0; n as usize], pa: (0..n as u32).collect(), cmap, live, ccount: vec![live as u32] });
+        prev_n = n;
+    }
+    h
+}
+
+/// Host numbering of a child level (timed as "number" by the callers).
+struct Num {
+    n: u64,
+    cmap: Vec<u32>,
+    w: Vec<i32>,
+    cell: Vec<u32>,
+    pa: Vec<u32>,
+    live: u64,
+    ct_i: Vec<u64>,
+    ct_j: Vec<u64>,
+    cl_q: Vec<u64>,
+    cl_c: Vec<u64>,
+    ps_i: Vec<u64>,
+    ps_j: Vec<u64>,
+    /// members (previous-level ids) of part k: part_mem[part_start[k]..part_start[k+1]]
+    part_start: Vec<u32>,
+    part_mem: Vec<u32>,
+    strad: u64,
+    sep_only: u64,
+    parent_live: u64,
+    maxw: Vec<i32>,
+    plim: Vec<u32>,
+    /// live coarse vertices per cell (book only)
+    ccount: Vec<u32>,
+}
+
+/// Child level l from the child's level l-1 (`p`) and the parent's level l (`par`): a child vertex
+/// at l is (parent vertex at l, child cell). A parent vertex is clean when all its members are live
+/// in one child cell (its weight is then whole); its id is kept. Otherwise each child cell it
+/// touches gets an appended part, ordered by (parent id, cell).
+fn number(
+    p: &View,
+    par: &Lvl,
+    active: Option<&[bool]>,
+    ncells: usize,
+) -> Num {
+    let np = par.n as usize;
+    let nprev = p.n as usize;
+    let need_cl = !opt("hb2");
+    let need_ct = !opt("pk");
+    let mut f = vec![NONE; np];
+    let mut multi = vec![false; np];
+    let mut ws = vec![0i64; np];
+    let mut qx = vec![NONE; nprev];
+    let mut plim_flag = vec![false; ncells];
+    for x in 0..nprev {
+        let c = p.cell[x];
+        if c == SEP {
+            continue;
+        }
+        if let Some(a) = active {
+            if !a[c as usize] {
+                continue;
+            }
+        }
+        let pid = p.pa.map_or(x, |pa| pa[x] as usize);
+        let q = par.cmap[pid];
+        if q == NONE {
+            plim_flag[c as usize] = true;
+            continue;
+        }
+        qx[x] = q;
+        let qi = q as usize;
+        ws[qi] += p.w[x] as i64;
+        if f[qi] == NONE {
+            f[qi] = c;
+        } else if f[qi] != c {
+            multi[qi] = true;
+        }
+    }
+    let sepclean = brk("sepclean");
+    let merge = brk("mergeparts");
+    let is_clean = |q: usize| f[q] != NONE && !multi[q] && (sepclean || ws[q] == par.w[q] as i64);
+    let mut sx: Vec<(u32, u32, u32)> = Vec::new();
+    for (x, &q) in qx.iter().enumerate() {
+        if q != NONE && !is_clean(q as usize) {
+            sx.push((q, if merge { 0 } else { p.cell[x] }, x as u32));
+        }
+    }
+    sx.sort_unstable();
+    let mut cmap = vec![NONE; nprev];
+    let mut part_q: Vec<u32> = Vec::new();
+    let mut part_c: Vec<u32> = Vec::new();
+    let mut part_w: Vec<i64> = Vec::new();
+    let mut part_start: Vec<u32> = Vec::new();
+    let mut part_mem: Vec<u32> = Vec::with_capacity(sx.len());
+    let mut last = (NONE, NONE);
+    for &(q, kc, x) in &sx {
+        if (q, kc) != last {
+            part_q.push(q);
+            part_c.push(p.cell[x as usize]);
+            part_w.push(0);
+            part_start.push(part_mem.len() as u32);
+            last = (q, kc);
+        }
+        cmap[x as usize] = (np + part_q.len() - 1) as u32;
+        part_mem.push(x);
+        *part_w.last_mut().unwrap() += p.w[x as usize] as i64;
+    }
+    part_start.push(part_mem.len() as u32);
+    let nparts = part_q.len();
+    let n = np + nparts;
+    let mut cell = vec![SEP; n];
+    let mut w = vec![0i32; n];
+    let mut pa = vec![NONE; n];
+    let mut cl_q = Vec::new();
+    let mut cl_c = Vec::new();
+    let (mut strad, mut sep_only, mut parent_live) = (0, 0, 0);
+    let mut maxw = vec![0i32; ncells];
+    for q in 0..np {
+        if par.cell[q] != SEP {
+            parent_live += 1;
+        }
+        if f[q] == NONE {
+            if par.cell[q] != SEP {
+                sep_only += 1;
+            }
+            continue;
+        }
+        if is_clean(q) {
+            cell[q] = f[q];
+            w[q] = par.w[q];
+            pa[q] = q as u32;
+            if need_cl {
+                cl_q.push(q as u64);
+                cl_c.push(f[q] as u64);
+            }
+            let m = &mut maxw[f[q] as usize];
+            *m = (*m).max(par.w[q]);
+        } else {
+            strad += 1;
+        }
+    }
+    for k in 0..nparts {
+        let id = np + k;
+        cell[id] = part_c[k];
+        w[id] = part_w[k] as i32;
+        pa[id] = part_q[k];
+        let m = &mut maxw[part_c[k] as usize];
+        *m = (*m).max(w[id]);
+    }
+    for (x, &q) in qx.iter().enumerate() {
+        if q != NONE && cmap[x] == NONE {
+            cmap[x] = q;
+        }
+    }
+    let mut ct_i = Vec::new();
+    let mut ct_j = Vec::new();
+    let mut ps_i = Vec::new();
+    let mut ps_j = Vec::new();
+    if need_ct {
+        ct_i.reserve(nprev);
+        ct_j.reserve(nprev);
+        for (x, &y) in cmap.iter().enumerate() {
+            if y != NONE {
+                ct_i.push(x as u64);
+                ct_j.push(y as u64);
+                if y as usize >= np {
+                    ps_i.push(x as u64);
+                    ps_j.push(y as u64);
+                }
+            }
+        }
+    } else {
+        // the straddler members, for the stats line and checks
+        for k in 0..nparts {
+            for &x in &part_mem[part_start[k] as usize..part_start[k + 1] as usize] {
+                ps_i.push(x as u64);
+                ps_j.push((np + k) as u64);
+            }
+        }
+    }
+    let live = cell.iter().filter(|&&c| c != SEP).count() as u64;
+    let plim = (0..ncells as u32).filter(|&c| plim_flag[c as usize]).collect();
+    Num { n: n as u64, cmap, w, cell, pa, live, ct_i, ct_j, cl_q, cl_c, ps_i, ps_j, part_start, part_mem, strad, sep_only, parent_live, maxw, plim, ccount: Vec::new() }
+}
+
+/// book: the same numbering in fewer passes. `cmap` holds the parent id while the members are
+/// counted (no separate q array), weights are i32, the cell or MULTI sits in one array, and the
+/// per-cell live counts come out of the fill. The stats fields are computed only for `stats`.
+fn number_fast(
+    p: &View,
+    par: &Lvl,
+    active: Option<&[bool]>,
+    ncells: usize,
+    stats: bool,
+) -> Num {
+    const MULTI: u32 = u32::MAX - 1;
+    let np = par.n as usize;
+    let nprev = p.n as usize;
+    let mut f = vec![NONE; np];
+    let mut ws = vec![0i32; np];
+    let mut cmap = vec![NONE; nprev];
+    let mut plim_flag = vec![false; ncells];
+    let pw = &par.w;
+    for x in 0..nprev {
+        let c = p.cell[x];
+        if c == SEP {
+            continue;
+        }
+        if let Some(a) = active {
+            if !a[c as usize] {
+                continue;
+            }
+        }
+        let pid = p.pa.map_or(x, |pa| pa[x] as usize);
+        let q = par.cmap[pid];
+        if q == NONE {
+            plim_flag[c as usize] = true;
+            continue;
+        }
+        cmap[x] = q;
+        let qi = q as usize;
+        ws[qi] += p.w[x];
+        let fq = f[qi];
+        f[qi] = if fq == NONE || fq == c { c } else { MULTI };
+    }
+    let sepclean = brk("sepclean");
+    let merge = brk("mergeparts");
+    let is_clean = |q: usize| f[q] < MULTI && (sepclean || ws[q] == pw[q]);
+    let mut sx: Vec<(u32, u32, u32)> = Vec::new();
+    for (x, &q) in cmap.iter().enumerate() {
+        if q != NONE && !is_clean(q as usize) {
+            sx.push((q, if merge { 0 } else { p.cell[x] }, x as u32));
+        }
+    }
+    sx.sort_unstable();
+    let mut part_q: Vec<u32> = Vec::new();
+    let mut part_c: Vec<u32> = Vec::new();
+    let mut part_w: Vec<i32> = Vec::new();
+    let mut part_start: Vec<u32> = Vec::new();
+    let mut part_mem: Vec<u32> = Vec::with_capacity(sx.len());
+    let mut last = (NONE, NONE);
+    for &(q, kc, x) in &sx {
+        if (q, kc) != last {
+            part_q.push(q);
+            part_c.push(p.cell[x as usize]);
+            part_w.push(0);
+            part_start.push(part_mem.len() as u32);
+            last = (q, kc);
+        }
+        cmap[x as usize] = (np + part_q.len() - 1) as u32;
+        part_mem.push(x);
+        *part_w.last_mut().unwrap() += p.w[x as usize];
+    }
+    part_start.push(part_mem.len() as u32);
+    let nparts = part_q.len();
+    let n = np + nparts;
+    let mut cell = vec![SEP; n];
+    let mut w = vec![0i32; n];
+    let mut pa = vec![NONE; n];
+    let mut maxw = vec![0i32; ncells];
+    let mut ccount = vec![0u32; ncells];
+    let mut live = 0u64;
+    let (mut strad, mut sep_only, mut parent_live) = (0, 0, 0);
+    for q in 0..np {
+        let fq = f[q];
+        if stats {
+            if par.cell[q] != SEP {
+                parent_live += 1;
+            }
+            if fq == NONE && par.cell[q] != SEP {
+                sep_only += 1;
+            }
+        }
+        if fq == NONE {
+            continue;
+        }
+        if is_clean(q) {
+            cell[q] = fq;
+            w[q] = pw[q];
+            pa[q] = q as u32;
+            let m = &mut maxw[fq as usize];
+            *m = (*m).max(pw[q]);
+            ccount[fq as usize] += 1;
+            live += 1;
+        } else {
+            strad += 1;
+        }
+    }
+    for k in 0..nparts {
+        let id = np + k;
+        let c = part_c[k] as usize;
+        cell[id] = part_c[k];
+        w[id] = part_w[k];
+        pa[id] = part_q[k];
+        maxw[c] = maxw[c].max(part_w[k]);
+        ccount[c] += 1;
+        live += 1;
+    }
+    let mut ps_i = Vec::new();
+    let mut ps_j = Vec::new();
+    if stats {
+        for k in 0..nparts {
+            for &x in &part_mem[part_start[k] as usize..part_start[k + 1] as usize] {
+                ps_i.push(x as u64);
+                ps_j.push((np + k) as u64);
+            }
+        }
+    }
+    let plim = (0..ncells as u32).filter(|&c| plim_flag[c as usize]).collect();
+    Num {
+        n: n as u64,
+        cmap,
+        w,
+        cell,
+        pa,
+        live,
+        ct_i: Vec::new(),
+        ct_j: Vec::new(),
+        cl_q: Vec::new(),
+        cl_c: Vec::new(),
+        ps_i,
+        ps_j,
+        part_start,
+        part_mem,
+        strad,
+        sep_only,
+        parent_live,
+        maxw,
+        plim,
+        ccount,
+    }
+}
+
+/// npar: number_fast with its passes over the previous level and the parent level split across
+/// the threads (atomics for the per-parent sums; per-chunk partials for the per-cell ones).
+/// The part numbering stays serial (it is a sort of the few straddler members).
+fn number_par(
+    p: &View,
+    par: &Lvl,
+    active: Option<&[bool]>,
+    ncells: usize,
+    stats: bool,
+) -> Num {
+    use std::sync::atomic::{AtomicBool, AtomicI32, AtomicU32};
+    const MULTI: u32 = u32::MAX - 1;
+    let np = par.n as usize;
+    let nprev = p.n as usize;
+    let k = chunks_for(nprev.max(np));
+    if k <= 1 {
+        return number_fast(p, par, active, ncells, stats);
+    }
+    let fv = vec![NONE; np];
+    let wv = vec![0i32; np];
+    let mut cmap = vec![NONE; nprev];
+    let pl: Vec<AtomicBool> = (0..ncells).map(|_| AtomicBool::new(false)).collect();
+    let f: &[AtomicU32] = unsafe { &*(fv.as_slice() as *const [u32] as *const [AtomicU32]) };
+    let ws: &[AtomicI32] = unsafe { &*(wv.as_slice() as *const [i32] as *const [AtomicI32]) };
+    let xs = uniform(nprev, k);
+    let (pcell, ppa, pwx) = (p.cell, p.pa, p.w);
+    let (parcmap, parcell): (&[u32], &[u32]) = (&par.cmap, &par.cell);
+    {
+        let cm = SendPtr(cmap.as_mut_ptr());
+        par_run(k, |c| {
+            for x in xs[c]..xs[c + 1] {
+                let cc = pcell[x];
+                if cc == SEP {
+                    continue;
+                }
+                if let Some(a) = active {
+                    if !a[cc as usize] {
+                        continue;
+                    }
+                }
+                let pid = ppa.map_or(x, |pa| pa[x] as usize);
+                let q = parcmap[pid];
+                if q == NONE {
+                    pl[cc as usize].store(true, Relaxed);
+                    continue;
+                }
+                unsafe { *cm.g().add(x) = q };
+                let qi = q as usize;
+                ws[qi].fetch_add(pwx[x], Relaxed);
+                let mut cur = f[qi].load(Relaxed);
+                loop {
+                    let new = if cur == NONE || cur == cc { cc } else { MULTI };
+                    if new == cur {
+                        break;
+                    }
+                    match f[qi].compare_exchange_weak(cur, new, Relaxed, Relaxed) {
+                        Ok(_) => break,
+                        Err(v) => cur = v,
+                    }
+                }
+            }
+        });
+    }
+    let (f, ws) = (fv, wv);
+    let pw: &[i32] = &par.w;
+    let is_clean = |q: usize| f[q] < MULTI && ws[q] == pw[q];
+    let mut parts_sx: Vec<Vec<(u32, u32, u32)>> = (0..k).map(|_| Vec::new()).collect();
+    {
+        let ps = SendPtr(parts_sx.as_mut_ptr());
+        let cmr = &cmap;
+        par_run(k, |c| {
+            let o = unsafe { &mut *ps.g().add(c) };
+            for x in xs[c]..xs[c + 1] {
+                let q = cmr[x];
+                if q != NONE && !is_clean(q as usize) {
+                    o.push((q, pcell[x], x as u32));
+                }
+            }
+        });
+    }
+    let mut sx: Vec<(u32, u32, u32)> = parts_sx.concat();
+    sx.sort_unstable();
+    let mut part_q: Vec<u32> = Vec::new();
+    let mut part_c: Vec<u32> = Vec::new();
+    let mut part_w: Vec<i32> = Vec::new();
+    let mut part_start: Vec<u32> = Vec::new();
+    let mut part_mem: Vec<u32> = Vec::with_capacity(sx.len());
+    let mut last = (NONE, NONE);
+    for &(q, kc, x) in &sx {
+        if (q, kc) != last {
+            part_q.push(q);
+            part_c.push(p.cell[x as usize]);
+            part_w.push(0);
+            part_start.push(part_mem.len() as u32);
+            last = (q, kc);
+        }
+        cmap[x as usize] = (np + part_q.len() - 1) as u32;
+        part_mem.push(x);
+        *part_w.last_mut().unwrap() += p.w[x as usize];
+    }
+    part_start.push(part_mem.len() as u32);
+    let nparts = part_q.len();
+    let n = np + nparts;
+    let mut cell = vec![SEP; n];
+    let mut w = vec![0i32; n];
+    let mut pa = vec![NONE; n];
+    let qs = uniform(np, k);
+    // per chunk: maxw, ccount, (live, strad, sep_only, parent_live)
+    let mut acc: Vec<(Vec<i32>, Vec<u32>, [u64; 4])> = (0..k).map(|_| (vec![0i32; ncells], vec![0u32; ncells], [0u64; 4])).collect();
+    {
+        let (cp, wp2, pp, ap) = (SendPtr(cell.as_mut_ptr()), SendPtr(w.as_mut_ptr()), SendPtr(pa.as_mut_ptr()), SendPtr(acc.as_mut_ptr()));
+        let fr = &f;
+        par_run(k, |c| {
+            let a = unsafe { &mut *ap.g().add(c) };
+            for q in qs[c]..qs[c + 1] {
+                let fq = fr[q];
+                if stats {
+                    if parcell[q] != SEP {
+                        a.2[3] += 1;
+                    }
+                    if fq == NONE && parcell[q] != SEP {
+                        a.2[2] += 1;
+                    }
+                }
+                if fq == NONE {
+                    continue;
+                }
+                if is_clean(q) {
+                    unsafe {
+                        *cp.g().add(q) = fq;
+                        *wp2.g().add(q) = pw[q];
+                        *pp.g().add(q) = q as u32;
+                    }
+                    let m = &mut a.0[fq as usize];
+                    *m = (*m).max(pw[q]);
+                    a.1[fq as usize] += 1;
+                    a.2[0] += 1;
+                } else {
+                    a.2[1] += 1;
+                }
+            }
+        });
+    }
+    let mut maxw = vec![0i32; ncells];
+    let mut ccount = vec![0u32; ncells];
+    let mut tot = [0u64; 4];
+    for a in &acc {
+        for c in 0..ncells {
+            maxw[c] = maxw[c].max(a.0[c]);
+            ccount[c] += a.1[c];
+        }
+        for t in 0..4 {
+            tot[t] += a.2[t];
+        }
+    }
+    let mut live = tot[0];
+    for kk in 0..nparts {
+        let id = np + kk;
+        let c = part_c[kk] as usize;
+        cell[id] = part_c[kk];
+        w[id] = part_w[kk];
+        pa[id] = part_q[kk];
+        maxw[c] = maxw[c].max(part_w[kk]);
+        ccount[c] += 1;
+        live += 1;
+    }
+    let mut ps_i = Vec::new();
+    let mut ps_j = Vec::new();
+    if stats {
+        for kk in 0..nparts {
+            for &x in &part_mem[part_start[kk] as usize..part_start[kk + 1] as usize] {
+                ps_i.push(x as u64);
+                ps_j.push((np + kk) as u64);
+            }
+        }
+    }
+    let plim = (0..ncells as u32).filter(|&c| pl[c as usize].load(Relaxed)).collect();
+    if obrk("npar") {
+        w[0] += 1;
+    }
+    Num {
+        n: n as u64,
+        cmap,
+        w,
+        cell,
+        pa,
+        live,
+        ct_i: Vec::new(),
+        ct_j: Vec::new(),
+        cl_q: Vec::new(),
+        cl_c: Vec::new(),
+        ps_i,
+        ps_j,
+        part_start,
+        part_mem,
+        strad: tot[1],
+        sep_only: tot[2],
+        parent_live: tot[3],
+        maxw,
+        plim,
+        ccount,
+    }
+}
+
+/// book: drop the cells in `stop` from a numbering, as if they had been inactive when it ran
+/// (their clean ids become holes, their parts go and later parts move down).
+fn number_patch(
+    num: &mut Num,
+    p: &View,
+    np: usize,
+    stop: &[bool],
+) {
+    let nparts = num.part_start.len() - 1;
+    // new id of each part (NONE if removed)
+    let mut newid = vec![NONE; nparts];
+    let mut k2 = 0usize;
+    let mut new_start: Vec<u32> = Vec::with_capacity(nparts + 1);
+    let mut new_mem: Vec<u32> = Vec::with_capacity(num.part_mem.len());
+    for k in 0..nparts {
+        let c = num.cell[np + k] as usize;
+        if !stop[c] {
+            newid[k] = (np + k2) as u32;
+            new_start.push(new_mem.len() as u32);
+            new_mem.extend_from_slice(&num.part_mem[num.part_start[k] as usize..num.part_start[k + 1] as usize]);
+            num.cell[np + k2] = num.cell[np + k];
+            num.w[np + k2] = num.w[np + k];
+            num.pa[np + k2] = num.pa[np + k];
+            k2 += 1;
+        }
+    }
+    new_start.push(new_mem.len() as u32);
+    let n = np + k2;
+    num.cell.truncate(n);
+    num.w.truncate(n);
+    num.pa.truncate(n);
+    // clean ids of stopped cells become holes
+    for q in 0..np {
+        let c = num.cell[q];
+        if c != SEP && stop[c as usize] {
+            num.cell[q] = SEP;
+            num.w[q] = 0;
+            num.pa[q] = NONE;
+        }
+    }
+    // the map: stopped cells' vertices leave, part members move to their new ids
+    for x in 0..num.cmap.len() {
+        let y = num.cmap[x];
+        if y == NONE {
+            continue;
+        }
+        let c = p.cell[x];
+        if stop[c as usize] {
+            num.cmap[x] = NONE;
+        } else if y as usize >= np {
+            num.cmap[x] = newid[y as usize - np];
+        }
+    }
+    for c in 0..stop.len() {
+        if stop[c] {
+            num.ccount[c] = 0;
+        }
+    }
+    num.live = num.ccount.iter().map(|&x| x as u64).sum();
+    num.n = n as u64;
+    num.part_start = new_start;
+    num.part_mem = new_mem;
+    num.ps_i.clear();
+    num.ps_j.clear();
+}
+
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Mode {
+    B1,
+    B2,
+}
+
+/// C' (n_prev x n) packed from the numbering: row x holds cmap[x] when it is not NONE.
+fn pack_ct(
+    cmap: &[u32],
+    n: u64,
+) -> M {
+    let nprev = cmap.len();
+    if opt("npar") && !obrk("pk") {
+        return emit_csr(nprev, n, &[], nprev, true, |r0, r1, cols, _vals, cnt| {
+            for &y in &cmap[r0..r1] {
+                cnt.push(cols.len() as u32);
+                if y != NONE {
+                    cols.push(y);
+                }
+            }
+        });
+    }
+    let mut p: Vec<u32> = Vec::with_capacity(nprev + 1);
+    let mut j: Vec<u32> = Vec::with_capacity(nprev);
+    for &y in cmap {
+        p.push(j.len() as u32);
+        if y != NONE {
+            j.push(y);
+        }
+    }
+    p.push(j.len() as u32);
+    if obrk("pk") && j.len() > 1 {
+        j.swap(0, 1);
+    }
+    let nnz = j.len() as u64;
+    pack_csr(nprev as u64, n, MBuf::from_vec(p), MBuf::from_vec(j), nnz, None)
+}
+
+/// hb2: the child level in one pass over the parent level's CSR. Row q of a clean parent vertex
+/// keeps its entries to clean vertices of its own cell, then gets its straddler-part columns
+/// appended (part ids are above every parent id, so rows stay sorted). Part rows are contracted
+/// from the members' rows of the child's previous level.
+fn b2_splice(
+    p: &View,
+    par: &Lvl,
+    num: &Num,
+) -> M {
+    let np = par.n as usize;
+    let n = num.n as usize;
+    let nparts = n - np;
+    let pc = Csr::new(&par.a);
+    let xc = Csr::new(p.a);
+    // part rows, sorted by column, and their transposed entries in clean rows
+    let mut prow_p: Vec<u32> = Vec::with_capacity(nparts + 1);
+    let mut prow_j: Vec<u32> = Vec::new();
+    let mut prow_x: Vec<i32> = Vec::new();
+    let mut tcol: Vec<(u32, u32, i32)> = Vec::new();
+    {
+        let (xp, xj) = (xc.p(), xc.j());
+        let mut tmp: Vec<(u32, i32)> = Vec::new();
+        for k in 0..nparts {
+            prow_p.push(prow_j.len() as u32);
+            let s = (np + k) as u32;
+            tmp.clear();
+            for &x in &num.part_mem[num.part_start[k] as usize..num.part_start[k + 1] as usize] {
+                for kk in xp[x as usize] as usize..xp[x as usize + 1] as usize {
+                    let jj = num.cmap[xj[kk] as usize];
+                    if jj != NONE && jj != s {
+                        tmp.push((jj, xc.val(kk)));
+                    }
+                }
+            }
+            tmp.sort_unstable_by_key(|e| e.0);
+            let mut q = 0;
+            while q < tmp.len() {
+                let (jj, mut v) = tmp[q];
+                q += 1;
+                while q < tmp.len() && tmp[q].0 == jj {
+                    v += tmp[q].1;
+                    q += 1;
+                }
+                prow_j.push(jj);
+                prow_x.push(v);
+                if (jj as usize) < np {
+                    tcol.push((jj, s, v));
+                }
+            }
+        }
+        prow_p.push(prow_j.len() as u32);
+        tcol.sort_unstable_by_key(|e| (e.0, e.1));
+    }
+    // row starts of tcol per clean row, for chunked emission
+    let brk1 = obrk("hb2");
+    let est = pc.nnz + prow_j.len() + tcol.len();
+    let cell = &num.cell;
+    let (pc_r, tcol_r, prow) = (&pc, &tcol, (&prow_p, &prow_j, &prow_x));
+    let m = emit_csr(n, n as u64, pc.p(), est, false, |r0, r1, cols, vals, cnt| {
+        let (pp, pj) = (pc_r.p(), pc_r.j());
+        let mut tc = tcol_r.partition_point(|e| (e.0 as usize) < r0);
+        for i in r0..r1 {
+            cnt.push(cols.len() as u32);
+            if i < np {
+                let ci = cell[i];
+                if ci != SEP {
+                    for kk in pp[i] as usize..pp[i + 1] as usize {
+                        let q2 = pj[kk];
+                        if cell[q2 as usize] == ci && !(brk1 && i == 0) {
+                            cols.push(q2);
+                            vals.push(pc_r.val(kk));
+                        }
+                    }
+                }
+                while tc < tcol_r.len() && tcol_r[tc].0 as usize == i {
+                    cols.push(tcol_r[tc].1);
+                    vals.push(tcol_r[tc].2);
+                    tc += 1;
+                }
+            } else {
+                let k = i - np;
+                let (a0, a1) = (prow.0[k] as usize, prow.0[k + 1] as usize);
+                cols.extend_from_slice(&prow.1[a0..a1]);
+                vals.extend_from_slice(&prow.2[a0..a1]);
+            }
+        }
+    });
+    drop(xc);
+    drop(pc);
+    m
+}
+
+/// The child level's matrices from the numbering, every call timed.
+fn build_level(
+    mode: Mode,
+    p: &View,
+    par: &Lvl,
+    num: Num,
+    ncells: u64,
+    ops: &Ops,
+    t: &mut Timer,
+) -> Lvl {
+    let n = num.n;
+    let ct = t.time("ct_build", || {
+        if opt("pk") {
+            pack_ct(&num.cmap, n)
+        } else {
+            let c = M::new(t_i32(), p.n, n);
+            ok!(GxB_Matrix_build_Scalar(c.0, num.ct_i.as_ptr(), num.ct_j.as_ptr(), ops.one_i32, num.ct_i.len() as u64));
+            c.wait();
+            c
+        }
+    });
+    let a = match mode {
+        Mode::B1 => {
+            let tm = t.time("CA", || {
+                let tm = M::new(t_i32(), n, p.n);
+                ok!(GrB_mxm(tm.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, ct.0, p.a.0, GrB_DESC_T0));
+                tm.wait();
+                tm
+            });
+            let a = t.time("CAC'", || {
+                let a = M::new(t_i32(), n, n);
+                ok!(GrB_mxm(a.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, tm.0, ct.0, null()));
+                a.wait();
+                a
+            });
+            drop(tm);
+            if !brk("b1diag") {
+                t.time("offdiag", || {
+                    ok!(GrB_Matrix_select_INT64(a.0, null(), null(), GrB_OFFDIAG, a.0, 0, null()));
+                    a.wait();
+                });
+            }
+            a
+        }
+        Mode::B2 if opt("hb2") => t.time("b2_splice", || b2_splice(p, par, &num)),
+        Mode::B2 => {
+            let np = par.n;
+            // masked split of the parent's level: keep (q, q') when both are clean and in one cell
+            let m = t.time("m_build", || {
+                let m = M::new(t_i32(), np, ncells);
+                ok!(GxB_Matrix_build_Scalar(m.0, num.cl_q.as_ptr(), num.cl_c.as_ptr(), ops.one_i32, num.cl_q.len() as u64));
+                m.wait();
+                m
+            });
+            let z = t.time("split_mxm", || {
+                let z = M::new(t_i32(), np, np);
+                ok!(GrB_mxm(z.0, par.a.0, null(), GxB_ANY_PAIR_INT32, m.0, m.0, GrB_DESC_ST1));
+                z.wait();
+                z
+            });
+            drop(m);
+            let x = t.time("split_mult", || {
+                let x = M::new(t_i32(), np, np);
+                ok!(GrB_Matrix_eWiseMult_BinaryOp(x.0, null(), null(), GrB_FIRST_INT32, par.a.0, z.0, null()));
+                x.wait();
+                x
+            });
+            drop(z);
+            if n != np {
+                t.time("resize", || {
+                    ok!(GrB_Matrix_resize(x.0, n, n));
+                    x.wait();
+                });
+            }
+            if num.ps_i.is_empty() {
+                x
+            } else {
+                let y = t.time("strad", || {
+                    let cs = M::new(t_i32(), p.n, n);
+                    ok!(GxB_Matrix_build_Scalar(cs.0, num.ps_i.as_ptr(), num.ps_j.as_ptr(), ops.one_i32, num.ps_i.len() as u64));
+                    let t1 = M::new(t_i32(), n, p.n);
+                    ok!(GrB_mxm(t1.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, cs.0, p.a.0, GrB_DESC_T0));
+                    let rows = M::new(t_i32(), n, n);
+                    ok!(GrB_mxm(rows.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, t1.0, ct.0, null()));
+                    ok!(GrB_Matrix_select_INT64(rows.0, null(), null(), GrB_OFFDIAG, rows.0, 0, null()));
+                    if brk("nofill") {
+                        rows.wait();
+                        return rows;
+                    }
+                    let y = M::new(t_i32(), n, n);
+                    ok!(GrB_Matrix_eWiseAdd_BinaryOp(y.0, null(), null(), GrB_FIRST_INT32, rows.0, rows.0, GrB_DESC_T1));
+                    y.wait();
+                    y
+                });
+                t.time("union", || {
+                    let a = M::new(t_i32(), n, n);
+                    ok!(GrB_Matrix_eWiseAdd_BinaryOp(a.0, null(), null(), GrB_FIRST_INT32, x.0, y.0, null()));
+                    a.wait();
+                    a
+                })
+            }
+        }
+    };
+    let wv = if opt("pk") {
+        None
+    } else {
+        Some(t.time("w_build", || {
+            let ids: Vec<u64> = (0..n).filter(|&i| num.cell[i as usize] != SEP).collect();
+            let x: Vec<i32> = ids.iter().map(|&i| num.w[i as usize]).collect();
+            vec_i32(n, &ids, &x)
+        }))
+    };
+    let lv = Lvl { n, a, ct, wv, w: num.w, cell: num.cell, pa: num.pa, cmap: num.cmap, live: num.live, ccount: num.ccount };
+    hash_lvl(&lv);
+    lv
+}
+
+/// Straddler statistics for one child level (untimed; prep pass only).
+fn strad_line(
+    d: u32,
+    l: usize,
+    p: &View,
+    par: &Lvl,
+    num: &Num,
+) -> String {
+    let pdeg = row_degrees(&par.a);
+    let xdeg = row_degrees(p.a);
+    let mut strad_rows = 0u64;
+    for (q, &dg) in pdeg.iter().enumerate() {
+        if par.cell[q] != SEP && num.cell.get(q).is_none_or(|&c| c == SEP) {
+            strad_rows += dg as u64;
+        }
+    }
+    let rin: u64 = num.ps_i.iter().map(|&x| xdeg[x as usize] as u64).sum();
+    format!(
+        "STRAD depth={d} level={l} parent_live={} parent_nnz={} strad={} sep_only={} parts={} child_live={} strad_rows_nnz={strad_rows} prev_nnz={} rin={rin} parts_members={}",
+        num.parent_live,
+        par.a.nvals(),
+        num.strad,
+        num.sep_only,
+        num.n - par.n,
+        num.live,
+        p.a.nvals(),
+        num.ps_i.len()
+    )
+}
+
+/// B1 or B2 for every reused level of one depth: the parent's levels, down to R's stop rule
+/// (stop at the first level with <= `stop` live vertices) or the end of the parent's levels.
+#[allow(clippy::too_many_arguments)]
+fn build_reuse(
+    mode: Mode,
+    parent: &Hier,
+    l0: &L0,
+    ncells: usize,
+    stop: u64,
+    ops: &Ops,
+    t: &mut Timer,
+    mut stats: Option<&mut Vec<String>>,
+    d: u32,
+) -> Hier {
+    let mut h = Hier::default();
+    loop {
+        let l = h.levels.len() + 1;
+        let lv = {
+            let p = view(&h, l0, l - 1);
+            if p.live <= stop || l > parent.levels.len() {
+                break;
+            }
+            let par = &parent.levels[l - 1];
+            let num = t.time("number", || {
+                if opt("npar") {
+                    number_par(&p, par, None, ncells, stats.is_some())
+                } else if opt("book") {
+                    number_fast(&p, par, None, ncells, stats.is_some())
+                } else {
+                    number(&p, par, None, ncells)
+                }
+            });
+            if let Some(st) = stats.as_mut() {
+                st.push(strad_line(d, l, &p, par, &num));
+            }
+            build_level(mode, &p, par, num, ncells as u64, ops, t)
+        };
+        h.levels.push(lv);
+    }
+    h
+}
+
+/// Uncoarsening for reused levels, as R does it: random labels on the coarsest level (untimed),
+/// then per level mxv(C', labels) and the boundary mxv(A, labels). Returns the level-0 labels.
+fn project_b(
+    h: &Hier,
+    l0: &L0,
+    t: &mut Timer,
+) -> Option<V> {
+    let lr = h.levels.len();
+    if lr == 0 {
+        return None;
+    }
+    let top = &h.levels[lr - 1];
+    let mut rng = Rng(42);
+    let ids: Vec<u64> = (0..top.n).filter(|&i| top.cell[i as usize] != SEP).collect();
+    let x: Vec<i32> = ids.iter().map(|_| (rng.next() & 1) as i32).collect();
+    let mut lab = vec_i32(top.n, &ids, &x);
+    for s in (0..lr).rev() {
+        let v = view(h, l0, s);
+        let up = &h.levels[s];
+        let fine = t.time("project", || mxv_i32(&up.ct, &lab, false));
+        assert_eq!(fine.nvals(), v.live, "CHECK FAILED: projection lost vertices");
+        t.time("bnd", || {
+            let b = V::new(t_i32(), v.n);
+            ok!(GrB_mxv(b.0, null(), null(), GxB_PLUS_SECOND_INT32, v.a.0, fine.0, null()));
+            b.wait();
+        });
+        lab = fine;
+    }
+    Some(lab)
+}
+
+/// Why a capstop cell stopped reusing.
+const R_FLOOR: u8 = 1; // <= FLOOR coarse vertices: done, no fresh coarsening
+const R_CAP: u8 = 2; // the next level breaks the cap: fresh
+const R_PLIM: u8 = 3; // the parent cell has no next level (B2 needs it): fresh
+const R_END: u8 = 4; // no more levels: fresh
+const R_EMPTY: u8 = 5; // no live vertex
+
+struct CsOut {
+    h: Hier,
+    fresh_rows: Rows,
+    fresh_fp: Vec<(u64, u64, i64)>,
+    cells_fresh: u64,
+    g_n: u64,
+    /// per cell: (last reused level, reason)
+    stop: Vec<(u32, u8)>,
+    nreason: [u64; 6],
+}
+
+/// Capstop (the quality harness's `reuse_capstop`, single stage): a cell reuses the parent's next
+/// level by B2 while it has more than FLOOR coarse vertices and the next level keeps every one of
+/// its coarse vertices within `cap` (R's cap at this depth). A cell that breaks the cap, or whose
+/// parent has no next level, is gathered with the others that stopped and coarsened fresh with R's
+/// matching, as R coarsens all cells at once.
+#[allow(clippy::too_many_arguments)]
+fn build_capstop(
+    parent: &Hier,
+    l0: &L0,
+    ncells: usize,
+    cap: i32,
+    ops: &Ops,
+    t: &mut Timer,
+    ck: &mut Checks,
+    check: bool,
+) -> CsOut {
+    let lim = if brk("cap2") { 2 * cap as i64 } else { cap as i64 };
+    let mut active = vec![true; ncells];
+    let mut stop = vec![(u32::MAX, 0u8); ncells];
+    let mut fresh_at: Vec<Vec<u32>> = Vec::new();
+    let mut done_at: Vec<Vec<u32>> = Vec::new();
+    let mut h = Hier::default();
+    loop {
+        let l = h.levels.len() + 1;
+        while fresh_at.len() < l {
+            fresh_at.push(Vec::new());
+            done_at.push(Vec::new());
+        }
+        let lv = {
+            let p = view(&h, l0, l - 1);
+            let cnt = t.time("number", || {
+                let mut cnt = vec![0u64; ncells];
+                if opt("book") && l > 1 {
+                    for (c, &k) in h.levels[l - 2].ccount.iter().enumerate() {
+                        cnt[c] = k as u64;
+                    }
+                } else {
+                    for &c in p.cell {
+                        if c != SEP {
+                            cnt[c as usize] += 1;
+                        }
+                    }
+                }
+                cnt
+            });
+            let mut any_active = false;
+            for c in 0..ncells {
+                if !active[c] {
+                    continue;
+                }
+                if cnt[c] == 0 {
+                    active[c] = false;
+                    stop[c] = ((l - 1) as u32, R_EMPTY);
+                } else if cnt[c] <= FLOOR {
+                    active[c] = false;
+                    stop[c] = ((l - 1) as u32, R_FLOOR);
+                    done_at[l - 1].push(c as u32);
+                } else {
+                    any_active = true;
+                }
+            }
+            if !any_active {
+                break;
+            }
+            if l > parent.levels.len() {
+                let why = R_END;
+                for c in 0..ncells {
+                    if active[c] {
+                        active[c] = false;
+                        stop[c] = ((l - 1) as u32, why);
+                        fresh_at[l - 1].push(c as u32);
+                    }
+                }
+                break;
+            }
+            let par = &parent.levels[l - 1];
+            let book = opt("book");
+            let mut num = t.time("number", || {
+                if opt("npar") {
+                    number_par(&p, par, Some(&active), ncells, false)
+                } else if book {
+                    number_fast(&p, par, Some(&active), ncells, false)
+                } else {
+                    number(&p, par, Some(&active), ncells)
+                }
+            });
+            let mut newly = vec![false; ncells];
+            let mut any = false;
+            for &c in &num.plim {
+                let c = c as usize;
+                if active[c] {
+                    active[c] = false;
+                    newly[c] = true;
+                    stop[c] = ((l - 1) as u32, R_PLIM);
+                    fresh_at[l - 1].push(c as u32);
+                    any = true;
+                }
+            }
+            for c in 0..ncells {
+                if active[c] && num.maxw[c] as i64 > lim {
+                    active[c] = false;
+                    newly[c] = true;
+                    stop[c] = ((l - 1) as u32, R_CAP);
+                    fresh_at[l - 1].push(c as u32);
+                    any = true;
+                }
+            }
+            if any {
+                if !active.iter().any(|&a| a) {
+                    break;
+                }
+                if book {
+                    t.time("number", || number_patch(&mut num, &p, par.n as usize, &newly));
+                    if obrk("book") {
+                        num.w[0] += 1;
+                    }
+                } else {
+                    num = t.time("number", || number(&p, par, Some(&active), ncells));
+                }
+            }
+            build_level(Mode::B2, &p, par, num, ncells as u64, ops, t)
+        };
+        h.levels.push(lv);
+    }
+    let lr = h.levels.len();
+    for s in fresh_at.iter_mut().chain(done_at.iter_mut()) {
+        s.sort_unstable();
+    }
+    // gather the fresh cells' parts, each at its own last reused level
+    let mut blocks: Vec<(usize, Vec<u64>, u64)> = Vec::new();
+    let mut gw: Vec<i32> = Vec::new();
+    let mut cells_fresh = 0u64;
+    let mut dropped_first = false;
+    let (g, wg) = t.time("gfresh", || {
+        let mut flag = vec![false; ncells];
+        let mut parts: Vec<(usize, Vec<u64>)> = Vec::new();
+        for (s, cs) in fresh_at.iter().enumerate() {
+            if cs.is_empty() {
+                continue;
+            }
+            if brk("gfdrop") && !dropped_first {
+                dropped_first = true;
+                continue;
+            }
+            for &c in cs {
+                flag[c as usize] = true;
+            }
+            cells_fresh += cs.len() as u64;
+            let v = view(&h, l0, s);
+            let ids: Vec<u64> = (0..v.n).filter(|&x| v.cell[x as usize] != SEP && flag[v.cell[x as usize] as usize]).collect();
+            for &c in cs {
+                flag[c as usize] = false;
+            }
+            if !ids.is_empty() {
+                parts.push((s, ids));
+            }
+        }
+        let mut off = 0u64;
+        let g = if opt("gath") {
+            // append each block's rows with columns renumbered (blocks are closed: a stopped
+            // cell's vertices only link inside the cell)
+            let tot_rows: u64 = parts.iter().map(|x| x.1.len() as u64).sum();
+            let mut gp: Vec<u32> = Vec::with_capacity(tot_rows as usize + 1);
+            let mut gj: Vec<u32> = Vec::new();
+            let mut gx: Vec<i32> = Vec::new();
+            for (s, ids) in &parts {
+                let v = view(&h, l0, *s);
+                let vc = Csr::new(v.a);
+                let mut rank = vec![NONE; v.n as usize];
+                for (k, &x) in ids.iter().enumerate() {
+                    rank[x as usize] = k as u32;
+                }
+                let (vp, vj) = (vc.p(), vc.j());
+                for &x in ids {
+                    gp.push(gj.len() as u32);
+                    for kk in vp[x as usize] as usize..vp[x as usize + 1] as usize {
+                        let r = rank[vj[kk] as usize];
+                        if r != NONE {
+                            gj.push(off as u32 + r);
+                            gx.push(vc.val(kk));
+                        }
+                    }
+                }
+                gw.extend(ids.iter().map(|&x| v.w[x as usize]));
+                blocks.push((*s, ids.clone(), off));
+                off += ids.len() as u64;
+            }
+            gp.push(gj.len() as u32);
+            if obrk("gath") && gx.len() > 1 {
+                gx[0] += 1;
+            }
+            let nnz = gj.len() as u64;
+            pack_csr(off, off, MBuf::from_vec(gp), MBuf::from_vec(gj), nnz, Some(MBuf::from_vec(gx)))
+        } else {
+            let (mut gi, mut gj, mut gx) = (Vec::new(), Vec::new(), Vec::new());
+            for (s, ids) in &parts {
+                let v = view(&h, l0, *s);
+                let k = ids.len() as u64;
+                let e = M::new(t_i32(), k, k);
+                ok!(GrB_Matrix_extract(e.0, null(), null(), v.a.0, ids.as_ptr(), k, ids.as_ptr(), k, null()));
+                let (ei, ej, ex) = tuples(&e);
+                gi.extend(ei.iter().map(|&i| i + off));
+                gj.extend(ej.iter().map(|&j| j + off));
+                gx.extend(ex);
+                gw.extend(ids.iter().map(|&x| v.w[x as usize]));
+                blocks.push((*s, ids.clone(), off));
+                off += k;
+            }
+            let g = M::new(t_i32(), off, off);
+            ok!(GrB_Matrix_build_INT32(g.0, gi.as_ptr(), gj.as_ptr(), gx.as_ptr(), gi.len() as u64, null()));
+            g.wait();
+            g
+        };
+        let wg = if opt("pk") {
+            pack_full_i32(mbuf_from(&gw))
+        } else {
+            let ii: Vec<u64> = (0..off).collect();
+            vec_i32(off, &ii, &gw)
+        };
+        (g, wg)
+    });
+    if hash_on() {
+        hash_mat(&g);
+        hash_vec_i32(&wg);
+    }
+    let g_n = g.nrows();
+    let (fresh_rows, fresh_fp, glab) =
+        if g_n > 0 { hierarchy_keep(&g, Some((wg, gw.clone())), cap, FLOOR * cells_fresh, ops, None) } else { (Vec::new(), Vec::new(), Vec::new()) };
+    // projection through the reused levels; at each level, the cells that stopped there get their
+    // labels: fresh cells from the fresh hierarchy, done cells a random label (their bisection
+    // stand-in)
+    let inj = |s: usize, v: &View| -> Option<V> {
+        let mut ids: Vec<u64> = Vec::new();
+        let mut x: Vec<i32> = Vec::new();
+        if let Some(b) = blocks.iter().find(|b| b.0 == s) {
+            for (k, &id) in b.1.iter().enumerate() {
+                ids.push(id);
+                x.push(glab[b.2 as usize + k] as i32);
+            }
+        }
+        if !done_at[s].is_empty() {
+            let mut rng = Rng(42 + s as u64);
+            for xx in 0..v.n as usize {
+                let c = v.cell[xx];
+                if c != SEP && done_at[s].binary_search(&c).is_ok() {
+                    ids.push(xx as u64);
+                    x.push((rng.next() & 1) as i32);
+                }
+            }
+        }
+        if ids.is_empty() {
+            return None;
+        }
+        let mut pr: Vec<usize> = (0..ids.len()).collect();
+        pr.sort_unstable_by_key(|&k| ids[k]);
+        let ids2: Vec<u64> = pr.iter().map(|&k| ids[k]).collect();
+        let x2: Vec<i32> = pr.iter().map(|&k| x[k]).collect();
+        Some(vec_i32(v.n, &ids2, &x2))
+    };
+    let top = view(&h, l0, lr);
+    let mut lab = t.time("project", || inj(lr, &top).unwrap_or_else(|| V::new(t_i32(), top.n)));
+    for s in (0..lr).rev() {
+        let v = view(&h, l0, s);
+        let up = &h.levels[s];
+        let fine = t.time("project", || {
+            let f = mxv_i32(&up.ct, &lab, false);
+            match inj(s, &v) {
+                Some(gv) => {
+                    let u = V::new(t_i32(), v.n);
+                    ok!(GrB_Vector_eWiseAdd_BinaryOp(u.0, null(), null(), GrB_FIRST_INT32, f.0, gv.0, null()));
+                    w8v(&u);
+                    u
+                }
+                None => f,
+            }
+        });
+        if !brk("gfdrop") {
+            assert_eq!(fine.nvals(), v.live, "CHECK FAILED: capstop projection lost vertices");
+        }
+        t.time("bnd", || {
+            let b = V::new(t_i32(), v.n);
+            ok!(GrB_mxv(b.0, null(), null(), GxB_PLUS_SECOND_INT32, v.a.0, fine.0, null()));
+            b.wait();
+        });
+        lab = fine;
+    }
+    hash_vec_i32(&lab);
+    let mut nreason = [0u64; 6];
+    for &(_, r) in &stop {
+        nreason[r as usize] += 1;
+    }
+    if hash_on() {
+        hash_u64s(stop.iter().map(|&(a, b)| (a as u64) << 8 | b as u64));
+    }
+    if check {
+        // every reused level within the cap, per cell
+        for lv in &h.levels {
+            let mut mx = vec![0i64; ncells];
+            for (x, &c) in lv.cell.iter().enumerate() {
+                if c != SEP {
+                    mx[c as usize] = mx[c as usize].max(lv.w[x] as i64);
+                }
+            }
+            ck.cs_cap_checked += 1;
+            if mx.iter().any(|&m| m > cap as i64) {
+                ck.cs_cap_fail += 1;
+            }
+        }
+        // weight conservation: cells done at their stop level plus the fresh graph
+        let mut done_w = 0i64;
+        for (s, cs) in done_at.iter().enumerate() {
+            if cs.is_empty() {
+                continue;
+            }
+            let v = view(&h, l0, s);
+            for x in 0..v.n as usize {
+                if v.cell[x] != SEP && cs.binary_search(&v.cell[x]).is_ok() {
+                    done_w += v.w[x] as i64;
+                }
+            }
+        }
+        let gsum: i64 = gw.iter().map(|&x| x as i64).sum();
+        ck.cs_w_checked += 1;
+        if done_w + gsum != l0.live as i64 {
+            ck.cs_w_fail += 1;
+        }
+    }
+    CsOut { h, fresh_rows, fresh_fp, cells_fresh, g_n, stop, nreason }
+}
+
+/// The quality harness's capstop rule (`reuse_levels` under `reuse_capstop`, one stage, floor
+/// FLOOR), replayed on the host from the depth-0 maps: per cell, walk the depth-0 levels composed
+/// over the cell's live vertices; stop at <= FLOOR coarse vertices (done), at the last level
+/// (fresh), or before the first level whose heaviest coarse vertex exceeds the cap (fresh).
+/// `cap_of_cell(c, W_c)` gives the cap. Levels that merge nothing in a cell are walked through,
+/// as the harness skips them (they change neither size nor weights).
+fn rule_replay(
+    l0: &L0,
+    root_cmaps: &[Vec<u32>],
+    ncells: usize,
+    cap_of_cell: &dyn Fn(usize, i64) -> i64,
+) -> Vec<(u32, u8)> {
+    let nl = root_cmaps.len();
+    let mut wc = vec![0i64; ncells];
+    for v in 0..l0.n as usize {
+        if l0.cell[v] != SEP {
+            wc[l0.cell[v] as usize] += 1;
+        }
+    }
+    // per level: (count, max weight) per cell
+    let mut cnt: Vec<Vec<u64>> = vec![wc.iter().map(|&x| x as u64).collect()];
+    let mut mxw: Vec<Vec<i64>> = vec![wc.iter().map(|&x| (x > 0) as i64).collect()];
+    let mut anc: Vec<u32> = (0..l0.n as u32).collect();
+    let mut keys: Vec<u64> = Vec::with_capacity(l0.live as usize);
+    for cm in root_cmaps.iter().take(nl) {
+        keys.clear();
+        for v in 0..l0.n as usize {
+            if l0.cell[v] == SEP {
+                continue;
+            }
+            anc[v] = cm[anc[v] as usize];
+            keys.push(anc[v] as u64 * ncells as u64 + l0.cell[v] as u64);
+        }
+        keys.sort_unstable();
+        let mut c1 = vec![0u64; ncells];
+        let mut m1 = vec![0i64; ncells];
+        let mut q = 0;
+        while q < keys.len() {
+            let k = keys[q];
+            let mut r = q;
+            while r < keys.len() && keys[r] == k {
+                r += 1;
+            }
+            let c = (k % ncells as u64) as usize;
+            c1[c] += 1;
+            m1[c] = m1[c].max((r - q) as i64);
+            q = r;
+        }
+        cnt.push(c1);
+        mxw.push(m1);
+    }
+    (0..ncells)
+        .map(|c| {
+            let cap = cap_of_cell(c, wc[c]);
+            let mut s = 0usize;
+            loop {
+                if cnt[s][c] == 0 {
+                    return (s as u32, R_EMPTY);
+                }
+                if cnt[s][c] <= FLOOR {
+                    return (s as u32, R_FLOOR);
+                }
+                if s == nl {
+                    return (s as u32, R_END);
+                }
+                if mxw[s + 1][c] > cap {
+                    return (s as u32, R_CAP);
+                }
+                s += 1;
+            }
+        })
+        .collect()
+}
+
+#[derive(Default, Debug)]
+struct Checks {
+    split_fail: u64,
+    eq_levels: u64,
+    eq_fail: u64,
+    b1_checked: u64,
+    b1_invalid: u64,
+    w_fail: u64,
+    acct_levels: u64,
+    acct_fail: u64,
+    match_calls_b: u64,
+    cs_cap_checked: u64,
+    cs_cap_fail: u64,
+    cs_w_checked: u64,
+    cs_w_fail: u64,
+    sep_checked: u64,
+    sep_fail: u64,
+    fp_compared: u64,
+    fp_fail: u64,
+    hash_compared: u64,
+    hash_fail: u64,
+    rule_cells: u64,
+    rule_same: u64,
+    rule_plim: u64,
+    rule_fail: u64,
+    rule_percell_diff: u64,
+}
+
+/// B1 = B2 on every level (n, nvals, pattern and values); B1 valid (no diagonal, symmetric,
+/// weight conserved, host weights = C'^T w).
+fn compare(
+    h1: &Hier,
+    h2: &Hier,
+    l0: &L0,
+    ck: &mut Checks,
+) {
+    if h1.levels.len() != h2.levels.len() {
+        ck.eq_fail += 1;
+    }
+    for (l, (x, y)) in h1.levels.iter().zip(&h2.levels).enumerate() {
+        ck.eq_levels += 1;
+        if x.n != y.n || x.a.nvals() != y.a.nvals() || x.w != y.w || tuples(&x.a) != tuples(&y.a) {
+            ck.eq_fail += 1;
+        }
+        ck.b1_checked += 1;
+        let diag = M::new(t_i32(), x.n, x.n);
+        ok!(GrB_Matrix_select_INT64(diag.0, null(), null(), GrB_DIAG, x.a.0, 0, null()));
+        let at = M::new(t_i32(), x.n, x.n);
+        ok!(GrB_transpose(at.0, null(), null(), x.a.0, null()));
+        let wsum: i64 = x.w.iter().map(|&v| v as i64).sum();
+        let (dg, sym) = (diag.nvals(), tuples(&at) == tuples(&x.a));
+        if dg != 0 || !sym || wsum != l0.live as i64 {
+            if ck.b1_invalid < 3 {
+                println!("B1INVALID level={} diag={dg} symmetric={sym} wsum={wsum} live={}", l + 1, l0.live);
+            }
+            ck.b1_invalid += 1;
+        }
+        let prev = view(h1, l0, l);
+        let ids: Vec<u64> = (0..prev.n).filter(|&i| prev.cell[i as usize] != SEP).collect();
+        let pw: Vec<i32> = ids.iter().map(|&i| prev.w[i as usize]).collect();
+        let wv = mxv_i32(&x.ct, &vec_i32(prev.n, &ids, &pw), true);
+        let gw = dense_i32(&wv);
+        let ok_w = (0..x.n as usize).all(|i| gw.get(i).copied().unwrap_or(0) == x.w[i]);
+        if !ok_w {
+            ck.w_fail += 1;
+        }
+    }
+}
