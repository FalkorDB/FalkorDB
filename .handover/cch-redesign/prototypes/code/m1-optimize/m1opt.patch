+static SLOW_BORROW: AtomicUsize = AtomicUsize::new(0);
+
+/// A matrix's CSR arrays, borrowed in O(1) (GraphBLAS container unload); the matrix is restored on
+/// drop. Rows are sorted. 32-bit offsets and indices are read in place; anything else is copied.
+pub(super) struct Csr<'a> {
+    m: &'a M,
+    c: GxB_Container,
+    raw: [(*mut c_void, GrB_Type, u64, u64, i32); 3],
+    pub n: usize,
+    pub nnz: usize,
+    p: *const u32,
+    j: *const u32,
+    x: *const i32,
+    pub iso: bool,
+    own: Option<(Vec<u32>, Vec<u32>)>,
+}
+impl<'a> Csr<'a> {
+    pub fn new(m: &'a M) -> Csr<'a> {
+        m.wait(); // sorted rows, no zombies or pending tuples (a no-op when already so)
+        let mut c: GxB_Container = null();
+        ok!(GxB_Container_new(&mut c));
+        ok!(GxB_unload_Matrix_into_Container(m.0, c, null()));
+        let (fmt, ori) = unsafe { ((*c).format, (*c).orientation) };
+        if fmt != GxB_SPARSE as i32 || ori != GrB_Orientation::GrB_ROWMAJOR as i32 {
+            // convert once: reload, force sparse by row, unload again
+            ok!(GxB_load_Matrix_from_Container(m.0, c, null()));
+            ok!(GxB_Matrix_Option_set_INT32(m.0, GxB_Option_Field::GxB_SPARSITY_CONTROL as _, GxB_SPARSE as i32));
+            m.wait();
+            ok!(GxB_unload_Matrix_into_Container(m.0, c, null()));
+            SLOW_BORROW.fetch_add(1, Relaxed);
+            let (fmt, ori) = unsafe { ((*c).format, (*c).orientation) };
+            assert!(fmt == GxB_SPARSE as i32 && ori == GrB_Orientation::GrB_ROWMAJOR as i32, "Csr: not sparse by row");
+        }
+        let n = unsafe { (*c).nrows } as usize;
+        let iso = unsafe { (*c).iso };
+        assert!(!unsafe { (*c).jumbled }, "Csr: jumbled after wait");
+        let mut raw = [(null(), null(), 0u64, 0u64, 0i32); 3];
+        let vs = unsafe { [(*c).p, (*c).i, (*c).x] };
+        for (k, v) in vs.iter().enumerate() {
+            let r = &mut raw[k];
+            ok!(GxB_Vector_unload(*v, &mut r.0, &mut r.1, &mut r.2, &mut r.3, &mut r.4, null()));
+        }
+        let (pt, it, xt) = (raw[0].1, raw[1].1, raw[2].1);
+        assert!(xt == t_i32(), "Csr: values must be INT32");
+        let mut own = None;
+        let is32 = |t: GrB_Type| t == t_u32() || t == unsafe { GrB_INT32 };
+        let tname = |t: GrB_Type| {
+            let names = unsafe { [(GrB_UINT32, "u32"), (GrB_INT32, "i32"), (GrB_UINT64, "u64"), (GrB_INT64, "i64"), (GrB_BOOL, "bool")] };
+            names.iter().find(|x| x.0 == t).map_or("?", |x| x.1)
+        };
+        static SHOWN: AtomicUsize = AtomicUsize::new(0);
+        if SHOWN.fetch_add(1, Relaxed) < 3 {
+            println!("CSRTYPES p={} i={} x={}", tname(pt), tname(it), tname(xt));
+        }
+        let (p, j) = if is32(pt) && is32(it) {
+            (raw[0].0 as *const u32, raw[1].0 as *const u32)
+        } else {
+            SLOW_BORROW.fetch_add(1, Relaxed);
+            let rd = |ptr: *mut c_void, t: GrB_Type, k: usize| -> Vec<u32> {
+                if is32(t) {
+                    unsafe { std::slice::from_raw_parts(ptr as *const u32, k) }.to_vec()
+                } else if t == t_u64() || t == t_i64() {
+                    unsafe { std::slice::from_raw_parts(ptr as *const u64, k) }.iter().map(|&x| x as u32).collect()
+                } else {
+                    panic!("Csr: unexpected integer type {}", tname(t))
+                }
+            };
+            let pv = rd(raw[0].0, pt, n + 1);
+            let jv = rd(raw[1].0, it, raw[1].2 as usize);
+            let r = (pv.as_ptr(), jv.as_ptr());
+            own = Some((pv, jv));
+            r
+        };
+        let nnz = unsafe { *p.add(n) } as usize;
+        Csr { m, c, raw, n, nnz, p, j, x: raw[2].0 as *const i32, iso, own }
+    }
+    #[inline(always)]
+    pub fn p(&self) -> &[u32] {
+        unsafe { std::slice::from_raw_parts(self.p, self.n + 1) }
+    }
+    #[inline(always)]
+    pub fn j(&self) -> &[u32] {
+        unsafe { std::slice::from_raw_parts(self.j, self.nnz) }
+    }
+    /// Values (one entry when iso).
+    #[inline(always)]
+    pub fn x(&self) -> &[i32] {
+        unsafe { std::slice::from_raw_parts(self.x, if self.iso { 1 } else { self.nnz }) }
+    }
+    #[inline(always)]
+    pub fn val(
+        &self,
+        k: usize,
+    ) -> i32 {
+        if self.iso { unsafe { *self.x } } else { unsafe { *self.x.add(k) } }
+    }
+}
+unsafe impl Sync for Csr<'_> {}
+impl Drop for Csr<'_> {
+    fn drop(&mut self) {
+        let _ = self.own.take();
+        let vs = unsafe { [(*self.c).p, (*self.c).i, (*self.c).x] };
+        for (k, v) in vs.iter().enumerate() {
+            let r = &mut self.raw[k];
+            ok!(GxB_Vector_load(*v, &mut r.0, r.1, r.2, r.3, r.4, null()));
+        }
+        ok!(GxB_load_Matrix_from_Container(self.m.0, self.c, null()));
+        ok!(GxB_Container_free(&mut self.c));
+    }
+}
