+/// Run `f(chunk)` for chunk in 0..k on k threads (chunk 0 on this thread).
+fn par_run<F: Fn(usize) + Sync>(
+    k: usize,
+    f: F,
+) {
+    if k <= 1 {
+        f(0);
+        return;
+    }
+    std::thread::scope(|s| {
+        for c in 1..k {
+            let f = &f;
+            s.spawn(move || f(c));
+        }
+        f(0);
+    });
+}
+/// Uniform ranges of 0..n in k chunks.
+fn uniform(
+    n: usize,
+    k: usize,
+) -> Vec<usize> {
+    (0..=k).map(|c| n * c / k).collect()
+}
+/// Chunks for a host pass over `work` entries: 1 below the threshold or at 1 thread.
+fn chunks_for(work: usize) -> usize {
+    if opt("hpar") && nth() > 1 && work >= 100_000 { nth() } else { 1 }
+}
+/// Row ranges of `n` rows split into `k` chunks of about equal entry counts (by offsets `p`).
+fn row_splits(
+    p: &[u32],
+    k: usize,
+) -> Vec<usize> {
+    let n = p.len() - 1;
+    let tot = p[n] as u64;
+    let mut out = vec![0usize; k + 1];
+    for c in 1..k {
+        let target = (tot * c as u64 / k as u64) as u32;
+        out[c] = p.partition_point(|&x| x < target).min(n).max(out[c - 1]);
+    }
+    out[k] = n;
+    out
+}
+struct SendPtr<T>(*mut T);
+impl<T> SendPtr<T> {
+    /// The pointer (a method, so closures capture the whole Sync wrapper).
+    fn g(&self) -> *mut T {
+        self.0
+    }
+}
+unsafe impl<T> Sync for SendPtr<T> {}
+unsafe impl<T> Send for SendPtr<T> {}
