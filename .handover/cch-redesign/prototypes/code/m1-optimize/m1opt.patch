+// ---- host buffers in GraphBLAS's allocator (libc malloc in tests; RedisAlloc in the module) ----
+pub(super) struct MBuf<T: Copy> {
+    ptr: *mut T,
+    len: usize,
+    cap: usize,
+}
+impl<T: Copy> MBuf<T> {
+    fn new(len: usize) -> MBuf<T> {
+        let bytes = (len.max(1)) * std::mem::size_of::<T>();
+        let ptr = unsafe { malloc(bytes) as *mut T };
+        assert!(!ptr.is_null(), "malloc {bytes}");
+        MBuf { ptr, len, cap: len.max(1) }
+    }
+    /// A Vec's buffer, handed over without a copy: the test binary's Rust allocator is libc
+    /// malloc, the same allocator GraphBLAS was initialized with (`test_init`).
+    fn from_vec(mut v: Vec<T>) -> MBuf<T> {
+        if v.capacity() == 0 {
+            return MBuf::new(0);
+        }
+        let (ptr, len, cap) = (v.as_mut_ptr(), v.len(), v.capacity());
+        std::mem::forget(v);
+        MBuf { ptr, len, cap }
+    }
+    fn s(&mut self) -> &mut [T] {
+        unsafe { std::slice::from_raw_parts_mut(self.ptr, self.len) }
+    }
+    fn bytes(&self) -> u64 {
+        (self.cap * std::mem::size_of::<T>()) as u64
+    }
+    /// Hand the buffer to GraphBLAS.
+    fn take(mut self) -> *mut c_void {
+        let p = self.ptr;
+        self.ptr = null();
+        p as *mut c_void
+    }
+}
+impl<T: Copy> Drop for MBuf<T> {
+    fn drop(&mut self) {
+        if !self.ptr.is_null() {
+            unsafe { free(self.ptr as *mut c_void) };
+        }
+    }
+}
