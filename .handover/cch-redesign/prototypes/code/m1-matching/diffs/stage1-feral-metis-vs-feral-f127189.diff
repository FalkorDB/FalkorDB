+/// Bijective 32-bit mix (murmur3 fmix32 after a salt xor): every step
+/// is invertible mod 2^32, so distinct ids get distinct scrambles and
+/// the keys `(w << 32) | scramble(u)` are unique within a row.
+#[inline]
+fn scramble(u: Idx, salt: u32) -> u64 {
+    let mut x = (u as u32) ^ salt;
+    x ^= x >> 16;
+    x = x.wrapping_mul(0x85EB_CA6B);
+    x ^= x >> 13;
+    x = x.wrapping_mul(0xC2B2_AE35);
+    x ^= x >> 16;
+    x as u64
+}
+
+#[inline]
+fn key(w: Idx, u: Idx, salt: u32, invert: bool) -> u64 {
+    let w = w.clamp(0, u32::MAX as Idx) as u64;
+    let w = if invert { u32::MAX as u64 - w } else { w };
+    (w << 32) | scramble(u, salt)
+}
+
+/// The design's matching (§3 step 3), round synchronous, exactly what
+/// the GraphBLAS formulation computes:
+///
+/// * every unmatched vertex proposes to its unmatched neighbour with
+///   the largest unique key `(w << 32) | scramble(u)` among those the
+///   cap allows (`y<unmatched> = K MAX_FIRST unmatched`);
+/// * mutual proposals match (`p(p(v)) == v`);
+/// * repeat over the still-unmatched, up to `mm_round_cap` rounds
+///   (0 = until a round has no proposer, a maximal matching).
+///
+/// Proposals of one round all read the matched set as it was at the
+/// start of the round, so the result does not depend on visit order or
+/// thread count. A round with at least one proposer always matches a
+/// pair (keys strictly increase along a proposal chain, so it ends in
+/// a 2-cycle), so the unbounded loop terminates.
+///
+/// Then a 2-hop pass when the level shrinks under 15 % (same threshold
+/// as SHEM): unmatched vertices group by their heaviest neighbour
+/// (anchor, unique key, matched or not) and pair consecutively in
+/// scramble order within a group, subject to the cap. This is a
+/// GraphBLAS-expressible pass (build anchor x scramble, sort rows, pair
+/// by position parity); `mm_seq_two_hop` swaps in feral's sequential
+/// pass instead.
+fn mutual_max_level(
+    fine: &Graph,
+    rng: &mut SplitMix,
+    opts: &MetisOptions,
+    cap: Option<Idx>,
+    counters: &mut CoarsenCounters,
+) -> (CoarseGraph, MatchInfo) {
+    let mut info = MatchInfo::default();
+    let n = fine.nvtxs as usize;
+    let salt = rng.next_u64() as u32;
+    let invert = opts.mm_invert_weight;
+    let mut match_: Vec<Idx> = vec![UNMATCHED; n];
+    let mut prop: Vec<Idx> = vec![-1; n];
+    let ok = |v: usize, u: usize| cap.is_none_or(|c| fine.vwgt[v] + fine.vwgt[u] <= c);
+
+    let mut active: Vec<Idx> = (0..fine.nvtxs).collect();
+    let mut next: Vec<Idx> = Vec::with_capacity(n);
+    let mut rounds = 0u32;
+    loop {
+        if active.is_empty() {
+            break;
+        }
+        if opts.mm_round_cap != 0 && rounds == opts.mm_round_cap {
+            info.capped = true;
+            break;
+        }
+        rounds += 1;
+        // Propose: read-only over match_.
+        next.clear();
+        for &v in &active {
+            let vu = v as usize;
+            let lo = fine.xadj[vu] as usize;
+            let hi = fine.xadj[vu + 1] as usize;
+            let mut best: Idx = -1;
+            let mut best_k: u64 = 0;
+            for k in lo..hi {
+                let u = fine.adjncy[k];
+                let uu = u as usize;
+                if match_[uu] != UNMATCHED {
+                    continue;
+                }
+                if !ok(vu, uu) {
+                    if rounds == 1 {
+                        info.cap_refusals += 1;
+                    }
+                    continue;
+                }
+                let kk = key(fine.adjwgt[k], u, salt, invert);
+                if best < 0 || kk > best_k {
+                    best = u;
+                    best_k = kk;
+                }
+            }
+            prop[vu] = best;
+            if best >= 0 {
+                next.push(v);
+            }
+        }
+        // A vertex with no candidate now never gets one: the unmatched
+        // set only shrinks and the cap is symmetric.
+        // Match mutual pairs.
+        let mut matched = 0usize;
+        for &v in &next {
+            let p = prop[v as usize];
+            if v < p && prop[p as usize] == v {
+                match_[v as usize] = p;
+                match_[p as usize] = v;
+                matched += 1;
+            }
+        }
+        assert!(next.is_empty() || matched > 0, "mutual-max round made no progress");
+        std::mem::swap(&mut active, &mut next);
+        active.retain(|&v| match_[v as usize] == UNMATCHED);
+    }
+    info.rounds = rounds;
+    for v in 0..n {
+        if match_[v] == UNMATCHED {
+            match_[v] = v as Idx;
+        }
+    }
+    let mut cmap: Vec<Idx> = vec![-1; n];
+    let mut cnvtxs = renumber(&match_, &mut cmap);
+    info.n_after_match = cnvtxs;
+
+    let reduction_ratio = cnvtxs as f64 / fine.nvtxs.max(1) as f64;
+    if reduction_ratio > opts.two_hop_ratio_threshold && fine.nvtxs >= 4 {
+        counters.n_two_hop_fallbacks += 1;
+        info.two_hop = true;
+        cnvtxs = if opts.mm_seq_two_hop {
+            two_hop_pass(fine, &mut match_, &mut cmap)
+        } else {
+            parallel_two_hop(fine, &mut match_, &mut cmap, salt, cap)
+        };
+    }
+    let graph = contract(fine, &cmap, cnvtxs);
+    (CoarseGraph { graph, cmap }, info)
+}
+
+/// Coarse ids in fine-id order from a complete `match_`.
+fn renumber(match_: &[Idx], cmap: &mut [Idx]) -> Idx {
+    cmap.iter_mut().for_each(|c| *c = -1);
+    let mut cnvtxs: Idx = 0;
+    for v in 0..match_.len() {
+        if cmap[v] >= 0 {
+            continue;
+        }
+        cmap[v] = cnvtxs;
+        let u = match_[v];
+        if u != v as Idx {
+            cmap[u as usize] = cnvtxs;
+        }
+        cnvtxs += 1;
+    }
+    cnvtxs
+}
+
+/// GraphBLAS-style 2-hop: each self-matched vertex with a neighbour
+/// takes its heaviest neighbour (unique key) as anchor; vertices of the
+/// same anchor, in scramble order, pair 1-2, 3-4, ... when the cap
+/// allows.
+fn parallel_two_hop(
+    fine: &Graph,
+    match_: &mut [Idx],
+    cmap: &mut [Idx],
+    salt: u32,
+    cap: Option<Idx>,
+) -> Idx {
+    let n = fine.nvtxs as usize;
+    let mut tuples: Vec<(Idx, u64, Idx)> = Vec::new();
+    for v in 0..n {
+        if match_[v] != v as Idx {
+            continue;
+        }
+        let lo = fine.xadj[v] as usize;
+        let hi = fine.xadj[v + 1] as usize;
+        let mut best: Idx = -1;
+        let mut best_k = 0u64;
+        for k in lo..hi {
+            let u = fine.adjncy[k];
+            let kk = key(fine.adjwgt[k], u, salt, false);
+            if best < 0 || kk > best_k {
+                best = u;
+                best_k = kk;
+            }
+        }
+        if best >= 0 {
+            tuples.push((best, scramble(v as Idx, salt ^ 0x5bd1_e995), v as Idx));
+        }
+    }
+    tuples.sort_unstable();
+    let mut i = 0;
+    while i + 1 < tuples.len() {
+        let (a, _, v) = tuples[i];
+        let (b, _, w) = tuples[i + 1];
+        if a == b && cap.is_none_or(|c| fine.vwgt[v as usize] + fine.vwgt[w as usize] <= c) {
+            match_[v as usize] = w;
+            match_[w as usize] = v;
+            i += 2;
+        } else {
+            i += 1;
+        }
+    }
+    renumber(match_, cmap)
+}
