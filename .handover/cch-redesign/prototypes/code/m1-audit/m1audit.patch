+#[test]
+#[ignore]
+fn m1_reuse() {
+    ensure_init();
+    jit_setup();
+    println!("CT: {}", ct());
+    let path = env("M1_GRAPH").expect("M1_GRAPH");
+    let t = Instant::now();
