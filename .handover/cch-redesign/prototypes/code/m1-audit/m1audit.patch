+fn mat_tuples(m: &M) -> (Vec<u64>, Vec<u64>, Vec<i32>) {
+    let mut n = m.nvals();
+    let mut i = vec![0u64; n as usize];
+    let mut j = vec![0u64; n as usize];
+    let mut x = vec![0i32; n as usize];
+    ok!(GrB_Matrix_extractTuples_INT32(i.as_mut_ptr(), j.as_mut_ptr(), x.as_mut_ptr(), &mut n, m.0));
+    let sorted = i.windows(2).zip(j.windows(2)).all(|(a, b)| (a[0], b[0]) < (a[1], b[1]));
+    if !sorted {
+        let mut p: Vec<usize> = (0..i.len()).collect();
+        p.sort_unstable_by_key(|&k| (i[k], j[k]));
+        let i2 = p.iter().map(|&k| i[k]).collect();
+        let j2 = p.iter().map(|&k| j[k]).collect();
+        let x2 = p.iter().map(|&k| x[k]).collect();
+        return (i2, j2, x2);
+    }
+    (i, j, x)
