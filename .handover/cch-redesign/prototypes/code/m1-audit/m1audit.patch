+struct LevelOut {
+    c: M,
+    ac: M,
+    wc: V,
+    rounds: u32,
+    twohop: bool,
+    pairs: u64,
+}
+
+/// Number of coarsen_level calls (matching runs) so far; B1/B2 must never add to it.
+static MATCH_CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// One coarsening level, steps (1)-(2) of design §3, every call timed.
+fn coarsen_level(
+    a: &M,
+    w: &V,
+    cap: i32,
+    salt: u64,
+    ops: &Ops,
+    t: &mut Timer,
+) -> LevelOut {
+    MATCH_CALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let n = a.nrows();
+    // (1a) cap mask: S(i,j) = w(i)+w(j) on A's pattern, keep <= cap. Skipped when no pair can exceed it.
+    let mut maxw = 0i32;
+    ok!(GrB_Vector_reduce_INT32(&mut maxw, null(), GrB_MAX_MONOID_INT32, w.0, null()));
+    let mcap = if 2 * maxw as i64 > cap as i64 {
+        Some(t.time("cap", || {
+            let mut d = null();
+            ok!(GrB_Matrix_diag(&mut d, w.0, 0));
+            let d = M(d);
+            let left = M::new(t_i32(), n, n);
+            ok!(GrB_mxm(left.0, null(), null(), GxB_PLUS_FIRST_INT32, d.0, a.0, null()));
+            let right = M::new(t_i32(), n, n);
+            ok!(GrB_mxm(right.0, null(), null(), GxB_PLUS_SECOND_INT32, a.0, d.0, null()));
+            let s = M::new(t_i32(), n, n);
+            ok!(GrB_Matrix_eWiseMult_BinaryOp(s.0, null(), null(), GrB_PLUS_INT32, left.0, right.0, null()));
+            ok!(GrB_Matrix_select_INT32(s.0, null(), null(), GrB_VALUELE_INT32, s.0, cap, null()));
+            s.wait();
+            s
+        }))
+    } else {
+        None
+    };
+    let mut at = Timer::default();
+    if let Some(s_off) = mcap.as_ref().filter(|_| audit("cap")) {
+        abeg("cap");
+        let s2 = at.time("q_cap_rowcol", || {
+            let mut d = null();
+            ok!(GrB_Matrix_diag(&mut d, w.0, 0));
+            let d = M(d);
+            let s2 = M::new(t_i32(), n, n);
+            ok!(GrB_mxm(s2.0, null(), null(), GxB_PLUS_FIRST_INT32, d.0, a.0, null()));
+            let sr = unsafe { if abrk("cap") { GxB_PLUS_FIRST_INT32 } else { GxB_PLUS_PLUS_INT32 } };
+            ok!(GrB_mxm(s2.0, null(), null(), sr, s2.0, d.0, null()));
+            ok!(GrB_Matrix_select_INT32(s2.0, null(), null(), GrB_VALUELE_INT32, s2.0, cap, null()));
+            s2.wait();
+            s2
+        });
+        aend();
+        assert!(tup_i32(&s2) == tup_i32(s_off), "AUDIT CHECK FAILED: cap mask by row/col scale differs");
+    }
+    // (1b) keys by a user positional op.
+    let k = t.time("key", || {
+        let k = M::new(t_u64(), n, n);
+        let mask = mcap.as_ref().map_or(null(), |m| m.0);
+        let desc = if mcap.is_some() { unsafe { GrB_DESC_S } } else { null() };
+        ok!(GrB_Matrix_apply_IndexOp_UINT64(k.0, mask, null(), ops.key, a.0, salt, desc));
+        k.wait();
+        k
+    });
+    drop(mcap);
+    let idx = t.time("idx", || index_vector(n));
+    let mate = idx.dup();
+    let mut u = idx.dup();
+    // (1c) rounds of mutual-max proposals until a round matches nothing.
+    let mut rounds = 0;
+    let mut matched = 0u64;
+    // zmatch probe: Z = mate overlaid with this round's proposals; the mutual test reads Z(Z)
+    let mut zv = if audit("zmatch") && !brk("nomutual") { Some(idx.dup()) } else { None };
+    loop {
+        rounds += 1;
+        let y = V::new(t_u64(), n);
+        t.time("mxv", || {
+            ok!(GrB_mxv(y.0, u.0, null(), GxB_MAX_FIRST_UINT64, k.0, u.0, GrB_DESC_RS));
+            y.wait();
+        });
+        let np = y.nvals();
+        if burble() {
+            println!("@@NP round={rounds} n={n} proposers={np}");
+        }
+        if np == 0 {
+            break;
+        }
+        t.time("m_unkey", || {
+            ok!(GrB_Vector_apply_IndexOp_UINT64(y.0, null(), null(), ops.unkey, y.0, salt, null()));
+            y.wait();
+        });
+        let m = V::new(t_bool(), n);
+        if brk("nomutual") {
+            ok!(GrB_Vector_assign_BOOL(m.0, y.0, null(), true, GrB_ALL, n, GrB_DESC_S));
+        } else {
+            let pf = t.time("m_full", || {
+                let pf = V::new(t_u64(), n);
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(pf.0, null(), null(), GrB_SECOND_UINT64, idx.0, y.0, null()));
+                pf.wait();
+                pf
+            });
+            let q = t.time("m_extract", || {
+                let q = V::new(t_u64(), n);
+                ok!(GxB_Vector_extract_Vector(q.0, null(), null(), pf.0, pf.0, null()));
+                q.wait();
+                q
+            });
+            t.time("m_eq", || {
+                ok!(GrB_Vector_eWiseMult_BinaryOp(m.0, y.0, null(), GrB_EQ_UINT64, q.0, idx.0, GrB_DESC_RS));
+                m.wait();
+            });
+        }
+        if let Some(z) = zv.as_mut() {
+            abeg("zmatch");
+            let z2 = at.time("z_add", || {
+                let z2 = V::new(t_u64(), n);
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(z2.0, null(), null(), GrB_SECOND_UINT64, z.0, y.0, null()));
+                z2.wait();
+                z2
+            });
+            *z = z2;
+            let qz = at.time("z_gather", || {
+                let qz = V::new(t_u64(), n);
+                ok!(GxB_Vector_extract_Vector(qz.0, null(), null(), z.0, z.0, null()));
+                qz.wait();
+                qz
+            });
+            let mz = at.time("z_eq", || {
+                let mz = V::new(t_bool(), n);
+                ok!(GrB_Vector_eWiseMult_BinaryOp(mz.0, y.0, null(), GrB_EQ_UINT64, qz.0, idx.0, GrB_DESC_RS));
+                mz.wait();
+                mz
+            });
+            aend();
+            let tb = |v: &V| {
+                let mut k = v.nvals();
+                let mut i = vec![0u64; k as usize];
+                let mut x = vec![false; k as usize];
+                ok!(GrB_Vector_extractTuples_BOOL(i.as_mut_ptr(), x.as_mut_ptr(), &mut k, v.0));
+                (i, x)
+            };
+            assert!(tb(&mz) == tb(&m), "AUDIT CHECK FAILED: zmatch mutual test differs (round {rounds})");
+        }
+        let mate_before = if audit("match") && !brk("nomutual") { Some((mate.dup(), mate.dup())) } else { None };
+        t.time("m_assign", || {
+            ok!(GrB_Vector_assign(mate.0, m.0, null(), y.0, GrB_ALL, n, null()));
+            mate.wait();
+        });
+        let u2 = t.time("m_unext", || {
+            let u2 = V::new(t_u64(), n);
+            ok!(GrB_Vector_apply(u2.0, m.0, null(), GrB_IDENTITY_UINT64, y.0, GrB_DESC_RC));
+            u2.wait();
+            u2
+        });
+        if let Some((mb, mb2)) = mate_before {
+            abeg("match");
+            let want = !abrk("match");
+            let ms = at.time("a_sel_true", || {
+                let ms = V::new(t_bool(), n);
+                ok!(GrB_Vector_select_BOOL(ms.0, null(), null(), GrB_VALUEEQ_BOOL, m.0, want, null()));
+                ms.wait();
+                ms
+            });
+            at.time("a_assign_accum", || {
+                ok!(GrB_Vector_assign(mb.0, ms.0, GrB_SECOND_UINT64, y.0, GrB_ALL, n, GrB_DESC_S));
+                mb.wait();
+            });
+            at.time("a_emult_add", || {
+                let ym = V::new(t_u64(), n);
+                ok!(GrB_Vector_eWiseMult_BinaryOp(ym.0, null(), null(), GrB_FIRST_UINT64, y.0, ms.0, null()));
+                let op = unsafe { if abrk("matche") { GrB_FIRST_UINT64 } else { GrB_SECOND_UINT64 } };
+                ok!(GrB_Vector_eWiseAdd_BinaryOp(mb2.0, null(), null(), op, mb2.0, ym.0, null()));
