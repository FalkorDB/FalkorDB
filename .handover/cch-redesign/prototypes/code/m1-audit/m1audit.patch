+/// Coarsen `a0` to <= stop vertices or < 5 % shrink, then project a random 2-way label back.
+/// Returns per-level timers (level 0 = finest), the fingerprint and the level-0 label.
+fn hierarchy(
+    a0: &M,
+    cap: i32,
+    stop: u64,
+    ops: &Ops,
+) -> (Vec<(u64, u64, u32, bool, Timer)>, Vec<(u64, u64, i64)>, Vec<u32>) {
+    hierarchy_keep(a0, cap, stop, ops, None)
+}
+
+/// The levels R built, handed to the reuse paths: (A_l or null for the input, w_l, C_l: l -> l+1), A_L, w_L.
+type Kept = (Vec<(M, V, M)>, Option<M>, V);
+
+fn hierarchy_keep(
+    a0: &M,
+    cap: i32,
+    stop: u64,
+    ops: &Ops,
+    keep: Option<&mut Option<Kept>>,
+) -> (Vec<(u64, u64, u32, bool, Timer)>, Vec<(u64, u64, i64)>, Vec<u32>) {
+    let n0 = a0.nrows();
+    let w0 = V::new(t_i32(), n0);
+    ok!(GrB_Vector_assign_INT32(w0.0, null(), null(), 1, GrB_ALL, n0, null()));
+    let mut levels: Vec<(M, V, M)> = Vec::new(); // (A_l, w_l, C_l)
+    let mut rows = Vec::new();
+    let mut fp = Vec::new();
+    let mut a = None::<M>;
+    let mut w = w0;
+    static CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    let call = CALLS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    let mut salt = if brk("salt") { 0x5EED_u64 + call } else { 0x5EED_u64 };
+    loop {
+        let cur: &M = a.as_ref().unwrap_or(a0);
+        let n = cur.nrows();
+        if n <= stop || rows.len() >= 200 {
+            break;
+        }
+        let mut t = Timer::default();
+        salt = salt.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) >> 1;
+        let out = coarsen_level(cur, &w, cap, salt & 0xFFFF_FFFF, ops, &mut t);
+        let nc = out.ac.nrows();
+        rows.push((n, cur.nvals(), out.rounds, out.twohop, t));
+        fp.push((nc, out.ac.nvals(), out.ac.sum()));
+        let _ = out.pairs;
+        let prev_a = a.take();
+        let prev_w = std::mem::replace(&mut w, out.wc);
+        // keep A_l (None for the input) and C_l for the projection
+        levels.push((prev_a.unwrap_or_else(|| M(null())), prev_w, out.c));
+        a = Some(out.ac);
+        if nc * 100 > 95 * n {
+            break;
+        }
+    }
+    // (3) projection: random labels on the coarsest level, then mxv(C', labels) per level.
+    let top = a.as_ref().map_or(n0, |m| m.nrows());
+    let mut rng = Rng(42);
+    let lab: Vec<i32> = (0..top).map(|_| (rng.next() & 1) as i32).collect();
+    let ii: Vec<u64> = (0..top).collect();
+    let mut lv = V::new(t_i32(), top);
+    ok!(GrB_Vector_build_INT32(lv.0, ii.as_ptr(), lab.as_ptr(), top, null()));
+    for (l, (al, _wl, cl)) in levels.iter().enumerate().rev() {
+        let nf = rows[l].0;
+        let t = &mut rows[l].4;
+        let fine = t.time("project", || {
+            let f = V::new(t_i32(), nf);
+            let d = if ct() { null() } else { unsafe { GrB_DESC_T0 } };
+            ok!(GrB_mxv(f.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, cl.0, lv.0, d));
+            f.wait();
+            f
+        });
+        assert_eq!(fine.nvals(), nf, "CHECK FAILED: projection lost vertices");
+        let am = if al.0.is_null() { a0.0 } else { al.0 };
+        t.time("bnd", || {
+            let b = V::new(t_i32(), nf);
+            ok!(GrB_mxv(b.0, null(), null(), GxB_PLUS_SECOND_INT32, am, fine.0, null()));
+            b.wait();
+        });
+        lv = fine;
+    }
+    let (_, l0) = lv.i32s();
+    if let Some(k) = keep {
+        *k = Some((levels, a, w));
+    }
+    (rows, fp, l0.into_iter().map(|x| x as u32).collect())
+}
