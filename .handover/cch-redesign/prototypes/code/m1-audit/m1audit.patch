+}
+
+/// Depth 0's hierarchy as a parent for depth 1: the matrices R built, plus host maps and weights.
+fn depth0_parent(
+    a0: &Rc<M>,
+    kept: Kept,
+    t: &mut Timer,
+) -> Vec<HLevel> {
+    let (levels, a_top, w_top) = kept;
+    let nl = levels.len();
+    let mut mats: Vec<Rc<M>> = vec![a0.clone()];
+    let mut ws: Vec<V> = Vec::new();
+    let mut cs: Vec<M> = Vec::new();
+    for (i, (al, wl, cl)) in levels.into_iter().enumerate() {
+        if i > 0 {
+            mats.push(Rc::new(al));
+        }
+        ws.push(wl);
+        cs.push(cl);
+    }
+    if let Some(a) = a_top {
+        mats.push(Rc::new(a));
+    }
+    ws.push(w_top);
+    assert_eq!(mats.len(), nl + 1);
+    t.time("keep", || {
+        let mut out = Vec::new();
+        for l in 0..=nl {
+            let dim = mats[l].nrows() as usize;
+            let (wi, wx) = ws[l].i32s();
+            assert_eq!(wi.len(), dim, "weights not full");
+            let up = if l == 0 {
+                Vec::new()
+            } else {
+                let c = &cs[l - 1];
+                let mut k = c.nvals();
+                let mut ii = vec![0u64; k as usize];
+                let mut jj = vec![0u64; k as usize];
+                ok!(GrB_Matrix_extractTuples_INT32(ii.as_mut_ptr(), jj.as_mut_ptr(), null(), &mut k, c.0));
+                let nprev = mats[l - 1].nrows() as usize;
+                let mut up = vec![OUT; nprev];
+                if ct() {
+                    for q in 0..k as usize {
+                        up[ii[q] as usize] = jj[q] as u32;
+                    }
+                } else {
+                    for q in 0..k as usize {
+                        up[jj[q] as usize] = ii[q] as u32;
+                    }
+                }
+                assert!(up.iter().all(|&x| x != OUT), "C does not cover every vertex");
+                up
+            };
+            out.push(HLevel {
+                dim,
+                live: (0..dim as u32).collect(),
+                cell: vec![0; dim],
+                w: wx,
+                base: (0..dim as u32).collect(),
+                up,
+                a: mats[l].clone(),
+            });
+        }
+        out
+    })
+}
+
+// ------------------------------------------------------------------------------------------
+// Cell labels for depths >= 1: a small host ND driver over the reused hierarchy.
+// ------------------------------------------------------------------------------------------
+
+/// Cells of one depth. `grp[v]` is the cell id (active or leaf), SEPG for the separator made by
+/// the split into this depth, or OUT for vertices already ordered (older separators, leaves).
+struct DepthLabels {
+    grp: Vec<u32>,
+    active: Vec<bool>,
+    lstar: Vec<u32>,
+    size: Vec<u32>,
+}
+
+#[derive(Default, Clone, Copy)]
+struct Share {
+    n: u64,
+    strad: u64,
+    seponly: u64,
+}
+
+/// Deepest level at which the members still have at least `cto` distinct coarse vertices.
+fn lstar_of(
+    m: &[u32],
+    anc: &[Vec<u32>],
+    stamp: &mut [u32],
+    cur: &mut u32,
+    cto: u32,
+) -> u32 {
+    let mut l = 0;
+    while l + 1 < anc.len() {
+        *cur += 1;
+        let a = &anc[l + 1];
+        let mut k = 0u32;
+        for &v in m {
+            let x = a[v as usize] as usize;
+            if stamp[x] != *cur {
+                stamp[x] = *cur;
+                k += 1;
+            }
+        }
+        if k < cto {
+            break;
+        }
+        l += 1;
+    }
+    l as u32
+}
+
+fn bfs_far(
+    start: usize,
+    xadj: &[usize],
+    adj: &[u32],
+    seen: &mut [u32],
+    cur: u32,
+) -> usize {
+    let mut q = VecDeque::new();
+    q.push_back(start);
+    seen[start] = cur;
+    let mut last = start;
+    while let Some(v) = q.pop_front() {
+        last = v;
+        for &u in &adj[xadj[v]..xadj[v + 1]] {
+            if seen[u as usize] != cur {
+                seen[u as usize] = cur;
+                q.push_back(u as usize);
+            }
+        }
+    }
+    last
+}
+
+/// Coarse bisection: BFS growing from a pseudo-peripheral vertex to half the weight, then the
+/// lighter boundary side as the vertex separator. 0 = A, 1 = B, 2 = S.
+fn bisect(
+    xadj: &[usize],
+    adj: &[u32],
+    vw: &[u64],
+) -> Vec<u8> {
+    let n = vw.len();
+    let total: u64 = vw.iter().sum();
+    let mut seen = vec![0u32; n];
+    let s1 = bfs_far(0, xadj, adj, &mut seen, 1);
+    let s0 = bfs_far(s1, xadj, adj, &mut seen, 2);
+    let mut side = vec![1u8; n];
+    let mut vis = vec![false; n];
+    let mut q = VecDeque::new();
+    q.push_back(s0);
+    vis[s0] = true;
+    let mut acc = 0u64;
+    let mut next = 0usize;
+    loop {
+        let v = match q.pop_front() {
+            Some(v) => v,
+            None => {
+                while next < n && vis[next] {
+                    next += 1;
+                }
+                if next == n {
+                    break;
+                }
+                vis[next] = true;
+                next
+            }
+        };
+        if acc >= total / 2 {
+            break;
+        }
+        side[v] = 0;
+        acc += vw[v];
+        for &u in &adj[xadj[v]..xadj[v + 1]] {
+            if !vis[u as usize] {
+                vis[u as usize] = true;
+                q.push_back(u as usize);
+            }
+        }
+    }
+    let bnd = |s: u8| -> (Vec<usize>, u64) {
+        let mut l = Vec::new();
+        let mut w = 0;
+        for v in 0..n {
+            if side[v] == s && adj[xadj[v]..xadj[v + 1]].iter().any(|&u| side[u as usize] == 1 - s) {
+                l.push(v);
+                w += vw[v];
+            }
+        }
+        (l, w)
+    };
+    let (sa, wa) = bnd(0);
+    let (sb, wb) = bnd(1);
+    let na = side.iter().filter(|&&x| x == 0).count();
+    let nb = n - na;
+    let pick_a = match (sa.len() < na, sb.len() < nb) {
+        (true, false) => true,
+        (false, true) => false,
+        _ => wa <= wb,
+    };
+    for v in if pick_a { sa } else { sb } {
+        side[v] = 2;
+    }
+    side
+}
+
+/// Simple boundary FM at the fine level, inside one cell: thin the projected separator from both
+/// sides, then zero-gain moves toward the lighter side while the halves differ by over 2 %.
+fn refine(
+    s: &Csr,
+    m: &[u32],
+    side: &mut [u8],
+    grp: &[u32],
+    c: u32,
+    inq: &mut [bool],
+    locked: &mut [bool],
+) {
+    let nb = |v: u32| s.j[s.p[v as usize] as usize..s.p[v as usize + 1] as usize].iter().map(|&u| u as u32).filter(move |&u| grp[u as usize] == c);
+    let mut cnt = [0i64; 3];
+    for &v in m {
+        cnt[side[v as usize] as usize] += 1;
+    }
+    let thin = |side: &mut [u8], cnt: &mut [i64; 3], inq: &mut [bool]| {
+        let mut q: VecDeque<u32> = m.iter().copied().filter(|&v| side[v as usize] == 2).collect();
+        for &v in &q {
+            inq[v as usize] = true;
+        }
+        loop {
+            while let Some(v) = q.pop_front() {
+                inq[v as usize] = false;
+                if side[v as usize] != 2 {
+                    continue;
+                }
+                let (mut ha, mut hb) = (false, false);
+                for u in nb(v) {
+                    match side[u as usize] {
+                        0 => ha = true,
+                        1 => hb = true,
+                        _ => {}
+                    }
+                }
+                let to = if ha && !hb {
+                    0
+                } else if hb && !ha {
+                    1
+                } else {
+                    continue;
+                };
+                side[v as usize] = to;
+                cnt[2] -= 1;
+                cnt[to as usize] += 1;
+                for u in nb(v) {
+                    if side[u as usize] == 2 && !inq[u as usize] {
+                        inq[u as usize] = true;
+                        q.push_back(u);
+                    }
+                }
+            }
+            // separator islands with no A or B neighbour: the lighter side takes one, then thin again
+            let island = m.iter().copied().find(|&v| side[v as usize] == 2 && nb(v).all(|u| side[u as usize] == 2));
+            match island {
+                Some(v) => {
+                    let to = if cnt[0] <= cnt[1] { 0 } else { 1 };
+                    side[v as usize] = to;
+                    cnt[2] -= 1;
+                    cnt[to as usize] += 1;
+                    for u in nb(v) {
+                        if side[u as usize] == 2 && !inq[u as usize] {
+                            inq[u as usize] = true;
+                            q.push_back(u);
+                        }
+                    }
+                }
+                None => break,
+            }
+        }
+    };
+    thin(side, &mut cnt, inq);
+    let tol = (m.len() as i64 / 50).max(2);
+    for _pass in 0..16 {
+        let (light, heavy) = if cnt[0] <= cnt[1] { (0u8, 1u8) } else { (1u8, 0u8) };
+        if cnt[heavy as usize] - cnt[light as usize] <= tol {
+            break;
+        }
+        let mut moved = 0;
+        let svs: Vec<u32> = m.iter().copied().filter(|&v| side[v as usize] == 2).collect();
+        let mut touched = Vec::new();
+        for v in svs {
+            if side[v as usize] != 2 || locked[v as usize] {
+                continue;
+            }
+            if cnt[heavy as usize] - cnt[light as usize] <= tol {
+                break;
+            }
+            let hn: Vec<u32> = nb(v).filter(|&u| side[u as usize] == heavy).collect();
+            if hn.is_empty() {
+                side[v as usize] = light;
+                cnt[2] -= 1;
+                cnt[light as usize] += 1;
+                moved += 1;
+            } else if hn.len() == 1 && !locked[hn[0] as usize] {
+                let u = hn[0];
+                side[v as usize] = light;
+                side[u as usize] = 2;
+                cnt[light as usize] += 1;
+                cnt[heavy as usize] -= 1;
+                locked[v as usize] = true;
+                locked[u as usize] = true;
+                touched.push(v);
+                touched.push(u);
+                moved += 1;
+            }
+        }
+        for v in touched {
+            locked[v as usize] = false;
+        }
+        if moved == 0 {
+            break;
+        }
+        thin(side, &mut cnt, inq);
+    }
+}
+
+/// Multilevel mode (M1_REFINE=all): the same thinning and zero-gain balance moves on the cell's
+/// coarse vertices at one level, adjacency read through the members' fine edges. On entry all
+/// members of a coarse vertex share a side (the projection); on exit they still do.
+#[allow(clippy::too_many_arguments)]
+fn refine_level(
+    s: &Csr,
+    m: &[u32],
+    al: &[u32],
+    side: &mut [u8],
+    grp: &[u32],
+    c: u32,
+    loc: &mut [u32],
+    stamp: &mut [u32],
+    cur: &mut u32,
+) {
+    *cur += 1;
+    let mut pw: Vec<i64> = Vec::new();
+    for &v in m {
+        let x = al[v as usize] as usize;
+        if stamp[x] != *cur {
+            stamp[x] = *cur;
+            loc[x] = pw.len() as u32;
+            pw.push(0);
+        }
+        pw[loc[x] as usize] += 1;
+    }
+    let np = pw.len();
+    let mut start = vec![0usize; np + 1];
+    for &v in m {
+        start[loc[al[v as usize] as usize] as usize + 1] += 1;
+    }
+    for p in 0..np {
+        start[p + 1] += start[p];
+    }
+    let mut fill = start.clone();
+    let mut mem = vec![0u32; m.len()];
+    for &v in m {
+        let p = loc[al[v as usize] as usize] as usize;
+        mem[fill[p]] = v;
+        fill[p] += 1;
+    }
+    let mut ps: Vec<u8> = (0..np).map(|p| side[mem[start[p]] as usize]).collect();
+    let loc_r: &[u32] = loc;
+    let nbp = |p: usize| -> Vec<usize> {
+        let mut out = Vec::new();
+        for &v in &mem[start[p]..start[p + 1]] {
+            for &u in &s.j[s.p[v as usize] as usize..s.p[v as usize + 1] as usize] {
+                if grp[u as usize] == c {
+                    let q = loc_r[al[u as usize] as usize] as usize;
+                    if q != p {
+                        out.push(q);
+                    }
+                }
+            }
+        }
+        out.sort_unstable();
+        out.dedup();
+        out
+    };
+    let mut cnt = [0i64; 3];
+    for p in 0..np {
+        cnt[ps[p] as usize] += pw[p];
+    }
+    let thin = |ps: &mut Vec<u8>, cnt: &mut [i64; 3]| {
+        let mut inq = vec![false; np];
+        let mut q: VecDeque<usize> = (0..np).filter(|&p| ps[p] == 2).collect();
+        for &p in &q {
+            inq[p] = true;
+        }
+        loop {
+            while let Some(p) = q.pop_front() {
+                inq[p] = false;
+                if ps[p] != 2 {
+                    continue;
+                }
+                let nb = nbp(p);
+                let ha = nb.iter().any(|&u| ps[u] == 0);
+                let hb = nb.iter().any(|&u| ps[u] == 1);
+                let to = if ha && !hb {
+                    0
+                } else if hb && !ha {
+                    1
+                } else {
+                    continue;
+                };
+                ps[p] = to;
+                cnt[2] -= pw[p];
+                cnt[to as usize] += pw[p];
+                for u in nb {
+                    if ps[u] == 2 && !inq[u] {
+                        inq[u] = true;
+                        q.push_back(u);
+                    }
+                }
+            }
+            let island = (0..np).find(|&p| ps[p] == 2 && nbp(p).iter().all(|&u| ps[u] == 2));
+            match island {
+                Some(p) => {
+                    let to = if cnt[0] <= cnt[1] { 0 } else { 1 };
+                    ps[p] = to;
+                    cnt[2] -= pw[p];
+                    cnt[to as usize] += pw[p];
+                    for u in nbp(p) {
+                        if ps[u] == 2 && !inq[u] {
+                            inq[u] = true;
+                            q.push_back(u);
+                        }
+                    }
+                }
+                None => break,
+            }
+        }
+    };
+    thin(&mut ps, &mut cnt);
+    let total: i64 = pw.iter().sum();
+    let tol = (total / 50).max(2);
+    for _pass in 0..16 {
+        let (light, heavy) = if cnt[0] <= cnt[1] { (0u8, 1u8) } else { (1u8, 0u8) };
+        if cnt[heavy as usize] - cnt[light as usize] <= tol {
+            break;
+        }
+        let mut moved = 0;
+        let mut locked = vec![false; np];
+        let svs: Vec<usize> = (0..np).filter(|&p| ps[p] == 2).collect();
+        for p in svs {
+            if ps[p] != 2 || locked[p] {
+                continue;
+            }
+            let gap = cnt[heavy as usize] - cnt[light as usize];
+            if gap <= tol {
+                break;
+            }
+            let hn: Vec<usize> = nbp(p).into_iter().filter(|&u| ps[u] == heavy).collect();
+            if hn.is_empty() {
+                ps[p] = light;
+                cnt[2] -= pw[p];
+                cnt[light as usize] += pw[p];
+                moved += 1;
+            } else if hn.len() == 1 && !locked[hn[0]] && pw[hn[0]] <= pw[p] && (gap - pw[p] - pw[hn[0]]).abs() < gap {
+                let u = hn[0];
+                ps[p] = light;
+                ps[u] = 2;
+                cnt[light as usize] += pw[p];
+                cnt[2] += pw[u] - pw[p];
+                cnt[heavy as usize] -= pw[u];
+                locked[p] = true;
+                locked[u] = true;
+                moved += 1;
+            }
+        }
+        if moved == 0 {
+            break;
+        }
+        thin(&mut ps, &mut cnt);
+    }
+    for p in 0..np {
+        for &v in &mem[start[p]..start[p + 1]] {
+            side[v as usize] = ps[p];
+        }
+    }
+}
+
+/// Real cells: depth 0 is the whole graph; each active cell of depth d is bisected on its coarse
+/// graph at its deepest reused level (>= CTO vertices), projected to the fine level and refined
+/// there. Cells of <= LEAF vertices are leaves. Also returns the straddler shares (needed levels).
+fn nd_labels(
+    s: &Csr,
+    p0: &[HLevel],
+    max_depth: u32,
+    cto: u32,
+) -> (Vec<DepthLabels>, BTreeMap<(u32, u32), Share>) {
+    let n = s.n;
+    let nl = p0.len() - 1;
+    let mut anc: Vec<Vec<u32>> = vec![(0..n as u32).collect()];
+    for l in 1..=nl {
+        let up = &p0[l].up;
+        let a: Vec<u32> = anc[l - 1].iter().map(|&x| up[x as usize]).collect();
+        anc.push(a);
+    }
+    let mut stamp = vec![0u32; n];
+    let mut cur = 0u32;
+    let mut loc = vec![0u32; n];
+    let mut gl = vec![0u32; n];
+    let mut inq = vec![false; n];
+    let mut locked = vec![false; n];
+    let mut side = vec![0u8; n];
+    let mut shares: BTreeMap<(u32, u32), Share> = BTreeMap::new();
+    let all: Vec<u32> = (0..n as u32).collect();
+    let root_l = lstar_of(&all, &anc, &mut stamp, &mut cur, cto);
+    let mut out = vec![DepthLabels { grp: vec![0; n], active: vec![true], lstar: vec![root_l], size: vec![n as u32] }];
+    for d in 0..max_depth {
+        let lab = &out[d as usize];
+        let k = lab.active.len();
+        let mut members: Vec<Vec<u32>> = vec![Vec::new(); k];
+        for v in 0..n {
+            let g = lab.grp[v];
+            if (g as usize) < k && lab.active[g as usize] {
+                members[g as usize].push(v as u32);
+            }
+        }
+        if members.iter().all(|m| m.is_empty()) {
+            break;
+        }
+        let mut grp = vec![OUT; n];
+        let mut active = Vec::new();
+        let mut lstar = Vec::new();
+        let mut size = Vec::new();
+        let (mut nsep, mut nleaf_v, mut ranout, mut retried) = (0u64, 0u64, 0u64, 0u64);
+        for c in 0..k {
+            let m = &members[c];
+            if m.is_empty() {
+                continue;
+            }
+            let ls = lab.lstar[c] as usize;
+            if ls == nl {
+                ranout += 1;
+            }
+            // coarse graph of the cell at its deepest reused level; if the split leaves a side
+            // empty (a few heavy disconnected chunks), retry one level finer
+            let mut lvl = ls;
+            loop {
+                cur += 1;
+                let a = &anc[lvl];
+                let mut vw: Vec<u64> = Vec::new();
+                for &v in m {
+                    let x = a[v as usize] as usize;
+                    if stamp[x] != cur {
+                        stamp[x] = cur;
+                        loc[x] = vw.len() as u32;
+                        vw.push(0);
+                    }
+                    vw[loc[x] as usize] += 1;
+                }
+                let mut pairs: Vec<u64> = Vec::new();
+                for &v in m {
+                    let lv = loc[a[v as usize] as usize] as u64;
+                    for &u in &s.j[s.p[v as usize] as usize..s.p[v as usize + 1] as usize] {
+                        if lab.grp[u as usize] == c as u32 {
+                            let lu = loc[a[u as usize] as usize] as u64;
+                            if lu != lv {
+                                pairs.push(lv << 32 | lu);
+                            }
+                        }
+                    }
+                }
+                pairs.sort_unstable();
+                pairs.dedup();
+                let nc = vw.len();
+                let mut xadj = vec![0usize; nc + 1];
+                for &p in &pairs {
+                    xadj[(p >> 32) as usize + 1] += 1;
+                }
+                for i in 0..nc {
+                    xadj[i + 1] += xadj[i];
+                }
+                let adj: Vec<u32> = pairs.iter().map(|&p| p as u32).collect();
+                drop(pairs);
+                let cs = bisect(&xadj, &adj, &vw);
+                for &v in m {
+                    side[v as usize] = cs[loc[a[v as usize] as usize] as usize];
+                }
+                if env("M1_REFINE").as_deref() == Some("all") {
+                    for l in (1..=lvl).rev() {
+                        refine_level(s, m, &anc[l], &mut side, &lab.grp, c as u32, &mut loc, &mut stamp, &mut cur);
+                    }
+                }
+                refine(s, m, &mut side, &lab.grp, c as u32, &mut inq, &mut locked);
+                let na = m.iter().filter(|&&v| side[v as usize] == 0).count();
+                let nb = m.iter().filter(|&&v| side[v as usize] == 1).count();
+                if (na > 0 && nb > 0) || lvl == 0 {
+                    if lvl < ls {
+                        retried += 1;
+                    }
+                    break;
+                }
+                lvl -= 1;
+            }
+            if brk("sepcut") && d == 1 {
+                // put one separator vertex that touches both sides into A
+                if let Some(&v) = m.iter().find(|&&v| {
+                    side[v as usize] == 2 && {
+                        let nb = &s.j[s.p[v as usize] as usize..s.p[v as usize + 1] as usize];
+                        nb.iter().any(|&u| lab.grp[u as usize] == c as u32 && side[u as usize] == 0)
+                            && nb.iter().any(|&u| lab.grp[u as usize] == c as u32 && side[u as usize] == 1)
+                    }
+                }) {
+                    side[v as usize] = 0;
+                }
+            }
+            // check: a vertex separator, no A-B edge inside the cell
+            for &v in m {
+                if side[v as usize] == 0 {
+                    for &u in &s.j[s.p[v as usize] as usize..s.p[v as usize + 1] as usize] {
+                        assert!(
+                            !(lab.grp[u as usize] == c as u32 && side[u as usize] == 1),
+                            "CHECK FAILED: separator leaves an A-B edge (depth {d}, cell {c}, {v}-{u})"
+                        );
+                    }
+                }
+            }
+            let ida = active.len() as u32;
+            let mut parts = [Vec::new(), Vec::new()];
+            for &v in m {
+                match side[v as usize] {
+                    0 => parts[0].push(v),
+                    1 => parts[1].push(v),
+                    _ => {
+                        grp[v as usize] = SEPG;
+                        nsep += 1;
+                    }
+                }
+            }
+            let mut child_ls = [0u32; 2];
+            for (h, part) in parts.iter().enumerate() {
+                let id = ida + h as u32;
+                for &v in part {
+                    grp[v as usize] = id;
+                }
+                let act = part.len() > LEAF;
+                let pl = if act { lstar_of(part, &anc, &mut stamp, &mut cur, cto) } else { 0 };
+                child_ls[h] = if part.len() > 200 { pl } else { 0 };
+                if !act {
+                    nleaf_v += part.len() as u64;
+                }
+                active.push(act);
+                lstar.push(pl);
+                size.push(part.len() as u32);
+            }
+            // straddler shares of this split over the levels its children (> 200 vertices) use
+            let needed = child_ls[0].max(child_ls[1]) as usize;
+            for l in 1..=needed {
+                cur += 1;
+                let al = &anc[l];
+                let mut dist = Vec::new();
+                for &v in m {
+                    let x = al[v as usize] as usize;
+                    let g = side[v as usize] as u32;
+                    if stamp[x] != cur {
+                        stamp[x] = cur;
+                        gl[x] = g;
+                        dist.push(x);
+                    } else if gl[x] != g {
+                        gl[x] = MIXED;
+                    }
+                }
+                let e = shares.entry((d, l as u32)).or_default();
+                e.n += dist.len() as u64;
+                for &x in &dist {
+                    if gl[x] == MIXED {
+                        e.strad += 1;
+                    } else if gl[x] == 2 {
+                        e.seponly += 1;
+                    }
+                }
+            }
+        }
+        let nact = active.iter().filter(|&&a| a).count();
+        let live: u64 = (0..active.len()).filter(|&i| active[i]).map(|i| size[i] as u64).sum();
+        println!(
+            "LABELS depth={} cells={} active={nact} live={live} sep={nsep} leafv={nleaf_v} parent_ranout={ranout} retried_finer={retried} lstar_max={}",
+            d + 1,
+            active.len(),
+            lstar.iter().max().copied().unwrap_or(0)
+        );
+        out.push(DepthLabels { grp, active, lstar, size });
+        if nact == 0 {
+            break;
+        }
+    }
+    (out, shares)
+}
+
+/// The earlier proxy: 2^d contiguous chunks of feral's order, no separators, every cell active.
+fn proxy_labels(
+    pos: &[u64],
+    p0: &[HLevel],
+    max_depth: u32,
+    cto: u32,
+) -> (Vec<DepthLabels>, BTreeMap<(u32, u32), Share>) {
+    let n = pos.len();
+    let nl = p0.len() - 1;
+    let mut anc: Vec<Vec<u32>> = vec![(0..n as u32).collect()];
+    for l in 1..=nl {
+        let up = &p0[l].up;
+        anc.push(anc[l - 1].iter().map(|&x| up[x as usize]).collect());
+    }
+    let mut stamp = vec![0u32; n];
+    let mut cur = 0;
+    let mut gl = vec![0u32; n];
+    let mut shares: BTreeMap<(u32, u32), Share> = BTreeMap::new();
+    let mut out = Vec::new();
+    for d in 0..=max_depth {
+        let cells = 1u64 << d;
+        let grp: Vec<u32> = (0..n).map(|v| (pos[v] * cells / n as u64) as u32).collect();
+        let mut members: Vec<Vec<u32>> = vec![Vec::new(); cells as usize];
+        for v in 0..n {
+            members[grp[v] as usize].push(v as u32);
+        }
+        let lstar: Vec<u32> = members.iter().map(|m| lstar_of(m, &anc, &mut stamp, &mut cur, cto)).collect();
+        let size: Vec<u32> = members.iter().map(|m| m.len() as u32).collect();
+        if d > 0 {
+            // shares of the split from depth d-1: parent chunk p = c / 2
+            let prev: &DepthLabels = &out[d as usize - 1];
+            for p in 0..(cells / 2) as usize {
+                let m: Vec<u32> = members[2 * p].iter().chain(members[2 * p + 1].iter()).copied().collect();
+                let needed = [2 * p, 2 * p + 1].iter().filter(|&&c| size[c] > 200).map(|&c| lstar[c]).max().unwrap_or(0);
+                let _ = prev;
+                for l in 1..=needed as usize {
+                    cur += 1;
+                    let al = &anc[l];
+                    let mut dist = Vec::new();
+                    for &v in &m {
+                        let x = al[v as usize] as usize;
+                        if stamp[x] != cur {
+                            stamp[x] = cur;
+                            gl[x] = grp[v as usize];
+                            dist.push(x);
+                        } else if gl[x] != grp[v as usize] {
+                            gl[x] = MIXED;
+                        }
+                    }
+                    let e = shares.entry((d - 1, l as u32)).or_default();
+                    e.n += dist.len() as u64;
+                    e.strad += dist.iter().filter(|&&x| gl[x] == MIXED).count() as u64;
+                }
+            }
+        }
+        println!("LABELS depth={d} cells={cells} active={cells} live={n} sep=0 leafv=0 lstar_max={}", lstar.iter().max().unwrap());
+        out.push(DepthLabels { grp, active: vec![true; cells as usize], lstar, size });
+    }
+    (out, shares)
+}
+
+// ------------------------------------------------------------------------------------------
+// B1 and B2
+// ------------------------------------------------------------------------------------------
+
+struct Book {
+    dim: usize,
+    up: Vec<u32>,
+    live: Vec<u32>,
+    cell: Vec<u32>,
+    base: Vec<u32>,
+    w: Vec<i32>,
+    grp: Vec<u32>,
+    clean: Vec<u32>,
+    strad_x: Vec<u32>,
+    is_strad: Vec<bool>,
+    // stats
+    n_par: u64,
+    n_mixed: u64,
+    n_seponly: u64,
+    n_pieces: u64,
+    extras: u64,
+}
+
+/// Host bookkeeping for child level l: group of every parent coarse vertex (one child cell, the
+/// separator, or MIXED), the child's pieces and ids, the per-cell stop, and the weights.
+/// B1 sums every member's weight; B2 copies the parent's weight for clean vertices.
+fn book(
+    pgrp_prev: &[u32],
+    par_prev: &HLevel,
+    par: &HLevel,
+    ch_prev: &HLevel,
+    active: &mut [bool],
+    b2_weights: bool,
+    cto: u32,
+) -> Book {
+    let mut tb = Instant::now();
+    let pd = par.dim;
+    let mut grp = vec![UNSET; pd];
+    bt("b1_grp_alloc", &mut tb);
+    for &q0 in &par_prev.live {
+        let q = par.up[q0 as usize];
+        if q == OUT {
+            continue;
+        }
+        let g = pgrp_prev[q0 as usize];
+        let c = &mut grp[q as usize];
+        *c = if *c == UNSET || *c == g { g } else { MIXED };
+    }
+    bt("b2_grp_loop", &mut tb);
+    let ncells = active.len();
+    let mut cnt = vec![0u32; ncells];
+    let mut seen = vec![false; pd];
+    let mut px = vec![OUT; ch_prev.dim];
+    let mut pk = vec![0u8; ch_prev.dim];
+    let mut spieces: Vec<(u32, u32)> = Vec::new();
+    let mut smap: HashMap<(u32, u32), u32> = HashMap::new();
+    bt("b3_child_alloc", &mut tb);
+    for &x in &ch_prev.live {
+        let c = ch_prev.cell[x as usize];
+        let q = par.up[ch_prev.base[x as usize] as usize];
+        if q == OUT {
+            continue;
+        }
+        let g = grp[q as usize];
+        if g == c {
+            if !seen[q as usize] {
+                seen[q as usize] = true;
+                cnt[c as usize] += 1;
+            }
+            px[x as usize] = q;
+            pk[x as usize] = 1;
+        } else {
+            assert_eq!(g, MIXED, "child vertex maps into a parent vertex of another group");
+            let k = *smap.entry((q, c)).or_insert_with(|| {
+                spieces.push((q, c));
+                cnt[c as usize] += 1;
+                (spieces.len() - 1) as u32
+            });
+            px[x as usize] = k;
+            pk[x as usize] = 2;
+        }
+    }
+    bt("b4_child_loop", &mut tb);
+    for c in 0..ncells {
+        if active[c] && cnt[c] < cto {
+            active[c] = false;
+        }
+    }
+    let mut taken = vec![false; pd];
+    let mut sid = vec![OUT; spieces.len()];
+    let mut extras = 0usize;
+    let order: Vec<usize> = if brk("bperm") && CUR_RUN.load(Ordering::Relaxed) == 1 {
+        (0..spieces.len()).rev().collect()
+    } else {
+        (0..spieces.len()).collect()
+    };
+    for k in order {
+        let (q, c) = spieces[k];
+        if !active[c as usize] {
+            continue;
+        }
+        if !taken[q as usize] {
+            taken[q as usize] = true;
+            sid[k] = q;
+        } else {
+            sid[k] = (pd + extras) as u32;
+            extras += 1;
+        }
+    }
+    let dim = pd + extras;
+    bt("b5_stop_sid", &mut tb);
+    let mut up = vec![OUT; ch_prev.dim];
+    let mut cell = vec![OUT; dim];
+    let mut base = vec![OUT; dim];
+    let mut w = vec![0i32; dim];
+    let mut is_strad = vec![false; dim];
+    let mut strad_x = Vec::new();
+    bt("b6_out_alloc", &mut tb);
+    for &x in &ch_prev.live {
+        match pk[x as usize] {
+            1 => {
+                let q = px[x as usize];
+                let c = ch_prev.cell[x as usize];
+                if active[c as usize] {
+                    up[x as usize] = q;
+                    cell[q as usize] = c;
+                    base[q as usize] = q;
+                    if !b2_weights {
+                        w[q as usize] += ch_prev.w[x as usize];
+                    }
+                }
+            }
+            2 => {
+                let k = px[x as usize] as usize;
+                let id = sid[k];
+                if id != OUT {
+                    up[x as usize] = id;
+                    let (q, c) = spieces[k];
+                    cell[id as usize] = c;
+                    base[id as usize] = q;
+                    is_strad[id as usize] = true;
+                    w[id as usize] += ch_prev.w[x as usize];
+                    strad_x.push(x);
+                }
+            }
+            _ => {}
+        }
+    }
+    bt("b7_out_fill", &mut tb);
+    let live: Vec<u32> = (0..dim as u32).filter(|&i| cell[i as usize] != OUT).collect();
+    let clean: Vec<u32> = live.iter().copied().filter(|&i| !is_strad[i as usize]).collect();
+    if b2_weights {
+        for &q in &clean {
+            w[q as usize] = par.w[q as usize];
+        }
+        if brk("bweight") {
+            if let Some(&q) = live.iter().find(|&&i| is_strad[i as usize]) {
+                w[q as usize] += 1;
+            }
+        }
+    }
+    if brk("bcons") {
+        // break: the same extra unit of weight in B1 and B2
+        w[live[0] as usize] += 1;
+    }
+    bt("b8_live_clean_w", &mut tb);
+    let n_par = grp.iter().filter(|&&g| g != UNSET).count() as u64;
+    let n_mixed = grp.iter().filter(|&&g| g == MIXED).count() as u64;
+    let n_seponly = grp.iter().filter(|&&g| g == SEPG).count() as u64;
+    let n_pieces = sid.iter().filter(|&&x| x != OUT).count() as u64;
+    bt("b9_stats", &mut tb);
+    Book {
+        dim,
+        up,
+        live,
+        cell,
+        base,
+        w,
+        grp,
+        clean,
+        strad_x,
+        is_strad,
+        n_par,
+        n_mixed,
+        n_seponly,
+        n_pieces,
+        extras: extras as u64,
+    }
+}
+
+/// B1: full re-contraction of the child's previous level with C' (built as C'ᵀ, run as the
+/// "best" configuration of the parent bench).
+fn contract_b1(
+    prev: &HLevel,
+    bk: &Book,
+    ops: &Ops,
+    t: &mut Timer,
+) -> M {
+    let ct = t.time("c_build", || {
+        let mut ii = Vec::with_capacity(prev.live.len());
+        let mut jj = Vec::with_capacity(prev.live.len());
+        for &x in &prev.live {
+            let u = bk.up[x as usize];
+            if u != OUT {
+                ii.push(x as u64);
+                jj.push(u as u64);
+            }
+        }
+        let ct = M::new(t_i32(), prev.dim as u64, bk.dim as u64);
+        ok!(GxB_Matrix_build_Scalar(ct.0, ii.as_ptr(), jj.as_ptr(), ops.one_i32, ii.len() as u64));
+        ct.wait();
+        ct
+    });
+    let tm = t.time("CA", || {
+        let tm = M::new(t_i32(), bk.dim as u64, prev.dim as u64);
+        ok!(GrB_mxm(tm.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, ct.0, prev.a.0, GrB_DESC_T0));
+        tm.wait();
+        tm
+    });
+    let q = t.time("CAC'", || {
+        let q = M::new(t_i32(), bk.dim as u64, bk.dim as u64);
+        ok!(GrB_mxm(q.0, null(), null(), GrB_PLUS_TIMES_SEMIRING_INT32, tm.0, ct.0, null()));
+        q.wait();
+        q
+    });
+    drop(tm);
+    if !brk("b1offdiag") {
+        t.time("offdiag", || {
+            ok!(GrB_Matrix_select_INT64(q.0, null(), null(), GrB_OFFDIAG, q.0, 0, null()));
+            q.wait();
+        });
+    }
+    q
+}
+
+/// B2: the parent's level restricted to clean vertices by one masked split, plus the straddler
+/// rows re-contracted from the child's previous level (and their columns by symmetry).
+fn contract_b2(
+    prev: &HLevel,
+    par: &HLevel,
+    bk: &Book,
+    ncells: usize,
+    ops: &Ops,
+    t: &mut Timer,
+) -> (M, u64) {
+    let pd = par.dim as u64;
+    let masked = brk("b2mask");
+    let mm = t.time("m_build", || {
+        let mut ii = Vec::with_capacity(bk.clean.len());
+        let mut jj = Vec::with_capacity(bk.clean.len());
+        for &q in &bk.live {
+            // b2mask (break): a straddler's first piece is treated as clean
+            if !bk.is_strad[q as usize] || (masked && (q as u64) < pd) {
+                ii.push(q as u64);
+                jj.push(bk.cell[q as usize] as u64);
+            }
+        }
+        let mm = M::new(t_i32(), pd, ncells as u64);
+        ok!(GxB_Matrix_build_Scalar(mm.0, ii.as_ptr(), jj.as_ptr(), ops.one_i32, ii.len() as u64));
+        mm.wait();
+        mm
+    });
+    let sm = t.time("mask_mxm", || {
+        let sm = M::new(t_i32(), pd, pd);
+        ok!(GrB_mxm(sm.0, par.a.0, null(), GxB_ANY_PAIR_INT32, mm.0, mm.0, GrB_DESC_ST1));
+        sm.wait();
+        sm
+    });
+    drop(mm);
+    t.time("mask_vals", || {
+        ok!(GrB_Matrix_eWiseMult_BinaryOp(sm.0, null(), null(), GrB_FIRST_INT32, par.a.0, sm.0, null()));
+        sm.wait();
+    });
+    if bk.dim as u64 > pd {
+        t.time("resize", || {
+            ok!(GrB_Matrix_resize(sm.0, bk.dim as u64, bk.dim as u64));
+            sm.wait();
+        });
+    }
+    let xs: Vec<u64> = bk.strad_x.iter().filter(|&&x| !(masked && (bk.up[x as usize] as u64) < pd)).map(|&x| x as u64).collect();
+    if xs.is_empty() {
+        audit_b2_inplace(par, bk, None, &sm, t);
+        return (sm, 0);
+    }
+    let tr = t.time("s_extract", || {
+        let tr = M::new(t_i32(), xs.len() as u64, prev.dim as u64);
+        ok!(GrB_Matrix_extract(tr.0, null(), null(), prev.a.0, xs.as_ptr(), xs.len() as u64, GrB_ALL, prev.dim as u64, null()));
+        tr.wait();
+        tr
+    });
+    let rin = tr.nvals();
+    let rs = t.time("s_build", || {
+        let (ti, tj, tx) = mat_tuples(&tr);
+        let mut ri = Vec::with_capacity(2 * ti.len());
+        let mut rj = Vec::with_capacity(2 * ti.len());
+        let mut rx = Vec::with_capacity(2 * ti.len());
+        for k in 0..ti.len() {
+            let sv = bk.up[xs[ti[k] as usize] as usize];
+            let tv = bk.up[tj[k] as usize];
+            assert_ne!(tv, OUT, "straddler row reaches a dropped vertex");
+            if sv == tv {
+                continue;
+            }
+            ri.push(sv as u64);
+            rj.push(tv as u64);
+            rx.push(tx[k]);
+            let t_is_strad = bk.is_strad[tv as usize] && !(masked && (tv as u64) < pd);
+            if !t_is_strad {
+                ri.push(tv as u64);
+                rj.push(sv as u64);
+                rx.push(tx[k]);
+            }
+        }
+        let rs = M::new(t_i32(), bk.dim as u64, bk.dim as u64);
+        ok!(GrB_Matrix_build_INT32(rs.0, ri.as_ptr(), rj.as_ptr(), rx.as_ptr(), ri.len() as u64, GrB_PLUS_INT32));
+        rs.wait();
+        rs
+    });
+    drop(tr);
+    let q = t.time("s_merge", || {
+        let q = M::new(t_i32(), bk.dim as u64, bk.dim as u64);
+        ok!(GrB_Matrix_eWiseAdd_BinaryOp(q.0, null(), null(), GrB_PLUS_INT32, sm.0, rs.0, null()));
+        q.wait();
+        q
+    });
+    audit_b2_inplace(par, bk, Some(&rs), &q, t);
+    (q, rin)
+}
+
+struct BOut {
+    lv: Vec<HLevel>,
+    timers: Vec<Timer>,
+    stats: Vec<[u64; 9]>,
+    top: Vec<u32>,
+}
+
+/// Build a depth's child hierarchy from its parent's (mode 1 = B1, 2 = B2), then the same
+/// uncoarsening work R's bench times: per level, project labels and one boundary mxv.
+fn build_b(
+    mode: u8,
+    parent: &[HLevel],
+    q0: Rc<M>,
+    lab: &DepthLabels,
+    ops: &Ops,
+) -> BOut {
+    let n = q0.nrows() as usize;
+    let ncells = lab.active.len();
+    let mut timers = vec![Timer::default()];
+    let lv0 = timers[0].time("book", || {
+        let mut tb = Instant::now();
+        let mut cell = vec![OUT; n];
+        let mut w = vec![0i32; n];
+        let mut live = Vec::new();
+        for v in 0..n {
+            let g = lab.grp[v];
+            if (g as usize) < ncells && lab.active[g as usize] {
+                cell[v] = g;
+                w[v] = 1;
+                live.push(v as u32);
+            }
+        }
+        let h = HLevel { dim: n, live, cell, w, base: (0..n as u32).collect(), up: Vec::new(), a: q0 };
+        bt("b0_level0", &mut tb);
+        h
+    });
+    let mut lv = vec![lv0];
+    let mut active = lab.active.clone();
+    let mut top: Vec<u32> = active.iter().map(|&a| if a { 0 } else { OUT }).collect();
+    let mut stats = vec![[0u64; 9]];
+    let mut pgrp_owned: Option<Vec<u32>> = None;
+    let cto = CTO;
+    for l in 1..parent.len() {
+        let mut t = Timer::default();
+        let pgrp: &[u32] = pgrp_owned.as_deref().unwrap_or(&lab.grp);
+        let bk = t.time("book", || book(pgrp, &parent[l - 1], &parent[l], &lv[l - 1], &mut active, mode == 2, cto));
+        if bk.live.is_empty() {
+            for (k, v) in t.0 {
+                *timers[l - 1].0.entry(k).or_default() += v;
+            }
+            break;
+        }
+        for c in 0..ncells {
+            if active[c] {
+                top[c] = l as u32;
+            }
+        }
+        let prev = &lv[l - 1];
+        let (a, rin) = if mode == 1 {
+            (contract_b1(prev, &bk, ops, &mut t), 0)
+        } else {
+            contract_b2(prev, &parent[l], &bk, ncells, ops, &mut t)
+        };
+        if brk("basym") && l == 1 {
+            // break: one asymmetric entry, the same in B1 and B2
+            let (i, j) = (bk.live[0] as u64, bk.live[1] as u64);
+            ok!(GrB_Matrix_setElement_INT32(a.0, 7, i, j));
+            a.wait();
+        }
+        if brk("bmatch") && mode == 2 && l == 1 {
+            // break: run one matching level inside the reuse path
+            let wv = V::new(t_i32(), a.nrows());
+            ok!(GrB_Vector_assign_INT32(wv.0, null(), null(), 1, GrB_ALL, a.nrows(), null()));
+            let _ = coarsen_level(&a, &wv, i32::MAX, 1, ops, &mut Timer::default());
+        }
+        stats.push([bk.n_par, bk.n_mixed, bk.n_seponly, bk.n_pieces, bk.extras, rin, prev.a.nvals(), a.nvals(), bk.live.len() as u64]);
+        lv.push(HLevel { dim: bk.dim, live: bk.live, cell: bk.cell, w: bk.w, base: bk.base, up: bk.up, a: Rc::new(a) });
+        pgrp_owned = Some(bk.grp);
+        timers.push(t);
+    }
+    // uncoarsening work: random 2-way labels at each cell's top level, project, boundary mxv
+    let topl = lv.len() - 1;
+    let mut rng = Rng(42);
+    let mut lab_up: Vec<i32> = vec![0; lv[topl].dim];
+    for &x in &lv[topl].live {
+        lab_up[x as usize] = (rng.next() & 1) as i32;
+    }
+    for l in (0..topl).rev() {
+        let t = &mut timers[l];
+        let h = &lv[l];
+        let up = &lv[l + 1].up;
+        let (f, nl) = t.time("project", || {
+            let mut nl = vec![0i32; h.dim];
+            let mut ii = Vec::with_capacity(h.live.len());
+            let mut xx = Vec::with_capacity(h.live.len());
+            for &x in &h.live {
+                let u = up[x as usize];
+                let v = if u != OUT { lab_up[u as usize] } else { (rng.next() & 1) as i32 };
+                nl[x as usize] = v;
+                ii.push(x as u64);
+                xx.push(v);
+            }
+            let mut tb = Instant::now();
+            let f = V::new(t_i32(), h.dim as u64);
+            ok!(GrB_Vector_build_INT32(f.0, ii.as_ptr(), xx.as_ptr(), ii.len() as u64, null()));
+            f.wait();
+            bt("p_build", &mut tb);
+            (f, nl)
+        });
+        t.time("bnd", || {
+            let b = V::new(t_i32(), h.dim as u64);
+            ok!(GrB_mxv(b.0, null(), null(), GxB_PLUS_SECOND_INT32, h.a.0, f.0, null()));
+            b.wait();
+        });
+        lab_up = nl;
+    }
+    BOut { lv, timers, stats, top }
+}
+
+/// B1 and B2 must agree on every level: ids, live sets, maps, weights, and the matrices
+/// (nvals, pattern and values). Also checks each level's own invariants. Returns per-level
+/// fingerprints (dim, nvals, hash).
+fn compare_b(
+    b1: &BOut,
+    b2: &BOut,
+    lab: &DepthLabels,
+    depth: u32,
+) -> Vec<(usize, u64, u64)> {
+    assert_eq!(b1.lv.len(), b2.lv.len(), "CHECK FAILED: B1/B2 level counts differ (depth {depth})");
+    assert_eq!(b1.top, b2.top, "CHECK FAILED: B1/B2 per-cell tops differ");
+    let mut fp = Vec::new();
+    for l in 0..b1.lv.len() {
+        let (x, y) = (&b1.lv[l], &b2.lv[l]);
+        assert_eq!(x.dim, y.dim, "CHECK FAILED: B1/B2 dim differs (depth {depth} level {l})");
+        assert_eq!(x.live, y.live, "CHECK FAILED: B1/B2 live set differs");
+        assert_eq!(x.up, y.up, "CHECK FAILED: B1/B2 maps differ");
+        let wdiff = x.live.iter().filter(|&&i| x.w[i as usize] != y.w[i as usize]).count();
+        assert_eq!(wdiff, 0, "CHECK FAILED: B1/B2 vertex weights differ on {wdiff} vertices (depth {depth} level {l})");
+        // weight conservation: each cell active at this level carries all its fine vertices
+        let want: i64 = (0..lab.active.len()).filter(|&c| b1.top[c] != OUT && b1.top[c] as usize >= l).map(|c| lab.size[c] as i64).sum();
+        let got: i64 = x.live.iter().map(|&i| x.w[i as usize] as i64).sum();
+        assert_eq!(got, want, "CHECK FAILED: vertex weight not conserved (depth {depth} level {l})");
+        for (name, h) in [("B1", x), ("B2", y)] {
+            let dg = M::new(t_i32(), h.dim as u64, h.dim as u64);
+            ok!(GrB_Matrix_select_INT64(dg.0, null(), null(), GrB_DIAG, h.a.0, 0, null()));
+            assert_eq!(dg.nvals(), 0, "CHECK FAILED: {name} level has a diagonal (depth {depth} level {l})");
+        }
+        if l == 0 {
+            assert!(Rc::ptr_eq(&x.a, &y.a));
+            fp.push((x.dim, x.a.nvals(), 0));
+            continue;
+        }
+        let (n1, n2) = (x.a.nvals(), y.a.nvals());
+        let t1 = mat_tuples(&x.a);
+        let t2 = mat_tuples(&y.a);
+        let mut diff = 0u64;
+        if n1 != n2 || t1.0 != t2.0 || t1.1 != t2.1 {
+            diff = n1.max(n2);
+        } else {
+            diff += t1.2.iter().zip(&t2.2).filter(|(a, b)| a != b).count() as u64;
+        }
+        assert!(
+            diff == 0,
+            "CHECK FAILED: B1 and B2 child matrices differ (depth {depth} level {l}: nvals {n1} vs {n2}, {diff} entries differ)"
+        );
+        if verify() {
+            let tt = M::new(t_i32(), x.dim as u64, x.dim as u64);
+            ok!(GrB_transpose(tt.0, null(), null(), x.a.0, null()));
+            let tt = mat_tuples(&tt);
+            assert!(tt == t1, "CHECK FAILED: B1 level not symmetric (depth {depth} level {l})");
+        }
+        fp.push((x.dim, n1, tuple_hash(&t1)));
+    }
+    fp
+}
+
+/// Cells whose reuse ran out: still active at the parent's last level. Reports how big their
+/// coarsest level is, and how many of those vertices have an edge (could still be matched).
+fn ranout(
+    b: &BOut,
+    nlev_parent: usize,
+    depth: u32,
+) {
+    let last = b.lv.len() - 1;
+    let h = &b.lv[last];
+    let (ti, _, _) = mat_tuples(&h.a);
+    let mut deg = vec![0u32; h.dim];
+    for &i in &ti {
+        deg[i as usize] += 1;
+    }
+    let mut per: BTreeMap<u32, (u64, u64)> = BTreeMap::new();
+    for &x in &h.live {
+        let c = h.cell[x as usize];
+        if b.top[c as usize] as usize == nlev_parent - 1 {
+            let e = per.entry(c).or_default();
+            e.0 += 1;
+            e.1 += (deg[x as usize] > 0) as u64;
+        }
+    }
+    let over: Vec<&(u64, u64)> = per.values().filter(|e| e.0 > CTO as u64).collect();
+    let noreuse = b.top.iter().filter(|&&t| t == 0).count();
+    println!(
+        "RANOUT depth={depth} cells_at_parent_last_level={} over_floor={} max_n={} max_with_edges={} cells_no_reused_level={noreuse}",
+        per.len(),
+        over.len(),
+        per.values().map(|e| e.0).max().unwrap_or(0),
+        per.values().map(|e| e.1).max().unwrap_or(0)
+    );
+}
+
+fn split_live(
+    a: &M,
+    live: &[u32],
+    grp: &[u32],
+    ncells: u64,
+    ops: &Ops,
+    t: &mut Timer,
+    depth: u32,
+) -> M {
+    let n = a.nrows();
+    let ii: Vec<u64> = live.iter().map(|&v| v as u64).collect();
+    let jj: Vec<u64> = if brk("split") && depth == 1 {
+        (0..live.len()).map(|k| grp[live[(k + 1) % live.len()] as usize] as u64).collect()
+    } else {
+        live.iter().map(|&v| grp[v as usize] as u64).collect()
+    };
+    let mm = t.time("split_buildM", || {
+        let mm = M::new(t_i32(), n, ncells);
+        ok!(GxB_Matrix_build_Scalar(mm.0, ii.as_ptr(), jj.as_ptr(), ops.one_i32, ii.len() as u64));
+        mm.wait();
+        mm
+    });
+    t.time("split_mxm", || {
+        let an = M::new(t_i32(), n, n);
+        ok!(GrB_mxm(an.0, a.0, null(), GxB_ANY_PAIR_INT32, mm.0, mm.0, GrB_DESC_ST1));
+        an.wait();
+        an
+    })
+}
+
+fn fmt_timer(t: &Timer) -> String {
+    t.0.iter().map(|(k, v)| format!("{k}={v:.6}")).collect::<Vec<_>>().join(" ")
+}
+fn sum_timers(ts: &[Timer]) -> Timer {
+    let mut out = Timer::default();
+    for t in ts {
+        for (k, v) in &t.0 {
+            *out.0.entry(k).or_default() += v;
+        }
+    }
+    out
+}
