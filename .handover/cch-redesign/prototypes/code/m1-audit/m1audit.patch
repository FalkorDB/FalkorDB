+    let a0 = to_grb(&s);
+    let a0rc = {
+        let mut d = null();
+        ok!(GrB_Matrix_dup(&mut d, a0.0));
+        Rc::new(M(d))
+    };
+    let ops = Ops::new();
+    let threads: Vec<i32> = env("M1_THREADS").unwrap_or("1,4".into()).split(',').map(|x| x.parse().unwrap()).collect();
+    let runs: usize = env("M1_RUNS").map_or(3, |x| x.parse().unwrap());
+    let max_depth: u32 = env("M1_DEPTHS").map_or(40, |x| x.parse().unwrap());
+    let feral_runs: usize = env("M1_FERAL").map_or(3, |x| x.parse().unwrap());
+    let proxy = env("M1_CELLS").as_deref() == Some("proxy");
+    let n = s.n as u64;
+
+    let mut pos = vec![0u64; s.n];
+    {
+        let mut perm0 = None;
+        for r in 0..feral_runs.max(1) {
+            if r < feral_runs {
+                println!("LOAD feral run={r} load1={:.2}", load1());
+            }
+            let (perm, sec) = feral_perm(&s);
+            if r < feral_runs {
+                println!("FERAL run={r} sec={sec:.3}");
+            }
+            if let Some(p0) = &perm0 {
+                assert_eq!(p0, &perm, "feral not deterministic");
+            } else {
+                perm0 = Some(perm);
+            }
+            flush();
+        }
+        for (k, &v) in perm0.unwrap().iter().enumerate() {
+            pos[v as usize] = k as u64;
+        }
+    }
+
+    // untimed warm-up of depth 0: its hierarchy defines every deeper depth's cells
+    set_nthreads(threads[0]);
+    let cap0 = ((15 * n) / 1000).max(2) as i32;
+    let stop0 = 100u64;
+    let mut kept = None;
+    let (_, fp0, _) = hierarchy_keep(&a0, cap0, stop0, &ops, Some(&mut kept));
+    let p0 = depth0_parent(&a0rc, kept.take().unwrap(), &mut Timer::default());
+    println!("DEPTH0 levels={} dims={:?}", p0.len() - 1, p0.iter().map(|h| h.dim).collect::<Vec<_>>());
+    let t = Instant::now();
+    let cto_labels = if brk("lstar") { CTO + 1 } else { CTO };
+    let (labels, shares) = if proxy { proxy_labels(&pos, &p0, max_depth.min(14), cto_labels) } else { nd_labels(&s, &p0, max_depth, cto_labels) };
+    println!(
+        "LABELS_TIME {:.2}s mode={} refine={}",
+        t.elapsed().as_secs_f64(),
+        if proxy { "proxy" } else { "real" },
+        env("M1_REFINE").unwrap_or("fine".into())
+    );
+    for ((d, l), e) in &shares {
+        println!("SHARE depth={d} level={l} n={} strad={} seponly={}", e.n, e.strad, e.seponly);
+    }
+    drop(p0);
+    flush();
+
+    let mut fps_r: BTreeMap<u32, Vec<(u64, u64, i64)>> = BTreeMap::new();
+    let mut fps_b: BTreeMap<u32, Vec<(usize, u64, u64)>> = BTreeMap::new();
+    for (ti, &th) in threads.iter().enumerate() {
+        set_nthreads(th);
+        for run in 0..runs {
+            CUR_RUN.store(run as u64, Ordering::Relaxed);
+            println!("LOAD threads={th} run={run} load1={:.2}", load1());
+            set_burble(0);
+            let mut prev_live: Vec<u32> = (0..s.n as u32).collect();
+            // depth 0: the same for all three paths; B also keeps the maps on the host
+            let wall = Instant::now();
+            let mut kept = None;
+            let (rows, fp, _) = hierarchy_keep(&a0, cap0, stop0, &ops, Some(&mut kept));
+            assert_eq!(fp, fp0, "CHECK FAILED: depth-0 hierarchy differs across runs/threads");
+            let mut tk = Timer::default();
+            let mut parent = depth0_parent(&a0rc, kept.take().unwrap(), &mut tk);
+            // the design's split reads the parent depth's matrix: A_{d+1}<A_d, struct> = M ANY_PAIR M'
+            let mut prev_q0: Rc<M> = a0rc.clone();
+            let r0: f64 = rows.iter().map(|r| r.4 .0.values().sum::<f64>()).sum();
+            for (l, (ln, nnz, rounds, two, tt)) in rows.iter().enumerate() {
+                println!("RLVL threads={th} run={run} depth=0 level={l} n={ln} nnz={nnz} rounds={rounds} twohop={} {}", *two as u8, fmt_timer(tt));
+            }
+            println!(
+                "DEPTHX threads={th} run={run} depth=0 method=R total={r0:.6} split=0 extra=0 levels={} wall={:.6}",
+                rows.len(),
+                wall.elapsed().as_secs_f64()
+            );
+            for m in ["B1", "B2"] {
+                println!("DEPTHX threads={th} run={run} depth=0 method={m} total={:.6} split=0 extra={:.6} levels={}", r0 + tk.0["keep"], tk.0["keep"], rows.len());
+            }
+            flush();
+            for d in 1..labels.len() as u32 {
+                let lab = &labels[d as usize];
+                let ncells = lab.active.len();
+                let live: Vec<u32> = (0..s.n as u32).filter(|&v| (lab.grp[v as usize] as usize) < ncells && lab.active[lab.grp[v as usize] as usize]).collect();
+                if live.is_empty() {
+                    break;
+                }
+                let cells_act = lab.active.iter().filter(|&&a| a).count() as u64;
+                set_burble(d);
+                // shared fine split (charged to every path)
+                let mut st = Timer::default();
+                let q0 = split_live(&prev_q0, &live, &lab.grp, ncells as u64, &ops, &mut st, d);
+                {
+                    let mut want = 0u64;
+                    for &u in &live {
+                        let gu = lab.grp[u as usize];
+                        for &v in &s.j[s.p[u as usize] as usize..s.p[u as usize + 1] as usize] {
+                            want += (lab.grp[v as usize] == gu) as u64;
+                        }
+                    }
+                    assert_eq!(q0.nvals(), want, "CHECK FAILED: split pattern (depth {d})");
+                }
+                let split_t: f64 = st.0.values().sum();
+                if audit("inplace") {
+                    abeg("splitinplace");
+                    let t_h = Instant::now();
+                    let mut keep = vec![false; s.n];
+                    for &v in &live {
+                        keep[v as usize] = true;
+                    }
+                    let mut dl: Vec<u64> = prev_live.iter().filter(|&&v| !keep[v as usize]).map(|&v| v as u64).collect();
+                    if abrk("splitinplace") && !dl.is_empty() {
+                        dl.remove(0);
+                    }
+                    let host = t_h.elapsed().as_secs_f64();
+                    let i0 = instr();
+                    let (p, ndel, ph) = inplace_delete_insert(&prev_q0, &dl, n, None);
+                    let i1 = instr();
+                    let dupi = {
+                        let a0 = instr();
+                        let mut dd = null();
+                        ok!(GrB_Matrix_dup(&mut dd, prev_q0.0));
+                        let dd = M(dd);
+                        dd.wait();
+                        let a1 = instr();
+                        drop(dd);
+                        a1.0 - a0.0
+                    };
+                    let offi: u64 = st.1.values().map(|x| x.0).sum();
+                    println!("AUDITI2 kind=split depth={d} official_instr={offi} probe_instr={}", (i1.0 - i0.0).saturating_sub(dupi));
+                    aend();
+                    let a = mat_tuples(&p);
+                    let b = mat_tuples(&q0);
+                    assert!(a == b, "AUDIT CHECK FAILED: in-place fine split differs (depth {d}, nnz {} vs {})", a.0.len(), b.0.len());
+                    println!(
+                        "AUDITSPLIT threads={th} run={run} depth={d} nnz_prev={} nnz_new={} drop_rows={} del={ndel} official={split_t:.6} probe={:.6} host={host:.6} del_t={:.6} wait_t={:.6}",
+                        prev_q0.nvals(),
+                        q0.nvals(),
+                        dl.len(),
+                        host + ph[3],
+                        ph[0],
+                        ph[2]
+                    );
+                }
+                prev_live = live.clone();
+                let q0 = Rc::new(q0);
+                // R: compact the active vertices, then today's re-coarsening
+                let mut rt = Timer::default();
+                let qc = if (live.len() as u64) < n {
+                    Some(rt.time("compact", || {
+                        let ii: Vec<u64> = live.iter().map(|&v| v as u64).collect();
+                        let qc = M::new(t_i32(), ii.len() as u64, ii.len() as u64);
+                        ok!(GrB_Matrix_extract(qc.0, null(), null(), q0.0, ii.as_ptr(), ii.len() as u64, ii.as_ptr(), ii.len() as u64, null()));
+                        qc.wait();
+                        qc
+                    }))
+                } else {
+                    None
+                };
+                let ra = qc.as_ref().unwrap_or(&q0);
