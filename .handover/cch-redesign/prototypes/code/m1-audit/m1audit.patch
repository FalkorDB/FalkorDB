+// ---- user operators (these are what a PreJIT harvest would have to cover) ----
+fn fmix32(mut h: u32) -> u32 {
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x85eb_ca6b);
+    h ^= h >> 13;
+    h = h.wrapping_mul(0xc2b2_ae35);
+    h ^= h >> 16;
+    h
+}
+fn unfmix32(mut h: u32) -> u32 {
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x7ed1_b41d);
+    h ^= (h >> 13) ^ (h >> 26);
+    h = h.wrapping_mul(0xa5cb_9243);
+    h ^= h >> 16;
+    h
+}
+/// K(i,j) = (A(i,j) << 32) | fmix32(j ^ salt): unique per row, so MAX is deterministic.
+unsafe extern "C" fn key_op(
+    z: *mut c_void,
+    x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    y: *const c_void,
+) {
+    unsafe {
+        let w = *(x as *const i32) as u32 as u64;
+        let salt = *(y as *const u64) as u32;
+        *(z as *mut u64) = (w << 32) | fmix32((j as u32) ^ salt) as u64;
+    }
+}
+/// The column a key was made from.
+unsafe extern "C" fn unkey_op(
+    z: *mut c_void,
+    x: *const c_void,
+    _i: GrB_Index,
+    _j: GrB_Index,
+    y: *const c_void,
+) {
+    unsafe {
+        let k = *(x as *const u64);
+        let salt = *(y as *const u64) as u32;
+        *(z as *mut u64) = (unfmix32(k as u32) ^ salt) as u64;
+    }
+}
+unsafe extern "C" fn even_op(
+    z: *mut c_void,
+    _x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    _y: *const c_void,
+) {
+    unsafe { *(z as *mut bool) = j & 1 == 0 };
+}
+unsafe extern "C" fn odd_op(
+    z: *mut c_void,
+    _x: *const c_void,
+    _i: GrB_Index,
+    j: GrB_Index,
+    _y: *const c_void,
+) {
+    unsafe { *(z as *mut bool) = j & 1 == 1 };
+}
+
+struct Ops {
+    key: GrB_IndexUnaryOp,
+    unkey: GrB_IndexUnaryOp,
+    even: GrB_IndexUnaryOp,
+    odd: GrB_IndexUnaryOp,
+    one_i32: GrB_Scalar,
+}
+impl Ops {
+    fn new() -> Ops {
+        let mut key = null();
+        let mut unkey = null();
+        let mut even = null();
+        let mut odd = null();
+        if env("M1_NAMED_OPS").is_some() {
+            let kd = c"void m1_key (uint64_t *z, const int32_t *x, uint64_t i, uint64_t j, const uint64_t *y) { uint32_t h = ((uint32_t) j) ^ ((uint32_t) (*y)) ; h ^= h >> 16 ; h *= 0x85ebca6bu ; h ^= h >> 13 ; h *= 0xc2b2ae35u ; h ^= h >> 16 ; (*z) = (((uint64_t) (uint32_t) (*x)) << 32) | (uint64_t) h ; }";
+            let ud = c"void m1_unkey (uint64_t *z, const uint64_t *x, uint64_t i, uint64_t j, const uint64_t *y) { uint32_t h = (uint32_t) (*x) ; h ^= h >> 16 ; h *= 0x7ed1b41du ; h ^= (h >> 13) ^ (h >> 26) ; h *= 0xa5cb9243u ; h ^= h >> 16 ; (*z) = (uint64_t) (h ^ ((uint32_t) (*y))) ; }";
+            let ed = c"void m1_even (bool *z, const int64_t *x, uint64_t i, uint64_t j, const int64_t *y) { (*z) = ((j & 1) == 0) ; }";
+            let od = c"void m1_odd (bool *z, const int64_t *x, uint64_t i, uint64_t j, const int64_t *y) { (*z) = ((j & 1) == 1) ; }";
+            ok!(GxB_IndexUnaryOp_new(&mut key, Some(key_op), t_u64(), t_i32(), t_u64(), c"m1_key".as_ptr(), kd.as_ptr()));
+            ok!(GxB_IndexUnaryOp_new(&mut unkey, Some(unkey_op), t_u64(), t_u64(), t_u64(), c"m1_unkey".as_ptr(), ud.as_ptr()));
+            ok!(GxB_IndexUnaryOp_new(&mut even, Some(even_op), t_bool(), t_i64(), t_i64(), c"m1_even".as_ptr(), ed.as_ptr()));
+            ok!(GxB_IndexUnaryOp_new(&mut odd, Some(odd_op), t_bool(), t_i64(), t_i64(), c"m1_odd".as_ptr(), od.as_ptr()));
+            println!("OPS: named");
+        } else {
+            ok!(GrB_IndexUnaryOp_new(&mut key, Some(key_op), t_u64(), t_i32(), t_u64()));
+            ok!(GrB_IndexUnaryOp_new(&mut unkey, Some(unkey_op), t_u64(), t_u64(), t_u64()));
+            ok!(GrB_IndexUnaryOp_new(&mut even, Some(even_op), t_bool(), t_i64(), t_i64()));
+            ok!(GrB_IndexUnaryOp_new(&mut odd, Some(odd_op), t_bool(), t_i64(), t_i64()));
+        }
+        let mut one_i32 = null();
+        ok!(GrB_Scalar_new(&mut one_i32, t_i32()));
+        ok!(GrB_Scalar_setElement_INT32(one_i32, 1));
+        Ops { key, unkey, even, odd, one_i32 }
+    }
+}
