+#[test]
+#[ignore]
+fn m1_coarsen() {
+    ensure_init();
+    for x in [0u32, 1, 2, 12345, 0xFFFF_FFFF, 0xDEAD_BEEF] {
+        assert_eq!(unfmix32(fmix32(x)), x);
+    }
+    jit_setup();
+    let path = env("M1_GRAPH").expect("M1_GRAPH");
+    let t = Instant::now();
+    let s = load(&path);
+    println!("graph {path}: n={} entries={} load={:.2}s", s.n, s.j.len(), t.elapsed().as_secs_f64());
+    let a0 = to_grb(&s);
+    let ops = Ops::new();
+    let threads: Vec<i32> = env("M1_THREADS").unwrap_or("1,4".into()).split(',').map(|x| x.parse().unwrap()).collect();
+    let runs: usize = env("M1_RUNS").map_or(3, |x| x.parse().unwrap());
+    let max_depth: u32 = env("M1_DEPTHS").map_or(14, |x| x.parse().unwrap());
+    let feral_runs: usize = env("M1_FERAL").map_or(3, |x| x.parse().unwrap());
+
+    // feral: whole ordering time, and its order for the depth>0 cell labels
+    let mut pos = vec![0u64; s.n];
+    if max_depth > 0 || feral_runs > 0 {
+        let mut times = Vec::new();
+        let mut perm0 = None;
+        for r in 0..feral_runs.max(1) {
+            let (perm, sec) = feral_perm(&s);
+            println!("FERAL run={r} sec={sec:.3}");
+            times.push(sec);
+            if let Some(p0) = &perm0 {
+                assert_eq!(p0, &perm, "feral not deterministic");
+            } else {
+                perm0 = Some(perm);
+            }
+            flush();
+        }
+        for (k, &v) in perm0.unwrap().iter().enumerate() {
+            pos[v as usize] = k as u64;
+        }
+    }
+    if burble() {
+        ok!(GxB_Global_Option_set_INT32(GxB_Option_Field::GxB_BURBLE as _, 1));
+    }
+    let n = s.n as u64;
+    let mut fps: BTreeMap<u32, Vec<(u64, u64, i64)>> = BTreeMap::new();
+    for &th in &threads {
+        set_nthreads(th);
+        for run in 0..runs {
+            for d in 0..=max_depth {
+                let cells = 1u64 << d;
+                let mut st = Timer::default();
+                // depth d's block-diagonal matrix: cells = contiguous chunks of feral's order
+                let ad = if d == 0 {
+                    None
+                } else {
+                    let labels: Vec<u32> = (0..s.n).map(|v| (pos[v] * cells / n) as u32).collect();
+                    let ad = split(&a0, &labels, cells, &ops, &mut st);
+                    if !brk("split") || d == 1 {
+                        let want = host_split_count(&s, &labels);
+                        assert_eq!(ad.nvals(), want, "CHECK FAILED: split pattern (depth {d})");
+                    }
+                    Some(ad)
+                };
+                let a = ad.as_ref().unwrap_or(&a0);
+                let cap = ((15 * n / cells) / 1000).max(2) as i32; // 1.5 * cell weight / 100
+                let stop = 100 * cells;
+                let wall = Instant::now();
+                let (rows, fp, l0) = hierarchy(a, cap, stop, &ops);
+                let wall = wall.elapsed().as_secs_f64();
+                if d == 0 {
+                    // (4) once at the top depth: projected (clustered) label, then iid label.
+                    let lab_iid: Vec<u32> = {
+                        let mut r = Rng(7);
+                        (0..s.n).map(|_| (r.next() & 1) as u32).collect()
+                    };
+                    for (name, lab) in [("projected", &l0), ("iid", &lab_iid)] {
+                        let mut t = Timer::default();
+                        let an = split(&a0, lab, 2, &ops, &mut t);
+                        let want = host_split_count(&s, lab);
+                        let got = an.nvals();
+                        println!(
+                            "SPLIT threads={th} run={run} label={name} kept={got} of={} buildM={:.6} mxm={:.6}",
+                            a0.nvals(),
+                            t.0["split_buildM"],
+                            t.0["split_mxm"]
+                        );
+                        assert_eq!(got, want, "CHECK FAILED: split pattern");
+                    }
+                }
+                match fps.get(&d) {
+                    Some(f) => assert_eq!(f, &fp, "CHECK FAILED: hierarchy differs across runs/threads at depth {d}"),
+                    None => {
+                        fps.insert(d, fp.clone());
+                    }
+                }
+                for (l, (ln, nnz, rounds, two, t)) in rows.iter().enumerate() {
+                    let calls: Vec<String> = t.0.iter().map(|(k, v)| format!("{k}={v:.6}")).collect();
+                    println!(
+                        "LVL threads={th} run={run} depth={d} level={l} n={ln} nnz={nnz} rounds={rounds} twohop={} {}",
+                        *two as u8,
+                        calls.join(" ")
+                    );
+                }
+                let spl: f64 = st.0.values().sum();
+                println!(
+                    "DEPTH threads={th} run={run} depth={d} levels={} coarsest={} wall={wall:.6} split={spl:.6}",
+                    rows.len(),
+                    fp.last().map_or(a.nrows(), |x| x.0)
+                );
+                flush();
+            }
+        }
+    }
+}
