+                drop(qc);
+                match fps_r.get(&d) {
+                    Some(f) => assert_eq!(f, &fp, "CHECK FAILED: R hierarchy differs across runs/threads at depth {d}"),
+                    None => {
+                        fps_r.insert(d, fp.clone());
+                    }
+                }
+                let rsum: f64 = rows.iter().map(|r| r.4 .0.values().sum::<f64>()).sum();
+                for (l, (ln, nnz, rounds, two, tt)) in rows.iter().enumerate() {
+                    println!("RLVL threads={th} run={run} depth={d} level={l} n={ln} nnz={nnz} rounds={rounds} twohop={} {}", *two as u8, fmt_timer(tt));
+                }
+                let rx = rt.0.get("compact").copied().unwrap_or(0.0);
+                println!(
+                    "DEPTHX threads={th} run={run} depth={d} method=R total={:.6} split={split_t:.6} extra={rx:.6} levels={} cells={cells_act} live={nl} cap={cap} coarsest={}",
+                    rsum + split_t + rx,
+                    rows.len(),
+                    fp.last().map_or(nl, |x| x.0)
+                );
+                flush();
+                // B1, B2: no matching after depth 0
+                let mc = MATCH_CALLS.load(Ordering::Relaxed);
+                let _ = bt_take();
+                let b1 = build_b(1, &parent, q0.clone(), lab, &ops);
+                println!("BOOKT threads={th} run={run} depth={d} method=B1 {}", bt_take());
+                let b2 = build_b(2, &parent, q0.clone(), lab, &ops);
+                println!("BOOKT threads={th} run={run} depth={d} method=B2 {}", bt_take());
+                assert_eq!(MATCH_CALLS.load(Ordering::Relaxed), mc, "CHECK FAILED: matching ran after depth 0 (depth {d})");
+                for c in 0..ncells {
+                    if lab.active[c] {
+                        assert_eq!(b2.top[c], lab.lstar[c], "CHECK FAILED: per-cell top level differs from the label pass (depth {d} cell {c})");
+                    }
+                }
+                let fp = compare_b(&b1, &b2, lab, d);
+                match fps_b.get(&d) {
+                    Some(f) => assert_eq!(f, &fp, "CHECK FAILED: B hierarchy differs across runs/threads at depth {d}"),
+                    None => {
+                        fps_b.insert(d, fp.clone());
+                    }
+                }
+                if ti == 0 && run == 0 {
+                    ranout(&b2, parent.len(), d);
+                }
+                for (m, b) in [("B1", &b1), ("B2", &b2)] {
+                    for l in 0..b.lv.len() {
+                        let st = &b.stats[l];
+                        println!(
+                            "BLVL threads={th} run={run} depth={d} method={m} level={l} dim={} live={} nnz={} par={} mixed={} seponly={} pieces={} extras={} rin={} xprev={} {}",
+                            b.lv[l].dim,
+                            b.lv[l].live.len(),
+                            b.lv[l].a.nvals(),
+                            st[0],
+                            st[1],
+                            st[2],
+                            st[3],
+                            st[4],
