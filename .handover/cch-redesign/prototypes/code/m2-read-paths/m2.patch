+#[test]
+#[ignore = "M2 scratch: needs M2_ROAD"]
+fn m2_readonly_load() {
+    ensure_init();
+    let path = std::env::var("M2_ROAD").expect("M2_ROAD");
+    let input = load_input(&path);
+    let topology = Topology::build(&input.skeleton).unwrap();
+    drop(input);
+    let n = topology.node_count() as u64;
+    let triangles: u64 = (0..topology.node_count())
+        .map(|r| {
+            let d = topology.up(Rank::new(r)).len() as u64;
+            d * d.saturating_sub(1) / 2
+        })
+        .sum();
+    let arcs = topology.arc_count() as u64;
+    let (ap64, aj64, ax64) = up_arrays(&topology);
+    drop(topology);
+    println!("n {n}, arcs {arcs}, triangles {triangles}; RSS {:.0} MB", rss_mb());
+
+    unsafe {
+        readonly_case(
+            "u64 p/i/x, readonly",
+            n,
+            &ap64,
+            &aj64,
+            &ax64,
+            GrB_UINT64,
+            GrB_UINT64,
+            GrB_UINT64,
+            triangles,
+            arcs,
+            true,
+        );
+        let ap32: Vec<u32> = ap64.iter().map(|&x| x as u32).collect();
+        let aj32: Vec<u32> = aj64.iter().map(|&x| x as u32).collect();
+        let ax32: Vec<u32> = ax64.iter().map(|&x| x as u32).collect();
+        drop((ap64, aj64, ax64));
+        if let Ok(dump) = std::env::var("M2_DUMP") {
+            let mut bytes: Vec<u8> = Vec::new();
+            bytes.extend_from_slice(&n.to_le_bytes());
+            bytes.extend_from_slice(&triangles.to_le_bytes());
+            for v in [&ap32, &aj32, &ax32] {
+                bytes.extend_from_slice(&(v.len() as u64).to_le_bytes());
+                for x in v.iter() {
+                    bytes.extend_from_slice(&x.to_le_bytes());
+                }
+            }
+            std::fs::write(&dump, bytes).unwrap();
+            println!("dumped u32 arrays to {dump}");
+        }
+        readonly_case(
+            "u32 p/i/x, readonly",
+            n,
+            &ap32,
+            &aj32,
+            &ax32,
+            GrB_UINT32,
+            GrB_UINT32,
+            GrB_UINT32,
+            triangles,
+            arcs,
+            true,
+        );
+        // deliberate break: same arrays loaded WITHOUT GxB_IS_READONLY (ownership moves to
+        // GraphBLAS). The free check must fire. Copies, leaked afterwards so Rust never frees
+        // what GraphBLAS already freed.
+        let (bp, bj, bx) = (ap32.clone(), aj32.clone(), ax32.clone());
+        readonly_case(
+            "BREAK u32, GrB_DEFAULT handling",
+            n,
+            &bp,
+            &bj,
+            &bx,
+            GrB_UINT32,
+            GrB_UINT32,
+            GrB_UINT32,
+            triangles,
+            arcs,
+            false,
+        );
+        std::mem::forget((bp, bj, bx));
+    }
+}
+
+/// Part 2 again, from a dump of the u32 arrays, so the lifetime peak footprint is the
+/// arrays' and not the ordering's: the peak delta across each op is its transient.
+#[test]
+#[ignore = "M2 scratch: needs M2_DUMP"]
+fn m2_readonly_peak() {
+    ensure_init();
+    let bytes = std::fs::read(std::env::var("M2_DUMP").expect("M2_DUMP")).unwrap();
+    let rd = |o: usize| u64::from_le_bytes(bytes[o..o + 8].try_into().unwrap());
+    let n = rd(0);
+    let triangles = rd(8);
+    let mut off = 16;
+    let mut arrs: Vec<Vec<u32>> = Vec::new();
+    for _ in 0..3 {
+        let len = rd(off) as usize;
+        off += 8;
+        arrs.push(
+            bytes[off..off + 4 * len]
+                .chunks(4)
+                .map(|c| u32::from_le_bytes(c.try_into().unwrap()))
+                .collect(),
+        );
+        off += 4 * len;
+    }
+    drop(bytes);
+    let arcs = arrs[1].len() as u64;
+    println!(
+        "from dump: n {n}, arcs {arcs}; footprint {:.0} MB, peak {:.0} MB",
+        rss_mb(),
+        peak_mb()
+    );
+    if std::env::var("M2_BURBLE").is_ok() {
+        crate::graph::graphblas::matrix::burble(true);
+    }
+    unsafe {
+        readonly_case(
+            "peak u32, readonly",
+            n,
+            &arrs[0],
+            &arrs[1],
+            &arrs[2],
+            GrB_UINT32,
+            GrB_UINT32,
+            GrB_UINT32,
+            triangles,
+            arcs,
+            true,
+        );
+    }
+    crate::graph::graphblas::matrix::burble(false);
+}
