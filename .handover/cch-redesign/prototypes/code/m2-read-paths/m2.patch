+//! SCRATCH (M2 prototype, never committed): read paths for the CCH topology.
+//!
+//! Part 1: customization and query reading `up(r)` (a) as today's flat arrays, (b) through
+//! a GraphBLAS UINT64 matrix in rank space whose values are arc ids, rows read by row
+//! iterators (one iterator per role, re-seeked per row).
+//! Part 2: Rust-owned CSR loaded read-only into a GrB_Matrix (GxB_Vector_load +
+//! GxB_IS_READONLY + GxB_load_Matrix_from_Container), transpose + masked mxm on it.
+//!
+//! Run:
+//!   M2_ROAD=/path/roadNet-CA.txt cargo test --release -p graph --features index-falkordb \
+//!     m2_ -- --ignored --nocapture --test-threads=1
+
+#![allow(clippy::all, clippy::pedantic, unused)]
+
+use std::ffi::c_void;
+use std::mem::MaybeUninit;
+use std::ptr::null_mut;
+use std::time::Instant;
+
+use rustc_hash::FxHashMap;
