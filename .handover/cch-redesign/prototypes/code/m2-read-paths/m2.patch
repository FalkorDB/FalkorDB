+// ---------------------------------------------------------------- the read seam
+
+/// Everything customization and query read of the upward topology.
+trait UpRows {
+    /// Start reading row `r` (a rank index).
+    fn open(
+        &mut self,
+        r: usize,
+    );
+    /// Next `(upper rank index, arc id)` of the open row, ascending.
+    fn next(&mut self) -> Option<(usize, usize)>;
+    /// Arc id of `lo < hi`, or None.
+    fn slot(
+        &mut self,
+        lo: usize,
+        hi: usize,
+    ) -> Option<usize>;
+}
+
+/// (a) today's flat arrays.
+struct FlatRows<'a> {
+    t: &'a Topology,
+    row: &'a [Rank],
+    start: usize,
+    i: usize,
+}
+impl<'a> FlatRows<'a> {
+    fn new(t: &'a Topology) -> Self {
+        Self {
+            t,
+            row: &[],
+            start: 0,
+            i: 0,
+        }
+    }
+}
+impl UpRows for FlatRows<'_> {
+    #[inline]
+    fn open(
+        &mut self,
+        r: usize,
+    ) {
+        let rank = Rank::new(r);
+        self.row = self.t.up(rank);
+        self.start = self.t.up_range(rank).start;
+        self.i = 0;
+    }
+    #[inline]
+    fn next(&mut self) -> Option<(usize, usize)> {
+        let above = *self.row.get(self.i)?;
+        let out = (above.index(), self.start + self.i);
+        self.i += 1;
+        Some(out)
+    }
+    #[inline]
+    fn slot(
+        &mut self,
+        lo: usize,
+        hi: usize,
+    ) -> Option<usize> {
+        self.t.arc_slot(Rank::new(lo), Rank::new(hi))
+    }
+}
+
+/// (b1) GraphBLAS matrix through matrix.rs's `Iter<Uint64Extract>` wrapper, re-seeked per row;
+/// point lookups with `GrB_Matrix_extractElement_UINT64` (`Matrix<u64>::get`).
+struct GrbWrapRows<'a> {
+    m: &'a Matrix<u64>,
+    it: Iter<Uint64Extract>,
+    seeks: u64,
+}
+impl<'a> GrbWrapRows<'a> {
+    fn new(m: &'a Matrix<u64>) -> Self {
+        Self {
+            m,
+            it: Iter::detached(m),
+            seeks: 0,
+        }
+    }
+}
+impl UpRows for GrbWrapRows<'_> {
+    #[inline]
+    fn open(
+        &mut self,
+        r: usize,
+    ) {
+        self.seeks += 1;
+        self.it.seek(r as u64, r as u64);
+    }
+    #[inline]
+    fn next(&mut self) -> Option<(usize, usize)> {
+        self.it.next().map(|(_, c, v)| (c as usize, v as usize))
+    }
+    #[inline]
+    fn slot(
+        &mut self,
+        lo: usize,
+        hi: usize,
+    ) -> Option<usize> {
+        self.m.get(lo as u64, hi as u64).map(|v| v as usize)
+    }
+}
+
+/// (b2) the leanest row-iterator use: seekRow, then getColIndex + get_UINT64 + nextCol per
+/// entry, no row-index reads, no nextRow. Same point lookup as (b1).
+struct GrbLeanRows<'a> {
+    m: &'a Matrix<u64>,
+    it: GxB_Iterator,
+    live: bool,
+    seeks: u64,
+}
+impl<'a> GrbLeanRows<'a> {
+    fn new(m: &'a Matrix<u64>) -> Self {
+        m.wait();
+        unsafe {
+            let mut it: GxB_Iterator = null_mut();
+            assert_eq!(GxB_Iterator_new(&raw mut it), GrB_Info::GrB_SUCCESS);
+            assert_eq!(
+                GxB_rowIterator_attach(it, m.inner(), null_mut()),
+                GrB_Info::GrB_SUCCESS
+            );
+            Self {
+                m,
+                it,
+                live: false,
+                seeks: 0,
+            }
+        }
+    }
+}
+impl Drop for GrbLeanRows<'_> {
+    fn drop(&mut self) {
+        unsafe {
+            GxB_Iterator_free(&raw mut self.it);
+        }
+    }
+}
+impl UpRows for GrbLeanRows<'_> {
+    #[inline]
+    fn open(
+        &mut self,
+        r: usize,
+    ) {
+        self.seeks += 1;
+        self.live = unsafe { GxB_rowIterator_seekRow(self.it, r as u64) } == GrB_Info::GrB_SUCCESS;
+    }
+    #[inline]
+    fn next(&mut self) -> Option<(usize, usize)> {
+        if !self.live {
+            return None;
+        }
+        unsafe {
+            let c = GxB_rowIterator_getColIndex(self.it);
+            let v = GxB_Iterator_get_UINT64(self.it);
+            self.live = GxB_rowIterator_nextCol(self.it) == GrB_Info::GrB_SUCCESS;
+            Some((c as usize, v as usize))
+        }
+    }
+    #[inline]
+    fn slot(
+        &mut self,
+        lo: usize,
+        hi: usize,
+    ) -> Option<usize> {
+        self.m.get(lo as u64, hi as u64).map(|v| v as usize)
+    }
+}
+
+/// `Up` as a UINT64 GrB_Matrix in rank space, value = arc id, built from the topology.
+fn up_matrix(t: &Topology) -> Matrix<u64> {
+    let n = t.node_count();
+    let arcs = t.arc_count();
+    let (mut rows, mut cols, mut vals) = (
+        Vec::with_capacity(arcs),
+        Vec::with_capacity(arcs),
+        Vec::with_capacity(arcs),
+    );
+    for r in 0..n {
+        let rank = Rank::new(r);
+        for (slot, &hi) in t.up_range(rank).zip(t.up(rank)) {
+            rows.push(r as u64);
+            cols.push(hi.index() as u64);
+            vals.push(slot as u64);
+        }
+    }
+    if std::env::var("M2_BREAK_IDS").is_ok() {
+        // deliberate break: swap the ids of the first two arcs of every 1000th rank's row
+        let mut k = 0;
+        let mut swapped = 0;
+        for r in 0..n {
+            let len = t.up(Rank::new(r)).len();
+            if r % 1000 == 0 && len >= 2 {
+                vals.swap(k, k + 1);
+                swapped += 1;
+            }
+            k += len;
+        }
+        println!("BREAK: swapped arc ids in {swapped} rows of the GrB matrix");
+    }
+    let mut m = Matrix::<u64>::new(n as u64, n as u64);
+    m.build(&rows, &cols, &vals);
+    m.wait();
+    m
+}
+
+// ---------------------------------------------------------------- customization over the seam
+
+struct Buffers {
+    up_w: Vec<f64>,
+    dn_w: Vec<f64>,
+    up_m: Vec<Option<Rank>>,
+    dn_m: Vec<Option<Rank>>,
+}
+
+/// validate (an arc for every entry, weights >= 0) + seed + relax, reading `Up` only through
+/// `rows` (x's row is buffered: it is re-read pairwise; y's row is streamed by `rows_y`).
+#[derive(Default, Debug, Clone, Copy)]
+struct Phases {
+    validate: f64,
+    seed: f64,
+    relax: f64,
+}
+
+fn customize_with<R: UpRows>(
+    t: &Topology,
+    w: &WeightCsr,
+    rows_x: &mut R,
+    rows_y: &mut R,
+) -> (Buffers, Phases) {
+    let mut ph = Phases::default();
+    let entries = || w.entries();
+    // validate
+    let t0 = Instant::now();
+    for (u, v, weight) in entries() {
+        if u == v {
+            continue;
+        }
+        let (ru, rv) = (
+            t.rank_of(NodeId::from(u)).index(),
+            t.rank_of(NodeId::from(v)).index(),
+        );
+        assert!(rows_x.slot(ru.min(rv), ru.max(rv)).is_some());
+        assert!(!(weight.is_nan() || weight < 0.0));
+    }
+    ph.validate = t0.elapsed().as_secs_f64();
+    // seed
+    let t0 = Instant::now();
+    let arcs = t.arc_count();
+    let mut b = Buffers {
+        up_w: vec![f64::INFINITY; arcs],
+        dn_w: vec![f64::INFINITY; arcs],
+        up_m: vec![None; arcs],
+        dn_m: vec![None; arcs],
+    };
+    for (u, v, weight) in entries() {
+        if u == v {
+            continue;
+        }
+        let (ru, rv) = (
+            t.rank_of(NodeId::from(u)).index(),
+            t.rank_of(NodeId::from(v)).index(),
+        );
+        let slot = rows_x.slot(ru.min(rv), ru.max(rv)).unwrap();
+        if ru < rv {
+            b.up_w[slot] = weight;
+        } else {
+            b.dn_w[slot] = weight;
+        }
+    }
+    ph.seed = t0.elapsed().as_secs_f64();
+    // relax
+    let t0 = Instant::now();
+    let mut xrow: Vec<(usize, usize)> = Vec::new();
+    for x in 0..t.node_count() {
+        xrow.clear();
+        rows_x.open(x);
+        while let Some(e) = rows_x.next() {
+            xrow.push(e);
+        }
+        for i in 0..xrow.len() {
+            if i + 1 == xrow.len() {
+                break; // no z above y: today's loop body does nothing either
+            }
+            let (y, sxy) = xrow[i];
+            let x_to_y = b.up_w[sxy];
+            let y_to_x = b.dn_w[sxy];
+            rows_y.open(y);
+            for &(z, sxz) in &xrow[i + 1..] {
+                let x_to_z = b.up_w[sxz];
+                let z_to_x = b.dn_w[sxz];
+                let slot = loop {
+                    let (above, s) = rows_y
+                        .next()
+                        .unwrap_or_else(|| panic!("chordal closure broken: {y} {z}"));
+                    if above == z {
+                        break s;
+                    }
+                };
+                let through = y_to_x + x_to_z;
+                if through < b.up_w[slot] {
+                    b.up_w[slot] = through;
+                    b.up_m[slot] = Some(Rank::new(x));
+                }
+                let through = z_to_x + x_to_y;
+                if through < b.dn_w[slot] {
+                    b.dn_w[slot] = through;
+                    b.dn_m[slot] = Some(Rank::new(x));
+                }
+            }
+        }
+    }
+    ph.relax = t0.elapsed().as_secs_f64();
+    (b, ph)
+}
+
+/// Bitwise equal to today's metric, slot by slot. Returns the count of differing slots.
+fn diff_metric(
+    m: &Metric,
+    b: &Buffers,
+) -> usize {
+    let mut d = 0;
+    for s in 0..b.up_w.len() {
+        if m.upward_weight[s].to_bits() != b.up_w[s].to_bits()
+            || m.downward_weight[s].to_bits() != b.dn_w[s].to_bits()
+            || m.upward_middle[s] != b.up_m[s]
+            || m.downward_middle[s] != b.dn_m[s]
+        {
+            d += 1;
+        }
+    }
+    d
+}
+
+// ---------------------------------------------------------------- query over the seam
+// A copy of query.rs with every read of `Up` going through `UpRows`.
+
+struct Chain {
+    forward: bool,
+    ranks: Vec<usize>,
+    dist: Vec<f64>,
+    pred: Vec<Option<usize>>,
+}
+
+fn chain<R: UpRows>(
+    rows: &mut R,
+    start: usize,
+    forward: bool,
+) -> Chain {
+    let mut ranks = vec![start];
+    let mut r = start;
+    loop {
+        rows.open(r);
+        match rows.next() {
+            Some((p, _)) => {
+                ranks.push(p);
+                r = p;
+            }
+            None => break,
+        }
+    }
+    let mut dist = vec![f64::INFINITY; ranks.len()];
+    dist[0] = 0.0;
+    let pred = vec![None; ranks.len()];
+    Chain {
+        forward,
+        ranks,
+        dist,
+        pred,
+    }
+}
+
+fn gallop_to(
+    ranks: &[usize],
+    from: usize,
+    rank: usize,
+) -> usize {
+    let mut low = from;
+    let mut high = from;
+    let mut step = 1;
+    while high < ranks.len() && ranks[high] < rank {
+        low = high + 1;
+        high += step;
+        step *= 2;
+    }
+    let high = high.min(ranks.len());
+    low + ranks[low..high].partition_point(|&r| r < rank)
+}
+
+fn relax_from<R: UpRows>(
+    c: &mut Chain,
+    rows: &mut R,
+    m: &Metric,
+    at: usize,
+) {
+    let dist = c.dist[at];
+    if dist.is_infinite() {
+        return;
+    }
+    rows.open(c.ranks[at]);
+    let mut position = at + 1;
+    while let Some((above, slot)) = rows.next() {
+        position = gallop_to(&c.ranks, position, above);
+        debug_assert_eq!(c.ranks.get(position), Some(&above));
+        let weight = if c.forward {
+            m.upward_weight[slot]
+        } else {
+            m.downward_weight[slot]
+        };
+        let offer = dist + weight;
+        if offer < c.dist[position] {
+            c.dist[position] = offer;
+            c.pred[position] = Some(at);
+        }
+    }
+}
+
+fn arcs_up_to(
+    c: &Chain,
+    mut at: usize,
+) -> Vec<(usize, usize)> {
+    let mut arcs = Vec::new();
+    while let Some(p) = c.pred[at] {
+        arcs.push((c.ranks[p], c.ranks[at]));
+        at = p;
+    }
+    arcs.reverse();
+    arcs
+}
+
+fn unpack<R: UpRows>(
+    rows: &mut R,
+    m: &Metric,
+    from: usize,
+    to: usize,
+    out: &mut Vec<usize>,
+) -> bool {
+    let mut stack = vec![(from, to)];
+    while let Some((a, b)) = stack.pop() {
+        let Some(slot) = rows.slot(a.min(b), a.max(b)) else {
+            return false;
+        };
+        let middle = if a < b {
+            m.upward_middle[slot]
+        } else {
+            m.downward_middle[slot]
+        };
+        match middle {
+            None => out.push(b),
+            Some(mid) => {
+                let mid = mid.index();
+                stack.push((mid, b));
+                stack.push((a, mid));
+            }
+        }
+    }
+    true
+}
+
+fn erase_loops(route: &mut Vec<u64>) {
+    let mut at: FxHashMap<u64, usize> = FxHashMap::default();
+    let mut out = 0;
+    for i in 0..route.len() {
+        let r = route[i];
+        if let Some(&first) = at.get(&r) {
+            for &gone in &route[first + 1..out] {
+                at.remove(&gone);
+            }
+            out = first + 1;
+        } else {
+            at.insert(r, out);
+            route[out] = r;
+            out += 1;
+        }
+    }
+    route.truncate(out);
+}
+
+fn query_with<R: UpRows>(
+    cch: &Cch,
+    rows: &mut R,
+    src: u64,
+    dst: u64,
+) -> Option<(f64, Vec<u64>)> {
+    let n = cch.node_count();
+    if src as usize >= n || dst as usize >= n {
+        return None;
+    }
+    if src == dst {
+        return Some((0.0, vec![src]));
+    }
+    let t = cch.topology();
+    let m = &cch.metric;
+    let src_rank = t.rank_of(NodeId::from(src)).index();
+    let mut fw = chain(rows, src_rank, true);
+    let mut bw = chain(rows, t.rank_of(NodeId::from(dst)).index(), false);
+    let shared = fw
+        .ranks
+        .iter()
+        .rev()
+        .zip(bw.ranks.iter().rev())
+        .take_while(|(a, b)| a == b)
+        .count();
+    if shared == 0 {
+        return None;
+    }
+    let ff = fw.ranks.len() - shared;
+    let bf = bw.ranks.len() - shared;
+    for at in 0..ff {
+        relax_from(&mut fw, rows, m, at);
+    }
+    for at in 0..bf {
+        relax_from(&mut bw, rows, m, at);
+    }
+    let mut best = f64::INFINITY;
+    let mut meet = None;
+    for off in 0..shared {
+        let (fa, ba) = (ff + off, bf + off);
+        let (fd, bd) = (fw.dist[fa], bw.dist[ba]);
+        if fd + bd < best {
+            best = fd + bd;
+            meet = Some(off);
+        }
+        if fd < best {
+            relax_from(&mut fw, rows, m, fa);
+        }
+        if bd < best {
+            relax_from(&mut bw, rows, m, ba);
+        }
+    }
+    let meet = meet?;
+    let mut route = arcs_up_to(&fw, ff + meet);
+    route.extend(
+        arcs_up_to(&bw, bf + meet)
+            .into_iter()
+            .rev()
+            .map(|(lo, hi)| (hi, lo)),
+    );
+    let mut ranks = vec![src_rank];
+    for (a, b) in route {
+        if !unpack(rows, m, a, b, &mut ranks) {
+            return None;
+        }
+    }
+    let mut nodes: Vec<u64> = ranks
+        .into_iter()
+        .map(|r| u64::from(t.node_of(Rank::new(r))))
+        .collect();
+    erase_loops(&mut nodes);
+    Some((best, nodes))
+}
+
+type Answer = Option<(f64, Vec<u64>)>;
+
+/// One pass over all queries, each timed alone (µs).
+fn time_queries(
+    queries: &[(u64, u64)],
+    mut f: impl FnMut(u64, u64) -> Answer,
+) -> (Vec<f64>, Vec<Answer>) {
+    let mut lat = Vec::with_capacity(queries.len());
+    let mut ans = Vec::with_capacity(queries.len());
+    for &(s, t) in queries {
+        let t0 = Instant::now();
+        let a = f(s, t);
+        lat.push(t0.elapsed().as_secs_f64() * 1e6);
+        ans.push(a);
+    }
+    (lat, ans)
+}
+
+fn same_answers(
+    a: &[Answer],
+    b: &[Answer],
+) -> (usize, usize) {
+    // (distance mismatches, path mismatches)
+    let mut dist = 0;
+    let mut path = 0;
+    for (x, y) in a.iter().zip(b) {
+        match (x, y) {
+            (None, None) => {}
+            (Some((dx, px)), Some((dy, py))) => {
+                if dx.to_bits() != dy.to_bits() {
+                    dist += 1;
+                }
+                if px != py {
+                    path += 1;
+                }
+            }
+            _ => {
+                dist += 1;
+                path += 1;
+            }
+        }
+    }
+    (dist, path)
+}
