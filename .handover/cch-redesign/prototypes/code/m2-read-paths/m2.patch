+// ---------------------------------------------------------------- part 2: read-only load
+
+unsafe extern "C" {
+    fn malloc_size(ptr: *const c_void) -> usize;
+}
+
+fn checksum<T: Copy>(v: &[T]) -> u64 {
+    let bytes =
+        unsafe { std::slice::from_raw_parts(v.as_ptr().cast::<u8>(), std::mem::size_of_val(v)) };
+    let mut h = 0xcbf2_9ce4_8422_2325u64;
+    for chunk in bytes.chunks(8) {
+        let mut w = [0u8; 8];
+        w[..chunk.len()].copy_from_slice(chunk);
+        h = (h ^ u64::from_le_bytes(w)).wrapping_mul(0x100_0000_01b3);
+    }
+    h
+}
+
+/// A dense GrB_Vector over `v`'s memory. `readonly` = GxB_IS_READONLY, else ownership moves.
+unsafe fn load_vec<T>(
+    v: &[T],
+    ty: GrB_Type,
+    readonly: bool,
+) -> GrB_Vector {
+    unsafe {
+        let mut vec: GrB_Vector = null_mut();
+        assert_eq!(GrB_Vector_new(&raw mut vec, ty, 0), GrB_Info::GrB_SUCCESS);
+        let mut p = v.as_ptr() as *mut c_void;
+        let handling = if readonly {
+            GxB_Option_Field::GxB_IS_READONLY as i32
+        } else {
+            0
+        };
+        let info = GxB_Vector_load(
+            vec,
+            &raw mut p,
+            ty,
+            v.len() as u64,
+            std::mem::size_of_val(v) as u64,
+            handling,
+            null_mut(),
+        );
+        assert_eq!(info, GrB_Info::GrB_SUCCESS, "GxB_Vector_load");
+        vec
+    }
+}
+
+/// Load (Ap, Aj, Ax) as an n x n sparse row-major matrix. Vectors are put straight into a
+/// container; the container's own empty vectors are freed first.
+unsafe fn load_csr<P, J, X>(
+    n: u64,
+    ap: &[P],
+    aj: &[J],
+    ax: &[X],
+    tp: GrB_Type,
+    tj: GrB_Type,
+    tx: GrB_Type,
+    readonly: bool,
+) -> GrB_Matrix {
+    unsafe {
+        let mut c: GxB_Container = null_mut();
+        assert_eq!(GxB_Container_new(&raw mut c), GrB_Info::GrB_SUCCESS);
+        for v in [&mut (*c).p, &mut (*c).i, &mut (*c).x] {
+            if !v.is_null() {
+                GrB_Vector_free(v);
+            }
+        }
+        (*c).p = load_vec(ap, tp, readonly);
+        (*c).i = load_vec(aj, tj, readonly);
+        (*c).x = load_vec(ax, tx, readonly);
+        (*c).nrows = n;
+        (*c).ncols = n;
+        (*c).nrows_nonempty = -1;
+        (*c).ncols_nonempty = -1;
+        (*c).nvals = aj.len() as u64;
+        (*c).format = GxB_SPARSE as i32;
+        (*c).orientation = GrB_Orientation::GrB_ROWMAJOR as i32;
+        (*c).iso = false;
+        (*c).jumbled = false;
+        let mut a: GrB_Matrix = null_mut();
+        assert_eq!(GrB_Matrix_new(&raw mut a, tx, 0, 0), GrB_Info::GrB_SUCCESS);
+        let info = GxB_load_Matrix_from_Container(a, c, null_mut());
+        assert_eq!(info, GrB_Info::GrB_SUCCESS, "load from container");
+        assert_eq!(GxB_Container_free(&raw mut c), GrB_Info::GrB_SUCCESS);
+        a
+    }
+}
+
+fn get_i32(
+    a: GrB_Matrix,
+    field: GxB_Option_Field,
+) -> i32 {
+    let mut v = 0i32;
+    unsafe { GrB_Matrix_get_INT32(a, &raw mut v, field as i32) };
+    v
+}
+
+fn mem_usage(a: GrB_Matrix) -> usize {
+    let mut s = 0usize;
+    unsafe { GxB_Matrix_memoryUsage(&raw mut s, a) };
+    s
+}
+
+/// Rank-space Up of a topology as (Ap, Aj, Ax) with index type I and value type X.
+fn up_arrays(t: &Topology) -> (Vec<u64>, Vec<u64>, Vec<u64>) {
+    let n = t.node_count();
+    let mut ap = Vec::with_capacity(n + 1);
+    let mut aj = Vec::with_capacity(t.arc_count());
+    let mut ax = Vec::with_capacity(t.arc_count());
+    ap.push(0u64);
+    for r in 0..n {
+        let rank = Rank::new(r);
+        for (slot, &hi) in t.up_range(rank).zip(t.up(rank)) {
+            aj.push(hi.index() as u64);
+            ax.push(slot as u64);
+        }
+        ap.push(aj.len() as u64);
+    }
+    (ap, aj, ax)
+}
+
+fn readonly_case<P: Copy, J: Copy, X: Copy>(
+    label: &str,
+    n: u64,
+    ap: &[P],
+    aj: &[J],
+    ax: &[X],
+    tp: GrB_Type,
+    tj: GrB_Type,
+    tx: GrB_Type,
+    triangles: u64,
+    down_nvals_expect: u64,
+    readonly: bool,
+) {
+    let sums = (checksum(ap), checksum(aj), checksum(ax));
+    let bytes = std::mem::size_of_val(ap) + std::mem::size_of_val(aj) + std::mem::size_of_val(ax);
+    let live_before = unsafe {
+        (
+            malloc_size(ap.as_ptr().cast()),
+            malloc_size(aj.as_ptr().cast()),
+            malloc_size(ax.as_ptr().cast()),
+        )
+    };
+    let rss0 = rss_mb();
+    let t0 = Instant::now();
+    let mut a = unsafe { load_csr(n, ap, aj, ax, tp, tj, tx, readonly) };
+    let load_us = t0.elapsed().as_secs_f64() * 1e6;
+    let rss1 = rss_mb();
+    let mut nv = 0u64;
+    unsafe { GrB_Matrix_nvals(&raw mut nv, a) };
+    println!(
+        "[{label}] arrays {:.1} MB; load {load_us:.0} us; RSS {rss0:.0} -> {rss1:.0} MB; nvals {nv}; IS_READONLY {}; offset/row/col index bits {}/{}/{}; memoryUsage(A) {} B; peak {:.0} MB",
+        bytes as f64 / 1e6,
+        get_i32(a, GxB_Option_Field::GxB_IS_READONLY),
+        get_i32(a, GxB_Option_Field::GxB_OFFSET_INTEGER_BITS),
+        get_i32(a, GxB_Option_Field::GxB_ROWINDEX_INTEGER_BITS),
+        get_i32(a, GxB_Option_Field::GxB_COLINDEX_INTEGER_BITS),
+        mem_usage(a),
+        peak_mb(),
+    );
+    unsafe {
+        if readonly {
+            // read-only is enforced on outputs
+            let info = GrB_Matrix_setElement_UINT32(a, 7, 0, 0);
+            println!("[{label}] setElement on A -> {info:?}");
+            let info = GrB_transpose(a, null_mut(), null_mut(), a, null_mut());
+            println!("[{label}] in-place transpose of A -> {info:?}");
+        }
+
+        // transpose
+        let mut d: GrB_Matrix = null_mut();
+        assert_eq!(
+            GrB_Matrix_new(&raw mut d, tx, n, n),
+            GrB_Info::GrB_SUCCESS
+        );
+        let t0 = Instant::now();
+        let info = GrB_transpose(d, null_mut(), null_mut(), a, null_mut());
+        let tr_ms = t0.elapsed().as_secs_f64() * 1e3;
+        assert_eq!(info, GrB_Info::GrB_SUCCESS);
+        GrB_Matrix_wait(d, GrB_WaitMode::GrB_MATERIALIZE as _);
+        let mut dn = 0u64;
+        GrB_Matrix_nvals(&raw mut dn, d);
+        let rss2 = rss_mb();
+        // Down(hi, lo) must carry the same arc id as Up(lo, hi): sum of ids and a spot check
+        let mut sum_ids = 0u64;
+        GrB_Matrix_reduce_UINT64(
+            &raw mut sum_ids,
+            null_mut(),
+            GrB_PLUS_MONOID_UINT64,
+            d,
+            null_mut(),
+        );
+        println!(
+            "[{label}] transpose: {tr_ms:.1} ms, Down nvals {dn} (expect {down_nvals_expect}), sum of ids {sum_ids} (expect {}), memoryUsage(Down) {:.1} MB, footprint -> {rss2:.0} MB, peak {:.0} MB",
+            (nv * nv.saturating_sub(1)) / 2,
+            mem_usage(d) as f64 / 1e6,
+            peak_mb()
+        );
+
+        // masked mxm: C<struct(A)> = A PLUS_PAIR A  ==  per arc (lo,hi), the # of middles j
+        // with lo < j < hi; summed, the triangle count of the chordal supergraph
+        let mut cm: GrB_Matrix = null_mut();
+        assert_eq!(
+            GrB_Matrix_new(&raw mut cm, GrB_UINT64, n, n),
+            GrB_Info::GrB_SUCCESS
+        );
+        let t0 = Instant::now();
+        let info = GrB_mxm(
+            cm,
+            a,
+            null_mut(),
+            GxB_PLUS_PAIR_UINT64,
+            a,
+            a,
+            GrB_DESC_S,
+        );
+        assert_eq!(info, GrB_Info::GrB_SUCCESS, "mxm");
+        GrB_Matrix_wait(cm, GrB_WaitMode::GrB_MATERIALIZE as _);
+        let mxm_ms = t0.elapsed().as_secs_f64() * 1e3;
+        let mut tri = 0u64;
+        GrB_Matrix_reduce_UINT64(
+            &raw mut tri,
+            null_mut(),
+            GrB_PLUS_MONOID_UINT64,
+            cm,
+            null_mut(),
+        );
+        let rss3 = rss_mb();
+        println!(
+            "[{label}] masked mxm: {mxm_ms:.1} ms, sum {tri} (expect triangles {triangles}) {}, memoryUsage(C) {:.1} MB, footprint -> {rss3:.0} MB, peak {:.0} MB",
+            if tri == triangles { "OK" } else { "MISMATCH" },
+            mem_usage(cm) as f64 / 1e6,
+            peak_mb()
+        );
+        println!(
+            "[{label}] memoryUsage(A) after ops {} B (unchanged = no copy kept inside A)",
+            mem_usage(a)
+        );
+
+        let sums_mid = (checksum(ap), checksum(aj), checksum(ax));
+        GrB_Matrix_free(&raw mut cm);
+        GrB_Matrix_free(&raw mut d);
+        GrB_Matrix_free(&raw mut a);
+        // churn the allocator with same-size blocks: a freed array would be reused and dirtied
+        let churn: Vec<Vec<u8>> = [
+            std::mem::size_of_val(ap),
+            std::mem::size_of_val(aj),
+            std::mem::size_of_val(ax),
+        ]
+        .iter()
+        .map(|&len| vec![0xA5u8; len])
+        .collect();
+        let live_after = (
+            malloc_size(ap.as_ptr().cast()),
+            malloc_size(aj.as_ptr().cast()),
+            malloc_size(ax.as_ptr().cast()),
+        );
+        // a freed large block may be unmapped: only read the arrays if they are still allocated
+        let sums_after = if live_after == live_before {
+            Some((checksum(ap), checksum(aj), checksum(ax)))
+        } else {
+            None
+        };
+        drop(churn);
+        println!(
+            "[{label}] arrays unchanged during ops: {}; after GrB_Matrix_free: malloc_size before {:?} after {:?} -> {}; checksums after free+churn {}",
+            sums == sums_mid,
+            live_before,
+            live_after,
+            if live_after == live_before {
+                "still allocated"
+            } else {
+                "FREED BY GRAPHBLAS"
+            },
+            match sums_after {
+                Some(after) if after == sums => "unchanged",
+                Some(_) => "CHANGED",
+                None => "not read (freed)",
+            }
+        );
+    }
+}
