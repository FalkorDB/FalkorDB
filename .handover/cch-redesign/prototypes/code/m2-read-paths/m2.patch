+// ---------------------------------------------------------------- data
+
+fn mix(
+    u: u64,
+    v: u64,
+) -> u64 {
+    let mut h = u.wrapping_mul(0x9E37_79B9_7F4A_7C15) ^ v.wrapping_mul(0xC2B2_AE3D_27D4_EB4F);
+    h ^= h >> 31;
+    h = h.wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    h ^= h >> 29;
+    h
+}
+
+/// integer 1..=100, directed (w(u,v) != w(v,u) in general): the earlier harness's metric.
+fn weight_of(
+    u: u64,
+    v: u64,
+) -> f64 {
+    (mix(u, v) % 100 + 1) as f64
+}
+
+fn load_input(path: &str) -> CchInput {
+    let text = std::fs::read_to_string(path).expect("read road graph");
+    let mut edges: Vec<(u64, u64)> = Vec::new();
+    let mut n = 0u64;
+    for line in text.lines() {
+        if line.starts_with('#') || line.is_empty() {
+            continue;
+        }
+        let mut it = line.split_whitespace();
+        let u: u64 = it.next().unwrap().parse().unwrap();
+        let v: u64 = it.next().unwrap().parse().unwrap();
+        n = n.max(u + 1).max(v + 1);
+        if u != v {
+            edges.push((u, v));
+            edges.push((v, u));
+        }
+    }
+    drop(text);
+    edges.sort_unstable();
+    edges.dedup();
+    let n = n as usize;
+    let mut offsets = vec![0u64; n + 1];
+    for &(u, _) in &edges {
+        offsets[u as usize + 1] += 1;
+    }
+    for i in 0..n {
+        offsets[i + 1] += offsets[i];
+    }
+    let neighbors: Vec<u64> = edges.iter().map(|&(_, v)| v).collect();
+    let values: Vec<f64> = edges.iter().map(|&(u, v)| weight_of(u, v)).collect();
+    CchInput {
+        n,
+        skeleton: Csr {
+            node_count: n,
+            row_offsets: offsets.clone(),
+            neighbors: neighbors.clone(),
+        },
+        weights: WeightCsr {
+            csr: Csr {
+                node_count: n,
+                row_offsets: offsets,
+                neighbors,
+            },
+            values,
+        },
+    }
+}
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 << 13;
+        self.0 ^= self.0 >> 7;
+        self.0 ^= self.0 << 17;
+        self.0
+    }
+}
+
+fn pct(
+    v: &[f64],
+    q: f64,
+) -> f64 {
+    let mut v = v.to_vec();
+    v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    v[((v.len() as f64 - 1.0) * q).round() as usize]
+}
+
+fn rusage_u64(field: usize) -> f64 {
+    unsafe extern "C" {
+        fn proc_pid_rusage(
+            pid: i32,
+            flavor: i32,
+            buffer: *mut u8,
+        ) -> i32;
+        fn getpid() -> i32;
+    }
+    let mut buf = [0u8; 1024];
+    assert_eq!(unsafe { proc_pid_rusage(getpid(), 4, buf.as_mut_ptr()) }, 0);
+    let off = 16 + field * 8;
+    u64::from_le_bytes(buf[off..off + 8].try_into().unwrap()) as f64 / 1048576.0
+}
+
+/// Current phys_footprint (MiB), rusage_info_v4 field 7.
+fn rss_mb() -> f64 {
+    rusage_u64(7)
+}
+
+/// Lifetime max phys_footprint (MiB), rusage_info_v4 field 28.
+fn peak_mb() -> f64 {
+    rusage_u64(28)
+}
